// Syntax highlighting: a small lexical highlighter, no parse tree.
//
// A language is picked from the file name (or `:set syntax=NAME`); every line
// is classified byte by byte from the state the line before left behind (an
// open block comment, a triple-quoted string, a code fence). The classes are
// the front end's to colour (`:syntax on|off`).
//
// API
// ---
//   MED_syntax.language_of(path, first_line)     name of the language, "" when unknown
//   MED_syntax.classify(lang, line, state)       Line: one class per byte and the state after it
//   MED_syntax.languages()                       the names `:set syntax=` knows
//
// Classes: NORMAL, COMMENT, STRING, NUMBER, KEYWORD, TYPE, FUNCTION, PREPROC,
// CONSTANT, OPERATOR, SPECIAL (escapes, markdown markers), TITLE.

pub const int NORMAL = 0;
pub const int COMMENT = 1;
pub const int STRING = 2;
pub const int NUMBER = 3;
pub const int KEYWORD = 4;
pub const int TYPE = 5;
pub const int FUNCTION = 6;
pub const int PREPROC = 7;
pub const int CONSTANT = 8;
pub const int OPERATOR = 9;
pub const int SPECIAL = 10;
pub const int TITLE = 11;
// States carried from line to line.
const int IN_BLOCK_COMMENT = 1;
const int IN_TRIPLE_SINGLE = 2;
const int IN_TRIPLE_DOUBLE = 3;
const int IN_BACKTICK = 4;
const int IN_FENCE = 5;

/// One classified line: the class of each byte, and the state at its end.
pub type Line {
    pub List<int> classes = [];
    pub int state = 0;
}

pub List<str> languages() {
    return ["c", "cpp", "go", "javascript", "json", "m31", "markdown", "python", "rust", "sh", "toml", "yaml"];
}

str extension_of(str path) {
    int dot = -1;
    int slash = -1;
    for (int index in 0 .. path.size()) {
        int byte = path.byte_at(index);
        if (byte == 46) {
            dot = index;
        } else if (byte == 47) {
            slash = index;
        }
    }
    if (dot < 0 || dot < slash) {
        return "";
    }
    return path.substr(dot + 1, path.size()).to_lower();
}

str base_of(str path) {
    int slash = -1;
    for (int index in 0 .. path.size()) {
        if (path.byte_at(index) == 47) {
            slash = index;
        }
    }
    return path.substr(slash + 1, path.size());
}

/// The language of a file: by extension or name, else by a `#!` line.
pub str language_of(str path, str first_line) {
    str extension = extension_of(path);
    str base = base_of(path);
    if (extension == "c" || extension == "h") {
        return "c";
    }
    if (extension == "cpp" || extension == "cc" || extension == "cxx" || extension == "hpp" || extension == "hh" || extension == "hxx") {
        return "cpp";
    }
    if (extension == "rs") {
        return "rust";
    }
    if (extension == "go") {
        return "go";
    }
    if (extension == "js" || extension == "mjs" || extension == "cjs" || extension == "jsx" || extension == "ts" || extension == "tsx") {
        return "javascript";
    }
    if (extension == "json" || extension == "jsonc") {
        return "json";
    }
    if (extension == "m31") {
        return "m31";
    }
    if (extension == "md" || extension == "markdown") {
        return "markdown";
    }
    if (extension == "py" || extension == "pyw") {
        return "python";
    }
    if (extension == "sh" || extension == "bash" || extension == "zsh" || base == ".bashrc" || base == ".zshrc" || base == ".profile") {
        return "sh";
    }
    if (extension == "toml" || base == "Cargo.lock") {
        return "toml";
    }
    if (extension == "yaml" || extension == "yml") {
        return "yaml";
    }
    if (first_line.starts_with("#!")) {
        if (first_line.contains("python")) {
            return "python";
        }
        if (first_line.contains("sh") || first_line.contains("bash") || first_line.contains("zsh")) {
            return "sh";
        }
        if (first_line.contains("node")) {
            return "javascript";
        }
    }
    return "";
}

List<str> keywords_of(str lang) {
    if (lang == "c" || lang == "cpp") {
        return ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "goto", "sizeof", "typedef", "struct", "union", "enum", "static", "extern", "const", "volatile", "inline", "register", "auto", "class", "public", "private", "protected", "namespace", "template", "typename", "using", "new", "delete", "try", "catch", "throw", "virtual", "override", "operator", "this", "constexpr", "nullptr"];
    }
    if (lang == "rust") {
        return ["as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref", "return", "self", "Self", "static", "struct", "super", "trait", "type", "unsafe", "use", "where", "while"];
    }
    if (lang == "go") {
        return ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"];
    }
    if (lang == "javascript") {
        return ["async", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "export", "extends", "finally", "for", "function", "if", "import", "in", "instanceof", "let", "new", "of", "return", "static", "super", "switch", "this", "throw", "try", "typeof", "var", "void", "while", "with", "yield", "interface", "type", "enum", "implements", "readonly"];
    }
    if (lang == "m31") {
        return ["if", "else", "for", "while", "in", "break", "continue", "return", "match", "case", "default", "type", "enum", "import", "pub", "const", "void", "int", "bool", "str", "bytes", "float", "true", "false", "none", "this", "async", "await", "spawn", "try", "defer"];
    }
    if (lang == "python") {
        return ["and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield", "match", "case"];
    }
    if (lang == "sh") {
        return ["if", "then", "else", "elif", "fi", "for", "while", "until", "do", "done", "case", "esac", "in", "function", "select", "time", "return", "break", "continue", "exit", "export", "local", "readonly", "declare", "set", "unset", "shift", "source", "alias", "eval", "exec", "trap", "cd", "echo", "printf", "test"];
    }
    return [];
}

List<str> types_of(str lang) {
    if (lang == "c" || lang == "cpp") {
        return ["int", "char", "short", "long", "float", "double", "void", "unsigned", "signed", "bool", "size_t", "ssize_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "int8_t", "int16_t", "int32_t", "int64_t", "FILE", "string", "vector", "map", "set"];
    }
    if (lang == "rust") {
        return ["i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize", "f32", "f64", "bool", "char", "str", "String", "Vec", "Option", "Result", "Box", "Rc", "Arc", "HashMap", "HashSet"];
    }
    if (lang == "go") {
        return ["int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr", "float32", "float64", "complex64", "complex128", "string", "bool", "byte", "rune", "error", "any"];
    }
    if (lang == "javascript") {
        return ["string", "number", "boolean", "any", "unknown", "never", "object", "Array", "Map", "Set", "Promise", "Object", "String", "Number", "Boolean", "Date", "Error", "Symbol"];
    }
    if (lang == "python") {
        return ["int", "str", "float", "bool", "list", "dict", "set", "tuple", "bytes", "object", "type", "None", "self", "cls"];
    }
    return [];
}

List<str> constants_of(str lang) {
    if (lang == "python") {
        return ["True", "False", "None"];
    }
    if (lang == "c" || lang == "cpp") {
        return ["NULL", "true", "false", "EOF"];
    }
    if (lang == "sh") {
        return [];
    }
    return ["true", "false", "null", "undefined", "nil", "none", "NaN", "Infinity", "iota"];
}

bool is_listed(List<str> items, str word) {
    for (str item in items) {
        if (item == word) {
            return true;
        }
    }
    return false;
}

bool is_word_start(int byte) {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128;
}

bool is_word_byte(int byte) {
    return is_word_start(byte) || (byte >= 48 && byte <= 57);
}

bool is_digit_byte(int byte) {
    return byte >= 48 && byte <= 57;
}

void paint(List<int> classes, int from, int stop, int class_value) {
    int limit = stop;
    if (limit > classes.size()) {
        limit = classes.size();
    }
    for (int index in from .. limit) {
        classes[index] = class_value;
    }
}

// The end (exclusive) of a quoted string starting at `from` (the opening
// quote), or the line end when it is not closed; `closed` is false then.
int string_end(str line, int from, int quote) {
    int index = from + 1;
    while (index < line.size()) {
        int byte = line.byte_at(index);
        if (byte == 92) {
            index = index + 2;
            continue;
        }
        if (byte == quote) {
            return index + 1;
        }
        index = index + 1;
    }
    return line.size();
}

int number_end(str line, int from) {
    int index = from;
    if (index + 1 < line.size() && line.byte_at(index) == 48) {
        int next = line.byte_at(index + 1);
        if (next == 120 || next == 88 || next == 98 || next == 66 || next == 111 || next == 79) {
            index = index + 2;
            while (index < line.size() && (is_word_byte(line.byte_at(index)))) {
                index = index + 1;
            }
            return index;
        }
    }
    while (index < line.size()) {
        int byte = line.byte_at(index);
        if (is_digit_byte(byte) || byte == 95) {
            index = index + 1;
        } else if (byte == 46 && index + 1 < line.size() && is_digit_byte(line.byte_at(index + 1))) {
            index = index + 1;
        } else if ((byte == 101 || byte == 69) && index + 1 < line.size() && (is_digit_byte(line.byte_at(index + 1)) || line.byte_at(index + 1) == 45 || line.byte_at(index + 1) == 43)) {
            index = index + 2;
        } else if (is_word_start(byte)) {
            // a suffix (u8, f32, UL ...)
            index = index + 1;
        } else {
            break;
        }
    }
    return index;
}

Line classify_code(str lang, str line, int state) {
    Line out = Line();
    for (int index in 0 .. line.size()) {
        out.classes.push(NORMAL);
    }
    bool is_c_like = lang == "c" || lang == "cpp" || lang == "rust" || lang == "go" || lang == "javascript" || lang == "m31";
    bool is_hash = lang == "python" || lang == "sh" || lang == "toml" || lang == "yaml";
    List<str> keywords = keywords_of(lang);
    List<str> types = types_of(lang);
    List<str> constants = constants_of(lang);
    int index = 0;
    int current = state;
    // inside a construct that began on an earlier line
    if (current == IN_BLOCK_COMMENT) {
        int stop = line.index_of("*/").or(-1);
        if (stop < 0) {
            paint(out.classes, 0, line.size(), COMMENT);
            out.state = IN_BLOCK_COMMENT;
            return out;
        }
        paint(out.classes, 0, stop + 2, COMMENT);
        index = stop + 2;
        current = 0;
    } else if (current == IN_TRIPLE_SINGLE || current == IN_TRIPLE_DOUBLE) {
        str closing = "'''";
        if (current == IN_TRIPLE_DOUBLE) {
            closing = "\"\"\"";
        }
        int stop = line.index_of(closing).or(-1);
        if (stop < 0) {
            paint(out.classes, 0, line.size(), STRING);
            out.state = current;
            return out;
        }
        paint(out.classes, 0, stop + 3, STRING);
        index = stop + 3;
        current = 0;
    } else if (current == IN_BACKTICK) {
        int stop = -1;
        int scan = 0;
        while (scan < line.size()) {
            if (line.byte_at(scan) == 92) {
                scan = scan + 2;
                continue;
            }
            if (line.byte_at(scan) == 96) {
                stop = scan;
                break;
            }
            scan = scan + 1;
        }
        if (stop < 0) {
            paint(out.classes, 0, line.size(), STRING);
            out.state = IN_BACKTICK;
            return out;
        }
        paint(out.classes, 0, stop + 1, STRING);
        index = stop + 1;
        current = 0;
    }
    // a preprocessor line (#include, #define) or a shebang
    if (lang == "c" || lang == "cpp") {
        int first = 0;
        while (first < line.size() && (line.byte_at(first) == 32 || line.byte_at(first) == 9)) {
            first = first + 1;
        }
        if (index == 0 && first < line.size() && line.byte_at(first) == 35) {
            paint(out.classes, first, line.size(), PREPROC);
            return out;
        }
    }
    while (index < line.size()) {
        int byte = line.byte_at(index);
        int next = 0;
        if (index + 1 < line.size()) {
            next = line.byte_at(index + 1);
        }
        if (is_c_like && byte == 47 && next == 47) {
            paint(out.classes, index, line.size(), COMMENT);
            return out;
        }
        if (is_hash && byte == 35) {
            // # starts a comment unless it is inside a word (sh: $#, ${#x})
            bool is_comment = index == 0 || line.byte_at(index - 1) == 32 || line.byte_at(index - 1) == 9 || lang != "sh";
            if (is_comment) {
                paint(out.classes, index, line.size(), COMMENT);
                return out;
            }
        }
        if (is_c_like && lang != "go" && byte == 47 && next == 42) {
            int stop = -1;
            int scan = index + 2;
            while (scan + 1 < line.size()) {
                if (line.byte_at(scan) == 42 && line.byte_at(scan + 1) == 47) {
                    stop = scan;
                    break;
                }
                scan = scan + 1;
            }
            if (stop < 0) {
                paint(out.classes, index, line.size(), COMMENT);
                out.state = IN_BLOCK_COMMENT;
                return out;
            }
            paint(out.classes, index, stop + 2, COMMENT);
            index = stop + 2;
            continue;
        }
        if (lang == "go" && byte == 47 && next == 42) {
            int stop = line.substr(index + 2, line.size()).index_of("*/").or(-1);
            if (stop < 0) {
                paint(out.classes, index, line.size(), COMMENT);
                out.state = IN_BLOCK_COMMENT;
                return out;
            }
            paint(out.classes, index, index + 2 + stop + 2, COMMENT);
            index = index + 2 + stop + 2;
            continue;
        }
        if (lang == "python" && (byte == 34 || byte == 39) && line.substr(index, line.size()).starts_with(str.from_chars([byte, byte, byte]))) {
            str closing = str.from_chars([byte, byte, byte]);
            int stop = line.substr(index + 3, line.size()).index_of(closing).or(-1);
            int quote_state = IN_TRIPLE_SINGLE;
            if (byte == 34) {
                quote_state = IN_TRIPLE_DOUBLE;
            }
            if (stop < 0) {
                paint(out.classes, index, line.size(), STRING);
                out.state = quote_state;
                return out;
            }
            paint(out.classes, index, index + 3 + stop + 3, STRING);
            index = index + 3 + stop + 3;
            continue;
        }
        if (byte == 34 || (byte == 39 && lang != "rust" && lang != "m31")) {
            int stop = string_end(line, index, byte);
            paint(out.classes, index, stop, STRING);
            index = stop;
            continue;
        }
        if (byte == 39 && (lang == "rust" || lang == "m31")) {
            // a character literal ('a', '\n'), else a lifetime
            int stop = -1;
            if (index + 2 < line.size() && line.byte_at(index + 1) == 92) {
                stop = line.substr(index + 2, line.size()).index_of("'").or(-1);
                if (stop >= 0) {
                    stop = index + 2 + stop + 1;
                }
            } else if (index + 2 < line.size() && line.byte_at(index + 2) == 39) {
                stop = index + 3;
            }
            if (stop > 0) {
                paint(out.classes, index, stop, STRING);
                index = stop;
                continue;
            }
        }
        if (byte == 96 && (lang == "javascript" || lang == "go")) {
            int stop = -1;
            int scan = index + 1;
            while (scan < line.size()) {
                if (line.byte_at(scan) == 92) {
                    scan = scan + 2;
                    continue;
                }
                if (line.byte_at(scan) == 96) {
                    stop = scan;
                    break;
                }
                scan = scan + 1;
            }
            if (stop < 0) {
                paint(out.classes, index, line.size(), STRING);
                out.state = IN_BACKTICK;
                return out;
            }
            paint(out.classes, index, stop + 1, STRING);
            index = stop + 1;
            continue;
        }
        if (is_digit_byte(byte) || (byte == 46 && is_digit_byte(next) && index > 0 && !is_word_byte(line.byte_at(index - 1)))) {
            int stop = number_end(line, index);
            paint(out.classes, index, stop, NUMBER);
            index = stop;
            continue;
        }
        if (is_word_start(byte)) {
            int stop = index;
            while (stop < line.size() && is_word_byte(line.byte_at(stop))) {
                stop = stop + 1;
            }
            str word = line.substr(index, stop);
            int after = stop;
            while (after < line.size() && line.byte_at(after) == 32) {
                after = after + 1;
            }
            int class_value = NORMAL;
            if (is_listed(keywords, word)) {
                class_value = KEYWORD;
            } else if (is_listed(types, word)) {
                class_value = TYPE;
            } else if (is_listed(constants, word)) {
                class_value = CONSTANT;
            } else if (lang == "yaml" || lang == "toml") {
                if (after < line.size() && (line.byte_at(after) == 58 || line.byte_at(after) == 61)) {
                    class_value = TYPE;
                }
            } else if (stop < line.size() && line.byte_at(stop) == 40) {
                class_value = FUNCTION;
            } else if (lang == "rust" && stop < line.size() && line.byte_at(stop) == 33) {
                class_value = FUNCTION;
            } else if (word.byte_at(0) >= 65 && word.byte_at(0) <= 90 && word.size() > 1 && lang != "sh") {
                bool has_lower = false;
                for (int scan in 1 .. word.size()) {
                    if (word.byte_at(scan) >= 97 && word.byte_at(scan) <= 122) {
                        has_lower = true;
                    }
                }
                if (has_lower) {
                    class_value = TYPE;
                } else {
                    class_value = CONSTANT;
                }
            }
            paint(out.classes, index, stop, class_value);
            index = stop;
            continue;
        }
        if (lang == "sh" && byte == 36 && index + 1 < line.size()) {
            int stop = index + 1;
            if (line.byte_at(stop) == 123) {
                int close_at = line.substr(stop, line.size()).index_of("}").or(-1);
                if (close_at >= 0) {
                    stop = stop + close_at + 1;
                }
            } else {
                while (stop < line.size() && is_word_byte(line.byte_at(stop))) {
                    stop = stop + 1;
                }
                if (stop == index + 1) {
                    stop = stop + 1;
                }
            }
            paint(out.classes, index, stop, SPECIAL);
            index = stop;
            continue;
        }
        if (lang == "python" && byte == 64 && next != 0 && is_word_start(next) && (index == 0 || line.byte_at(index - 1) == 32)) {
            int stop = index + 1;
            while (stop < line.size() && is_word_byte(line.byte_at(stop))) {
                stop = stop + 1;
            }
            paint(out.classes, index, stop, PREPROC);
            index = stop;
            continue;
        }
        index = index + 1;
    }
    return out;
}

// Markdown states: 0 outside a fence, IN_FENCE inside a fence of unknown
// language (plain code colour), FENCE_BASE + 8 * n + inner inside a fence whose
// language is injectable_languages()[n]; `inner` is that language's own state.
const int FENCE_BASE = 100;

List<str> injectable_languages() {
    List<str> out = [];
    for (str name in languages()) {
        if (name != "markdown") {
            out.push(name);
        }
    }
    return out;
}

/// The language named by a fence's info string ("" when unknown), e.g. the
/// "rust" of "```rust", "rs", "{.python}", "python title=x".
str fence_language(str trimmed) {
    int start = 0;
    while (start < trimmed.size() && (trimmed.byte_at(start) == 96 || trimmed.byte_at(start) == 126)) {
        start = start + 1;
    }
    str info = trimmed.substr(start, trimmed.size()).trim();
    while (info.starts_with("{") || info.starts_with(".")) {
        info = info.substr(1, info.size());
    }
    int stop = 0;
    while (stop < info.size()) {
        int byte = info.byte_at(stop);
        if (byte == 32 || byte == 9 || byte == 44 || byte == 125 || byte == 123 || byte == 59) {
            break;
        }
        stop = stop + 1;
    }
    str tag = info.substr(0, stop).to_lower();
    if (tag.size() == 0) {
        return "";
    }
    if (tag == "shell" || tag == "console" || tag == "terminal") {
        return "sh";
    }
    if (tag == "c++") {
        return "cpp";
    }
    if (tag == "golang") {
        return "go";
    }
    if (tag == "python3") {
        return "python";
    }
    if (tag == "typescript") {
        return "javascript";
    }
    for (str name in injectable_languages()) {
        if (name == tag) {
            return name;
        }
    }
    str by_extension = language_of("x." + tag, "");
    if (by_extension == "markdown") {
        return "";
    }
    return by_extension;
}

bool is_fence_line(str trimmed) {
    return trimmed.starts_with("```") || trimmed.starts_with("~~~");
}

bool is_rule_line(str trimmed) {
    if (trimmed.size() < 3) {
        return false;
    }
    int marker = trimmed.byte_at(0);
    if (marker != 45 && marker != 42 && marker != 95 && marker != 61) {
        return false;
    }
    int count = 0;
    for (int index in 0 .. trimmed.size()) {
        int byte = trimmed.byte_at(index);
        if (byte == marker) {
            count = count + 1;
        } else if (byte != 32 && byte != 9) {
            return false;
        }
    }
    return count >= 3;
}

// A table delimiter row: only | : - and spaces, with a dash and a pipe.
bool is_table_delimiter(str trimmed) {
    bool has_dash = false;
    bool has_pipe = false;
    for (int index in 0 .. trimmed.size()) {
        int byte = trimmed.byte_at(index);
        if (byte == 45) {
            has_dash = true;
        } else if (byte == 124) {
            has_pipe = true;
        } else if (byte != 58 && byte != 32 && byte != 9) {
            return false;
        }
    }
    return has_dash && has_pipe;
}

// The index just past the run of `byte` starting at `from`.
int run_end(str line, int from, int byte) {
    int index = from;
    while (index < line.size() && line.byte_at(index) == byte) {
        index = index + 1;
    }
    return index;
}

// Inline spans of [from, stop): code, links, images, autolinks, bare URLs,
// emphasis (TYPE), strong (KEYWORD), strikethrough, HTML comments. Text that
// matches nothing keeps the class painted before the call.
void markdown_inline(List<int> classes, str line, int from, int stop) {
    int index = from;
    while (index < stop) {
        int byte = line.byte_at(index);
        int before = 0;
        if (index > 0) {
            before = line.byte_at(index - 1);
        }
        int next = 0;
        if (index + 1 < line.size()) {
            next = line.byte_at(index + 1);
        }
        if (byte == 92 && index + 1 < stop) {
            index = index + 2;
            continue;
        }
        if (byte == 96) {
            int ticks = run_end(line, index, 96) - index;
            int scan = index + ticks;
            int found = -1;
            while (scan < stop) {
                if (line.byte_at(scan) == 96) {
                    int length = run_end(line, scan, 96) - scan;
                    if (length == ticks) {
                        found = scan;
                        break;
                    }
                    scan = scan + length;
                } else {
                    scan = scan + 1;
                }
            }
            if (found >= 0) {
                paint(classes, index, found + ticks, STRING);
                index = found + ticks;
            } else {
                index = index + ticks;
            }
            continue;
        }
        if (byte == 60) {
            if (line.substr(index, stop).starts_with("<!--")) {
                int shut = line.substr(index, stop).index_of("-->").or(-1);
                int end = stop;
                if (shut >= 0) {
                    end = index + shut + 3;
                }
                paint(classes, index, end, COMMENT);
                index = end;
                continue;
            }
            int shut = line.substr(index, stop).index_of(">").or(-1);
            if (shut > 1) {
                str inner = line.substr(index + 1, index + shut);
                if (inner.starts_with("http://") || inner.starts_with("https://") || inner.starts_with("mailto:")) {
                    paint(classes, index, index + shut + 1, FUNCTION);
                    index = index + shut + 1;
                    continue;
                }
            }
        }
        if (byte == 91 || (byte == 33 && next == 91)) {
            int open = index;
            if (byte == 33) {
                open = index + 1;
            }
            int depth = 0;
            int shut = -1;
            int scan = open;
            while (scan < stop) {
                int unit = line.byte_at(scan);
                if (unit == 92) {
                    scan = scan + 2;
                    continue;
                }
                if (unit == 91) {
                    depth = depth + 1;
                } else if (unit == 93) {
                    depth = depth - 1;
                    if (depth == 0) {
                        shut = scan;
                        break;
                    }
                }
                scan = scan + 1;
            }
            if (shut > 0 && shut + 1 < stop && (line.byte_at(shut + 1) == 40 || line.byte_at(shut + 1) == 91)) {
                int closer = 41;
                if (line.byte_at(shut + 1) == 91) {
                    closer = 93;
                }
                int url_end = -1;
                int url_scan = shut + 2;
                int parens = 0;
                while (url_scan < stop) {
                    int unit = line.byte_at(url_scan);
                    if (unit == 40 && closer == 41) {
                        parens = parens + 1;
                    } else if (unit == closer) {
                        if (parens == 0) {
                            url_end = url_scan;
                            break;
                        }
                        parens = parens - 1;
                    }
                    url_scan = url_scan + 1;
                }
                if (url_end > 0) {
                    paint(classes, index, shut + 1, FUNCTION);
                    paint(classes, shut + 1, url_end + 1, COMMENT);
                    index = url_end + 1;
                    continue;
                }
            }
            if (shut > 0 && line.substr(open + 1, shut).trim().size() > 0) {
                // [text] on its own: a shortcut reference link, or a task box
                str word = line.substr(open + 1, shut);
                if (word != " " && word != "x" && word != "X") {
                    paint(classes, index, shut + 1, FUNCTION);
                    index = shut + 1;
                    continue;
                }
            }
            index = index + 1;
            continue;
        }
        if (byte == 104 && (line.substr(index, stop).starts_with("http://") || line.substr(index, stop).starts_with("https://")) && !is_word_byte(before)) {
            int end = index;
            while (end < stop && line.byte_at(end) != 32 && line.byte_at(end) != 41 && line.byte_at(end) != 62 && line.byte_at(end) != 9) {
                end = end + 1;
            }
            paint(classes, index, end, FUNCTION);
            index = end;
            continue;
        }
        if (byte == 126 && next == 126) {
            int shut = line.substr(index + 2, stop).index_of("~~").or(-1);
            if (shut > 0) {
                paint(classes, index, index + 2 + shut + 2, COMMENT);
                index = index + 2 + shut + 2;
                continue;
            }
        }
        if (byte == 42 || byte == 95) {
            int length = run_end(line, index, byte) - index;
            bool can_open = index + length < stop && line.byte_at(index + length) != 32 && line.byte_at(index + length) != 9;
            if (byte == 95 && is_word_byte(before) && before != 95) {
                can_open = false;
            }
            if (can_open && length <= 3) {
                // find the closing run of the same length
                int scan = index + length;
                int found = -1;
                while (scan < stop) {
                    int unit = line.byte_at(scan);
                    if (unit == 92) {
                        scan = scan + 2;
                        continue;
                    }
                    if (unit == 96) {
                        // skip a code span so `a*b` does not shut emphasis
                        int ticks = run_end(line, scan, 96) - scan;
                        int skip = line.substr(scan + ticks, stop).index_of(str.from_chars([96])).or(-1);
                        if (skip >= 0) {
                            scan = scan + ticks + skip + 1;
                            continue;
                        }
                    }
                    if (unit == byte) {
                        int run = run_end(line, scan, byte) - scan;
                        bool is_closing = run >= length && line.byte_at(scan - 1) != 32 && scan > index + length;
                        if (is_closing && byte == 95 && scan + length < line.size() && is_word_byte(line.byte_at(scan + length))) {
                            is_closing = false;
                        }
                        if (is_closing) {
                            found = scan;
                            break;
                        }
                        scan = scan + run;
                        continue;
                    }
                    scan = scan + 1;
                }
                if (found >= 0) {
                    int class_value = TYPE;
                    if (length >= 2) {
                        class_value = KEYWORD;
                    }
                    paint(classes, index, found + length, class_value);
                    index = found + length;
                    continue;
                }
            }
            index = index + length;
            continue;
        }
        index = index + 1;
    }
}

Line classify_markdown(str line, int state) {
    Line out = Line();
    for (int index in 0 .. line.size()) {
        out.classes.push(NORMAL);
    }
    str trimmed = line.trim();
    bool is_fence = is_fence_line(trimmed);
    if (state == IN_FENCE) {
        paint(out.classes, 0, line.size(), STRING);
        if (is_fence) {
            paint(out.classes, 0, line.size(), SPECIAL);
            out.state = 0;
        } else {
            out.state = IN_FENCE;
        }
        return out;
    }
    if (state >= FENCE_BASE) {
        if (is_fence) {
            paint(out.classes, 0, line.size(), SPECIAL);
            out.state = 0;
            return out;
        }
        int slot = (state - FENCE_BASE) / 8;
        int inner = (state - FENCE_BASE) - slot * 8;
        List<str> names = injectable_languages();
        if (slot >= names.size()) {
            paint(out.classes, 0, line.size(), STRING);
            out.state = state;
            return out;
        }
        Line code = classify(names[slot], line, inner);
        out.classes = code.classes;
        out.state = FENCE_BASE + slot * 8 + code.state;
        return out;
    }
    if (is_fence) {
        paint(out.classes, 0, line.size(), SPECIAL);
        str lang = fence_language(trimmed);
        out.state = IN_FENCE;
        if (lang.size() > 0) {
            int slot = 0;
            List<str> names = injectable_languages();
            for (int index in 0 .. names.size()) {
                if (names[index] == lang) {
                    slot = index;
                }
            }
            out.state = FENCE_BASE + slot * 8;
            int info_start = line.index_of(trimmed.substr(0, 1)).or(0);
            info_start = run_end(line, info_start, trimmed.byte_at(0));
            paint(out.classes, info_start, line.size(), TYPE);
        }
        return out;
    }
    if (line.starts_with("#")) {
        int hashes = run_end(line, 0, 35);
        if (hashes <= 6 && (hashes == line.size() || line.byte_at(hashes) == 32)) {
            paint(out.classes, 0, line.size(), TITLE);
            paint(out.classes, 0, hashes, SPECIAL);
            markdown_inline(out.classes, line, hashes, line.size());
            return out;
        }
    }
    if (is_rule_line(trimmed) || is_table_delimiter(trimmed)) {
        paint(out.classes, 0, line.size(), SPECIAL);
        return out;
    }
    int start = 0;
    while (start < line.size() && (line.byte_at(start) == 32 || line.byte_at(start) == 9)) {
        start = start + 1;
    }
    if (start < line.size() && line.byte_at(start) == 62) {
        int index = start;
        while (index < line.size() && (line.byte_at(index) == 62 || line.byte_at(index) == 32)) {
            if (line.byte_at(index) == 62) {
                out.classes[index] = SPECIAL;
            }
            index = index + 1;
        }
        paint(out.classes, index, line.size(), COMMENT);
        markdown_inline(out.classes, line, index, line.size());
        return out;
    }
    if (start < line.size() && (line.byte_at(start) == 45 || line.byte_at(start) == 42 || line.byte_at(start) == 43) && start + 1 < line.size() && line.byte_at(start + 1) == 32) {
        out.classes[start] = SPECIAL;
        start = start + 2;
    } else if (start < line.size() && is_digit_byte(line.byte_at(start))) {
        int stop = start;
        while (stop < line.size() && is_digit_byte(line.byte_at(stop))) {
            stop = stop + 1;
        }
        if (stop < line.size() && (line.byte_at(stop) == 46 || line.byte_at(stop) == 41) && stop + 1 < line.size() && line.byte_at(stop + 1) == 32) {
            paint(out.classes, start, stop + 1, SPECIAL);
            start = stop + 2;
        }
    }
    // task list box: "- [ ] x" / "- [x] x"
    if (start + 3 <= line.size() && line.byte_at(start) == 91 && line.byte_at(start + 2) == 93 && (start + 3 == line.size() || line.byte_at(start + 3) == 32)) {
        int mark = line.byte_at(start + 1);
        if (mark == 32 || mark == 120 || mark == 88) {
            paint(out.classes, start, start + 3, CONSTANT);
            start = start + 3;
        }
    }
    markdown_inline(out.classes, line, start, line.size());
    if (trimmed.starts_with("|")) {
        for (int index in 0 .. line.size()) {
            if (line.byte_at(index) == 124 && out.classes[index] == NORMAL) {
                out.classes[index] = SPECIAL;
            }
        }
    }
    return out;
}

Line classify_json(str line) {
    Line out = Line();
    for (int index in 0 .. line.size()) {
        out.classes.push(NORMAL);
    }
    int index = 0;
    while (index < line.size()) {
        int byte = line.byte_at(index);
        if (byte == 34) {
            int stop = string_end(line, index, 34);
            int after = stop;
            while (after < line.size() && line.byte_at(after) == 32) {
                after = after + 1;
            }
            int class_value = STRING;
            if (after < line.size() && line.byte_at(after) == 58) {
                class_value = TYPE;
            }
            paint(out.classes, index, stop, class_value);
            index = stop;
            continue;
        }
        if (is_digit_byte(byte) || (byte == 45 && index + 1 < line.size() && is_digit_byte(line.byte_at(index + 1)))) {
            int stop = number_end(line, index + 1);
            paint(out.classes, index, stop, NUMBER);
            index = stop;
            continue;
        }
        if (is_word_start(byte)) {
            int stop = index;
            while (stop < line.size() && is_word_byte(line.byte_at(stop))) {
                stop = stop + 1;
            }
            str word = line.substr(index, stop);
            if (word == "true" || word == "false" || word == "null") {
                paint(out.classes, index, stop, CONSTANT);
            }
            index = stop;
            continue;
        }
        if (byte == 47 && index + 1 < line.size() && line.byte_at(index + 1) == 47) {
            paint(out.classes, index, line.size(), COMMENT);
            return out;
        }
        index = index + 1;
    }
    return out;
}

/// Classify one `line` of language `lang` that begins in `state`.
pub Line classify(str lang, str line, int state) {
    if (lang == "markdown") {
        return classify_markdown(line, state);
    }
    if (lang == "json") {
        return classify_json(line);
    }
    return classify_code(lang, line, state);
}
