// Adding to and subtracting from the number under the cursor: `<C-a>`, `<C-x>`,
// and `g<C-a>` / `g<C-x>` / `<C-a>` over a Visual selection.
//
// A port of Vim's do_addsub() with 'nrformats' "bin,hex" (nvim's default):
// decimal, 0x hex and 0b binary numbers, a '-' directly before a decimal number
// makes it negative, leading zeros keep the width.
//
// Numbers are 64-bit signed here, Vim's are unsigned 64-bit: a decimal number of
// 2^63 or more is treated as too large and left alone (DESIGN.md section 7).

import engine.MED_text;

pub type NrResult {
    /// The line changed.
    pub bool is_changed = false;
    /// The bytes [from, to) of the line are replaced by `text`.
    pub int from = 0;
    pub int target_position = 0;
    pub str text = "";
    /// Byte column of the last character of the new number.
    pub int endcol = 0;
    /// Byte column of the first changed character (`'[`).
    pub int startcol = 0;
    /// Vim remembers whether the last hex number it changed used capitals.
    pub bool is_hexupper = false;
}

bool is_digit(int char_code) {
    return char_code >= 48 && char_code <= 57;
}

bool is_xdigit(int char_code) {
    return (char_code >= 48 && char_code <= 57) || (char_code >= 97 && char_code <= 102) || (char_code >= 65 && char_code <= 70);
}

bool is_bdigit(int char_code) {
    return char_code == 48 || char_code == 49;
}

bool is_alpha(int char_code) {
    return (char_code >= 97 && char_code <= 122) || (char_code >= 65 && char_code <= 90);
}

int xval(int char_code) {
    if (char_code >= 97) {
        return char_code - 87;
    }
    if (char_code >= 65) {
        return char_code - 55;
    }
    return char_code - 48;
}

int at(str text, int index) {
    if (index < 0 || index >= text.size()) {
        return 0;
    }
    return text.byte_at(index);
}

// The start byte of the character that ends just before byte `index`.
int back_one(str text, int index) {
    int offset = index - 1;
    while (offset > 0 && (text.byte_at(offset) & 192) == 128) {
        offset = offset - 1;
    }
    return offset;
}

str hex_digits(int n_in, bool is_upper) {
    int count = n_in;
    List<str> out = [];
    for (int i in 0 .. 16) {
        int delta = count & 15;
        count = (count >> 4) & 1152921504606846975;
        if (delta < 10) {
            out.push(str.from_chars([48 + delta]));
        } else if (is_upper) {
            out.push(str.from_chars([55 + delta]));
        } else {
            out.push(str.from_chars([87 + delta]));
        }
        if (count == 0) {
            break;
        }
    }
    out.reverse();
    return out.join("");
}

str bin_digits(int n_in) {
    int count = n_in;
    List<str> out = [];
    for (int i in 0 .. 64) {
        out.push(str.from_chars([48 + (count & 1)]));
        count = (count >> 1) & 9223372036854775807;
        if (count == 0) {
            break;
        }
    }
    out.reverse();
    return out.join("");
}

/// Add (or subtract) `amount` to the number at or after byte `col` of `line`.
/// `length` is the number of bytes of the Visual selection on this line (0 when
/// not Visual). In Visual mode the number must start inside the selection and
/// `vmax_mode` says how far it may reach: 0 to the end of the line (linewise
/// selections), 1 to the end of the selection, 2 to the end of the line
/// (`$` blocks).
pub NrResult addsub(str line, int col_in, int length_in, bool is_sub, int amount, bool is_visual, int vmax_mode, bool is_hexupper_in) {
    NrResult nr_result = NrResult();
    nr_result.is_hexupper = is_hexupper_in;
    int col = col_in;
    int length = length_in;
    str pointer = line;
    bool is_negative = false;
    bool was_positive = true;
    if (pointer.size() == 0 || col >= pointer.size()) {
        return nr_result;
    }
    if (!is_visual) {
        // first check for a hex or binary number, on or after its "0x"
        while (col > 0 && is_bdigit(at(pointer, col))) {
            col = back_one(pointer, col);
        }
        while (col > 0 && is_xdigit(at(pointer, col))) {
            col = back_one(pointer, col);
        }
        bool is_hex_head = col > 0 && (at(pointer, col) == 88 || at(pointer, col) == 120) && at(pointer, col - 1) == 48 && is_xdigit(at(pointer, col + 1));
        if (!is_hex_head) {
            // binary and hexadecimal patterns can overlap: scan decimal digits instead
            col = col_in;
            while (col > 0 && is_digit(at(pointer, col))) {
                col = back_one(pointer, col);
            }
        }
        bool is_hex_found = col > 0 && (at(pointer, col) == 88 || at(pointer, col) == 120) && at(pointer, col - 1) == 48 && is_xdigit(at(pointer, col + 1));
        bool is_bin_found = col > 0 && (at(pointer, col) == 66 || at(pointer, col) == 98) && at(pointer, col - 1) == 48 && is_bdigit(at(pointer, col + 1));
        if (is_hex_found || is_bin_found) {
            col = col - 1;
        } else {
            col = col_in;
            while (col < pointer.size() && !is_digit(at(pointer, col))) {
                col = MED_text.next_col(pointer, col);
            }
            while (col > 0 && is_digit(at(pointer, col - 1))) {
                col = col - 1;
            }
        }
    }
    if (is_visual) {
        while (col < pointer.size() && length > 0 && !is_digit(at(pointer, col))) {
            int next_offset = MED_text.next_col(pointer, col);
            length = length - (next_offset - col);
            col = next_offset;
        }
        if (length == 0) {
            return nr_result;
        }
        if (col > col_in && at(pointer, col - 1) == 45) {
            is_negative = true;
            was_positive = false;
        }
    }
    int firstdigit = at(pointer, col);
    if (!is_digit(firstdigit)) {
        return nr_result;
    }
    if (col > 0 && at(pointer, col - 1) == 45 && !is_visual) {
        col = col - 1;
        is_negative = true;
    }
    // vim_str2nr(): the prefix and the value
    int digit_start = col;
    if (at(pointer, digit_start) == 45) {
        digit_start = digit_start + 1;
    }
    int limit = pointer.size();
    if (is_visual && vmax_mode == 1) {
        limit = smaller(pointer.size(), col + length);
    }
    int pre = 0;
    int index = digit_start;
    if (at(pointer, index) == 48 && index + 1 < limit) {
        int x = at(pointer, index + 1);
        if ((x == 120 || x == 88) && index + 2 < limit && is_xdigit(at(pointer, index + 2))) {
            pre = x;
        } else if ((x == 98 || x == 66) && index + 2 < limit && is_bdigit(at(pointer, index + 2))) {
            pre = x;
        }
    }
    int count = 0;
    bool is_overflow = false;
    if (pre == 120 || pre == 88) {
        index = index + 2;
        while (index < limit && is_xdigit(at(pointer, index))) {
            count = (count << 4) | xval(at(pointer, index));
            index = index + 1;
        }
    } else if (pre == 98 || pre == 66) {
        index = index + 2;
        while (index < limit && is_bdigit(at(pointer, index))) {
            count = (count << 1) | (at(pointer, index) - 48);
            index = index + 1;
        }
    } else {
        while (index < limit && is_digit(at(pointer, index))) {
            int delta = at(pointer, index) - 48;
            if (count > (9223372036854775807 - delta) / 10) {
                is_overflow = true;
            } else {
                count = count * 10 + delta;
            }
            index = index + 1;
        }
    }
    int numlen = index - digit_start;
    int current_length = numlen;
    if (is_negative && at(pointer, col) == 45) {
        current_length = numlen + 1;
    }
    if (pre != 0 && is_negative) {
        // a '-' in front of a hex or binary number is not a sign
        col = col + 1;
        current_length = current_length - 1;
        is_negative = false;
    }
    bool is_subtract = is_sub;
    if (is_negative) {
        is_subtract = !is_subtract;
    }
    if (is_overflow) {
        return nr_result;
    }
    if (pre == 0) {
        // `is_subtract` already accounts for the sign: work on the magnitude
        int mag = count + amount;
        if (is_subtract) {
            mag = count - amount;
        }
        if (mag < 0) {
            mag = 0 - mag;
            is_negative = !is_negative;
        }
        count = mag;
        if (count == 0) {
            is_negative = false;
        }
    } else if (is_subtract) {
        count = count - amount;
    } else {
        count = count + amount;
    }
    if (is_visual && !was_positive && !is_negative && col > 0) {
        // the '-' goes
        col = col - 1;
        current_length = current_length + 1;
    }
    // what is deleted
    int todel = current_length;
    int del_end = col + todel;
    // letters in the old number decide the case of new hex digits
    bool is_upper = is_hexupper_in;
    for (int key in col .. del_end) {
        int char_code = at(pointer, key);
        if (is_alpha(char_code)) {
            is_upper = char_code < 97;
        }
    }
    nr_result.is_hexupper = is_upper;
    int length2 = current_length;
    if (at(pointer, col) == 45) {
        length2 = length2 - 1;
    }
    List<str> parts = [];
    if (is_negative && (!is_visual || was_positive)) {
        parts.push("-");
    }
    if (pre != 0) {
        parts.push("0");
        length2 = length2 - 1;
        parts.push(str.from_chars([pre]));
        length2 = length2 - 1;
    }
    str digits = "";
    if (pre == 98 || pre == 66) {
        digits = bin_digits(count);
    } else if (pre == 0) {
        digits = count.to_str();
    } else {
        digits = hex_digits(count, is_upper);
    }
    length2 = length2 - digits.size();
    if (firstdigit == 48) {
        while (length2 > 0) {
            parts.push("0");
            length2 = length2 - 1;
        }
    }
    parts.push(digits);
    str text = parts.join("");
    nr_result.is_changed = true;
    nr_result.from = col;
    nr_result.target_position = del_end;
    nr_result.text = text;
    nr_result.startcol = col;
    nr_result.endcol = col + text.size() - 1;
    if (nr_result.endcol < 0) {
        nr_result.endcol = 0;
    }
    return nr_result;
}

int smaller(int left, int right) {
    if (left < right) {
        return left;
    }
    return right;
}
