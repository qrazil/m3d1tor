// The terminal front end: one `App` joins the editing engine (MED_ex.feed) to
// tui's application loop. It is a Widget (draws the text window, a status line
// and the command line) and a Handler (turns a terminal event into engine keys,
// then carries out what the engine asked of the UI: `:w`, `:q`).
//
//   row 0 .. height-3   the text, with a line-number gutter, no wrapping
//   row height-2        the status line: mode, file name, modified flag, position
//   row height-1        the command line while typing `:` or `/`, else the message
//
// tui hides the terminal cursor, so the cursor is drawn as a reverse-video cell.
// The engine owns every editing decision; nothing here knows what a motion is.

import fs;
import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_menu;
import tui.core.TUI_mouse;
import tui.core.TUI_style;
import engine.MED_buffer;
import engine.MED_editor;
import engine.MED_ex;
import ui.MED_clip;
import ui.MED_files;
import ui.MED_grep;
import engine.MED_key;
import ui.MED_keymap;
import ui.MED_picker;
import ui.MED_picker_view;
import engine.MED_text;
import engine.MED_regex;
import engine.MED_search;
import ui.MED_window;
import engine.MED_view;

/// Rows below the text: the status line and the command line.
const int FOOTER_ROWS = 2;
/// Visual selection background (a palette grey).
const int SELECTION_COLOUR = 240;
/// Lines the mouse wheel scrolls per notch.
const int WHEEL_LINES = 3;
/// Quiet time (ms) after typing in the grep prompt before the search runs.
const int GREP_DEBOUNCE_MS = 120;
/// How long (ms) a typed prefix of a longer mapping waits ('timeoutlen').
const int MAP_TIMEOUT_MS = 1000;
const int PREVIEW_LINES = 3000;
/// The smallest a window may get, status line included.
const int MIN_WINDOW_HEIGHT = 2;
const int MIN_WINDOW_WIDTH = 5;
const int VKIND_CHAR = 118;
const int VKIND_LINE = 86;

/// One buffer of the session: its engine state (a reference, so the active
/// buffer's editor is the very object the App drives) and its file.
pub type Slot {
    /// Buffer number, as `:ls` shows it; never reused.
    pub int id;
    pub MED_editor.Editor editor;
    pub str path;
    pub int saved_current = 0;
    pub int left_column = 0;
    /// A directory listing (`:Explore`): `path` is the directory, the text is
    /// read-only and Enter opens the entry under the cursor.
    pub bool is_listing = false;
}

pub type App {
    pub MED_editor.Editor editor;
    /// The system clipboard tools, when `m3d1tor` found a pair (see MED_clip).
    pub MED_clip.Provider clipboard = MED_clip.Provider();
    /// The file `:w` writes; empty for a buffer with no name yet.
    pub str path;
    /// The undo node (`editor.current`) that was last written to disk.
    pub int saved_current = 0;
    /// A message of the UI layer (written, E37 ...), cleared by the next key.
    pub str notice = "";
    /// First display column shown (horizontal scrolling).
    pub int left_column = 0;
    /// Every buffer; `editor`, `path`, `saved_current` and `left_column` belong
    /// to the active one (`current_id`) and are stored back by `save_active`.
    pub List<Slot> slots = [];
    pub int current_id = 1;
    /// The buffer `:b#` and CTRL-^ go to; 0 when there is none.
    pub int alternate_id = 0;
    pub int next_id = 2;
    /// Lines shown over the text until the next key (`:ls` and long messages).
    pub List<str> overlay = [];
    /// The open picker, if any.
    pub MED_picker.Picker picker = MED_picker.make(0, "");
    pub bool has_picker = false;
    /// The project root the file and grep pickers walk.
    pub str root = ".";
    pub MED_grep.Corpus corpus = MED_grep.Corpus();
    pub bool is_grep_due = false;
    pub int idle_ms = 0;
    pub MED_picker_view.Preview preview = MED_picker_view.Preview();
    pub str preview_path = "";
    pub List<str> preview_lines = [];
    /// <Space> was typed: the keys after it so far, and the wait for which-key.
    pub bool is_leader = false;
    pub str leader = "";
    pub int leader_ms = 0;
    pub bool is_which_key = false;
    /// The previous key fed to the engine (for the `jk` mapping).
    pub int last_key = 0;
    /// How long (ms) typed keys have waited for a longer mapping.
    pub int map_ms = 0;
    /// The windows and how they are laid out; `current_win` is the active one,
    /// whose cursor and view live in `editor` and `left_column`.
    pub List<MED_window.Win> wins = [];
    pub MED_window.Node layout = MED_window.leaf(1);
    pub int current_win = 1;
    pub int previous_win = 0;
    pub int next_win = 2;
    /// CTRL-W was typed: the next key is a window command.
    pub bool is_window_key = false;
    /// Where the active window's cursor was drawn.
    pub int cursor_x = 0;
    pub int cursor_y = 0;
}

/// Whether the text differs from what was last written (undo back to the
/// written state counts as unmodified).
pub bool App.is_modified() {
    return editor.current != saved_current;
}

/// The engine keys typed by a terminal event.
List<int> App.keys_of(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            return keys_of_key(key);
        }
        case Paste(str text): {
            // a paste is typed text in Insert mode; elsewhere it would run as commands
            if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE || editor.mode == MED_editor.CMDLINE) {
                for (int code_point in text.chars()) {
                    if (code_point == 10) {
                        keys.push(MED_key.CARRIAGE_RETURN);
                    } else if (code_point != 13) {
                        keys.push(code_point);
                    }
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    return keys;
}

/// The slot of the active buffer, brought up to date.
Slot App.active_slot() {
    save_active();
    return slots[index_of(current_id)];
}

/// Store the active buffer's own values back into its slot.
void App.save_active() {
    int position = index_of(current_id);
    if (position < 0) {
        return;
    }
    Slot slot = slots[position];
    slot.editor = editor;
    slot.path = path;
    slot.saved_current = saved_current;
    slot.left_column = left_column;
    int at_window = win_index(current_win);
    if (at_window >= 0) {
        MED_window.Win win = wins[at_window];
        win.buffer_id = current_id;
        win.row = editor.row;
        win.col = editor.col;
        win.view_top = editor.view_top;
        win.left_column = left_column;
    }
}

/// Where window `id` is in `wins`, or -1.
int App.win_index(int id) {
    for (int position in 0 .. wins.size()) {
        if (wins[position].id == id) {
            return position;
        }
    }
    return -1;
}

/// Where buffer `id` is in `slots`, or -1.
int App.index_of(int id) {
    for (int position in 0 .. slots.size()) {
        if (slots[position].id == id) {
            return position;
        }
    }
    return -1;
}

/// Write the active buffer to `target` (the buffer's own file when empty).
void App.write_file(str target) {
    Slot slot = active_slot();
    notice = write_slot(slot, target);
    path = slot.path;
    saved_current = slot.saved_current;
}

/// `:w` for every buffer that has changed (`:wall`).
void App.write_all() {
    save_active();
    int written = 0;
    for (Slot slot in slots) {
        if (!is_slot_modified(slot)) {
            continue;
        }
        if (slot.path.size() == 0) {
            notice = "E141: No file name for buffer " + slot.id.to_str();
            return;
        }
        str result = write_slot(slot, "");
        if (result.starts_with("E")) {
            notice = result;
            return;
        }
        written = written + 1;
    }
    Slot active = slots[index_of(current_id)];
    path = active.path;
    saved_current = active.saved_current;
    if (written > 0) {
        notice = written.to_str() + " buffer(s) written";
    }
}

/// Make buffer `id` the active one; the buffer left becomes the alternate.
void App.activate(int id) {
    save_active();
    int position = index_of(id);
    if (position < 0 || id == current_id) {
        return;
    }
    Slot target = slots[position];
    share_state(editor, target.editor);
    alternate_id = current_id;
    current_id = id;
    editor = target.editor;
    path = target.path;
    saved_current = target.saved_current;
    left_column = target.left_column;
    editor.view_height = current_text_rows();
}

/// Add `slot` to the session and make it active.
void App.adopt(Slot slot) {
    slots.push(slot);
    next_id = slot.id + 1;
    activate(slot.id);
}

/// `:e [file]`, `:e!`, `:e #`, `:enew`.
void App.edit(str target, bool is_forced) {
    str name = target.trim();
    if (name == "#") {
        switch_alternate();
        return;
    }
    if (name.size() == 0 && is_in_listing()) {
        reload_listing(path, editor.buffer.line(editor.row));
        return;
    }
    if (name.size() > 0 && fs.is_directory(name)) {
        open_listing(name, "");
        return;
    }
    if (name.size() == 0) {
        // re-read the file of this buffer
        if (!is_forced && is_modified()) {
            notice = "E37: No write since last change (add ! to override)";
            return;
        }
        match (read_slot(current_id, path)) {
            case Ok(Slot fresh): {
                MED_editor.Editor old = editor;
                share_state(old, fresh.editor);
                editor = fresh.editor;
                saved_current = fresh.saved_current;
                left_column = 0;
                save_active();
                notice = file_note(path, editor);
            }
            case Err(str message): {
                notice = message;
            }
        }
        return;
    }
    for (Slot known in slots) {
        if (known.path == name) {
            activate(known.id);
            notice = file_note(path, editor);
            return;
        }
    }
    match (read_slot(next_id, name)) {
        case Ok(Slot fresh): {
            adopt(fresh);
            notice = file_note(name, editor);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

/// `:enew`: a buffer with no name.
void App.new_buffer() {
    match (read_slot(next_id, "")) {
        case Ok(Slot fresh): {
            adopt(fresh);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

void App.switch_alternate() {
    if (alternate_id == 0 || index_of(alternate_id) < 0) {
        notice = "E23: No alternate file";
        return;
    }
    activate(alternate_id);
    notice = file_note(path, editor);
}

/// The buffer `:b ARG` names: a number, `#`, `%`, or part of a file name that
/// only one buffer has. 0 when there is none, -1 when the name is ambiguous.
int App.find_buffer(str arg) {
    str word = arg.trim();
    if (word == "#") {
        return alternate_id;
    }
    if (word == "%") {
        return current_id;
    }
    match (word.parse_int()) {
        case Some(int number): {
            if (index_of(number) >= 0) {
                return number;
            }
            return 0;
        }
        case None: {
        }
    }
    int found = 0;
    int matches = 0;
    for (Slot slot in slots) {
        if (slot.path.contains(word)) {
            found = slot.id;
            matches = matches + 1;
        }
    }
    if (matches > 1) {
        return -1;
    }
    return found;
}

/// `:b ARG`.
void App.go_buffer(str arg) {
    if (arg.trim().size() == 0) {
        return;
    }
    save_active();
    int id = find_buffer(arg);
    if (id < 0) {
        notice = "E93: More than one match for " + arg.trim();
        return;
    }
    if (id == 0) {
        if (arg.trim() == "#") {
            notice = "E23: No alternate file";
        } else {
            notice = "E86: Buffer " + arg.trim() + " does not exist";
        }
        return;
    }
    activate(id);
    notice = file_note(path, editor);
}

/// `:bn`, `:bp`, `:bf`, `:bl` by position in the list; `step` wraps around.
void App.go_relative(int step, bool is_absolute) {
    save_active();
    int count = slots.size();
    int position = index_of(current_id);
    int target = 0;
    if (is_absolute) {
        if (step < 0) {
            target = count - 1;
        }
    } else {
        target = (position + step + count) % count;
    }
    activate(slots[target].id);
    notice = file_note(path, editor);
}

/// `:bd [N]`: drop a buffer; the last one is replaced by an empty buffer.
void App.delete_buffer(str arg, bool is_forced) {
    save_active();
    int id = current_id;
    if (arg.trim().size() > 0) {
        id = find_buffer(arg);
    }
    if (id <= 0) {
        notice = "E516: No buffers were deleted: bd " + arg.trim();
        return;
    }
    int position = index_of(id);
    Slot victim = slots[position];
    if (is_slot_modified(victim) && !is_forced) {
        notice = "E89: No write since last change for buffer " + id.to_str() + " (add ! to override)";
        return;
    }
    List<int> shown_in = [];
    for (MED_window.Win win in wins) {
        if (win.buffer_id == id && win.id != current_win) {
            shown_in.push(win.id);
        }
    }
    for (int win_id in shown_in) {
        close_window(win_id);
    }
    if (slots.size() == 1) {
        match (read_slot(next_id, "")) {
            case Ok(Slot fresh): {
                slots.push(fresh);
                next_id = fresh.id + 1;
            }
            case Err(str message): {
                notice = message;
                return;
            }
        }
    }
    if (id == current_id) {
        int target = alternate_id;
        if (target == 0 || target == id || index_of(target) < 0) {
            target = 0;
            for (Slot slot in slots) {
                if (slot.id != id && target == 0) {
                    target = slot.id;
                }
            }
        }
        activate(target);
    }
    slots.remove_at(index_of(id));
    if (alternate_id == id) {
        alternate_id = 0;
    }
}

/// The `:ls` listing, one line per buffer.
List<str> App.buffer_list() {
    save_active();
    List<str> lines = [];
    for (Slot slot in slots) {
        str flags = " ";
        if (slot.id == current_id) {
            flags = "%a";
        } else if (slot.id == alternate_id) {
            flags = "# ";
        } else {
            flags = "  ";
        }
        str modified = " ";
        if (is_slot_modified(slot)) {
            modified = "+";
        }
        str line = slot.id.to_str();
        while (line.size() < 3) {
            line = " " + line;
        }
        int row = slot.editor.row + 1;
        lines.push(line + " " + flags + " " + modified + " \"" + slot_name(slot) + "\" line " + row.to_str());
    }
    return lines;
}

/// Carry out what the engine asked of the UI layer.
void App.run_request(str request) {
    List<str> parts = split_request(request);
    str name = parts[0];
    str arg = parts[1];
    bool is_forced = name.ends_with("!");
    if (is_forced) {
        name = name.substr(0, name.size() - 1);
    }
    if (name == "write") {
        write_file(arg);
    } else if (name == "update") {
        if (is_modified() || arg.trim().size() > 0) {
            write_file(arg);
        }
    } else if (name == "wall") {
        write_all();
    } else if (name == "edit") {
        edit(arg, is_forced);
    } else if (name == "enew") {
        new_buffer();
    } else if (name == "buffer") {
        go_buffer(arg);
    } else if (name == "bnext") {
        go_relative(1, false);
    } else if (name == "bprevious" || name == "bNext") {
        go_relative(-1, false);
    } else if (name == "bfirst" || name == "brewind") {
        go_relative(1, true);
    } else if (name == "blast") {
        go_relative(-1, true);
    } else if (name == "bdelete" || name == "bwipeout" || name == "bunload") {
        delete_buffer(arg, is_forced);
    } else if (name == "ls" || name == "buffers" || name == "files") {
        overlay = buffer_list();
    } else if (name == "split" || name == "vsplit" || name == "new" || name == "vnew") {
        run_split(name, arg);
    } else if (name == "close") {
        close_window(current_win);
    } else if (name == "only") {
        only_window();
    } else if (name == "wincmd") {
        if (arg.trim().size() == 0) {
            notice = "E471: Argument required";
        } else {
            window_command(arg.trim().byte_at(0));
        }
    } else if (name == "source") {
        source_file(arg.trim());
    } else if (name == "Files") {
        open_picker("files", arg);
    } else if (name == "Buffers") {
        open_picker("buffers", arg);
    } else if (name == "Grep") {
        open_picker("grep", arg);
    } else if (name == "Commands") {
        open_picker("commands", arg);
    } else if (name == "help") {
        open_picker("help", arg);
    } else if (name == "Explore") {
        open_listing(explore_directory(arg), current_file_name());
    } else if (name == "Sexplore" || name == "Vexplore") {
        str directory = explore_directory(arg);
        str focus = current_file_name();
        if (did_split(name == "Vexplore")) {
            open_listing(directory, focus);
        }
    } else {
        notice = "Not supported yet: :" + request.trim();
    }
}

/// Run the pending requests, then say whether the editor should quit now. A
/// quit with unsaved changes is refused the way Vim refuses it (E37, or E162
/// for another buffer) unless it was forced.
bool App.did_finish() {
    List<str> requests = editor.requests;
    editor.requests = [];
    for (str request in requests) {
        run_request(request);
    }
    if (editor.message.contains("\n") && editor.mode != MED_editor.CMDLINE) {
        overlay = editor.message.split("\n");
    }
    if (!editor.is_quit) {
        return false;
    }
    editor.is_quit = false;
    bool is_forced = editor.is_force_quit;
    editor.is_force_quit = false;
    bool is_one = editor.is_quit_one;
    editor.is_quit_one = false;
    if (is_one && wins.size() > 1) {
        close_window(current_win);
        return false;
    }
    if (is_forced) {
        return true;
    }
    save_active();
    if (is_modified()) {
        notice = "E37: No write since last change (add ! to override)";
        return false;
    }
    for (Slot slot in slots) {
        if (is_slot_modified(slot)) {
            notice = "E162: No write since last change for buffer \"" + slot_name(slot) + "\" (add ! to override)";
            return false;
        }
    }
    return true;
}

// ------------------------------------------------------------------ windows

/// The whole screen as the loop gives it.
TUI_geometry.Rect App.screen_rect() {
    term.Size size = TUI_app.screen_size();
    return TUI_geometry.Rect(0, 0, size.columns, size.rows);
}

/// Where the windows go on `area`: every row but the last (the command line).
MED_window.Layout App.layout_in(TUI_geometry.Rect area) {
    int height = area.height - 1;
    if (height < 1) {
        height = 1;
    }
    return MED_window.place(layout, area.x, area.y, area.width, height);
}

/// The text rows of the active window (its status line takes the last row).
int App.current_text_rows() {
    MED_window.Placed placed = MED_window.placed_of(layout_in(screen_rect()), current_win);
    if (placed.height - 1 < 1) {
        return 1;
    }
    return placed.height - 1;
}

/// Make window `id` the active one: its buffer and cursor come back.
void App.focus_window(int id) {
    save_active();
    int position = win_index(id);
    if (position < 0 || id == current_win) {
        return;
    }
    MED_window.Win target = wins[position];
    int buffer_position = index_of(target.buffer_id);
    if (buffer_position < 0) {
        return;
    }
    if (target.buffer_id != current_id) {
        Slot slot = slots[buffer_position];
        share_state(editor, slot.editor);
        current_id = slot.id;
        editor = slot.editor;
        path = slot.path;
        saved_current = slot.saved_current;
    }
    if (win_index(current_win) >= 0) {
        previous_win = current_win;
    } else {
        previous_win = 0;
    }
    current_win = id;
    editor.row = target.row;
    editor.col = target.col;
    editor.view_top = target.view_top;
    left_column = target.left_column;
    editor.clamp();
    editor.want_from_cursor();
    editor.view_height = current_text_rows();
}

/// Split the active window (side by side when `is_vertical`); the new window
/// goes right or below, shows the same buffer and takes the focus. False when
/// there is no room.
bool App.did_split(bool is_vertical) {
    save_active();
    int id = next_win;
    wins.push(MED_window.Win(id, current_id, row: editor.row, col: editor.col, view_top: editor.view_top, left_column: left_column));
    layout = MED_window.split(layout, current_win, id, is_vertical, true);
    MED_window.Layout fresh = layout_in(screen_rect());
    for (MED_window.Placed one in fresh.windows) {
        if (one.height < MIN_WINDOW_HEIGHT || one.width < MIN_WINDOW_WIDTH) {
            layout = MED_window.without(layout, id);
            wins.remove_at(win_index(id));
            notice = "E36: Not enough room";
            return false;
        }
    }
    next_win = id + 1;
    focus_window(id);
    return true;
}

/// Close window `id`; the one before it in reading order (or after, for the
/// first) gets the focus when it was the active one. The buffer stays loaded.
void App.close_window(int id) {
    if (wins.size() < 2 || win_index(id) < 0) {
        notice = "E444: Cannot close last window";
        return;
    }
    save_active();
    List<int> order = MED_window.leaves(layout);
    int spot = position_of(order, id);
    int target = order[1];
    if (spot > 0) {
        target = order[spot - 1];
    }
    layout = MED_window.without(layout, id);
    wins.remove_at(win_index(id));
    if (previous_win == id) {
        previous_win = 0;
    }
    if (id == current_win) {
        current_win = -1;
        focus_window(target);
    }
}

/// `:only`: keep the active window.
void App.only_window() {
    save_active();
    if (wins.size() < 2) {
        notice = "Already only one window";
        return;
    }
    wins = [wins[win_index(current_win)]];
    layout = MED_window.leaf(current_win);
    previous_win = 0;
}

/// CTRL-W w / W: the next or previous window in reading order, wrapping.
void App.cycle_window(int step) {
    List<int> order = MED_window.leaves(layout);
    int count = order.size();
    int spot = position_of(order, current_win);
    focus_window(order[(spot + step + count) % count]);
}

/// CTRL-W h j k l: the window in that direction, from where the cursor is.
void App.move_window(int direction) {
    save_active();
    MED_window.Layout current = layout_in(screen_rect());
    MED_window.Placed here = MED_window.placed_of(current, current_win);
    int spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int ref_x = here.x + gutter_width() + spot - left_column;
    int ref_y = here.y + editor.row - editor.view_top;
    int target = MED_window.neighbor(current, current_win, direction, ref_x, ref_y);
    if (target > 0) {
        focus_window(target);
    }
}

/// The window command `key` (CTRL-W KEY, `:wincmd KEY`).
void App.window_command(int key) {
    List<int> order = MED_window.leaves(layout);
    if (key == 115 || key == 83 || key == 19) {
        did_split(false);
    } else if (key == 118 || key == 22) {
        did_split(true);
    } else if (key == 110 || key == 14) {
        if (did_split(false)) {
            new_buffer();
        }
    } else if (key == 99) {
        close_window(current_win);
    } else if (key == 113 || key == 17) {
        editor.is_quit = true;
        editor.is_quit_one = true;
    } else if (key == 111 || key == 15) {
        only_window();
    } else if (key == 119 || key == 23) {
        cycle_window(1);
    } else if (key == 87) {
        cycle_window(-1);
    } else if (key == 112 || key == 16) {
        if (win_index(previous_win) >= 0) {
            focus_window(previous_win);
        }
    } else if (key == 116 || key == 20) {
        focus_window(order[0]);
    } else if (key == 98 || key == 2) {
        focus_window(order[order.size() - 1]);
    } else if (key == 104 || key == 8) {
        move_window(MED_window.GO_LEFT);
    } else if (key == 106 || key == 10) {
        move_window(MED_window.GO_DOWN);
    } else if (key == 107 || key == 11) {
        move_window(MED_window.GO_UP);
    } else if (key == 108 || key == 12) {
        move_window(MED_window.GO_RIGHT);
    }
}

/// `:split`, `:vsplit`, `:new`, `:vnew` with an optional file.
void App.run_split(str name, str arg) {
    bool is_vertical = name == "vsplit" || name == "vnew";
    if (!did_split(is_vertical)) {
        return;
    }
    if (arg.trim().size() > 0) {
        edit(arg, false);
    } else if (name == "new" || name == "vnew") {
        new_buffer();
    }
}

// ------------------------------------------------------------------ listings

/// Whether the active buffer is a directory listing.
bool App.is_in_listing() {
    int position = index_of(current_id);
    return position >= 0 && slots[position].is_listing;
}

/// The directory `:Explore [dir]` shows: `arg`, else the directory of the file.
str App.explore_directory(str arg) {
    if (arg.trim().size() > 0) {
        return arg.trim();
    }
    if (is_in_listing()) {
        return path;
    }
    return parent_directory(path);
}

/// The name the listing cursor should rest on: the file being edited.
str App.current_file_name() {
    if (is_in_listing() || path.size() == 0) {
        return "";
    }
    return base_name(path);
}

/// Show the listing of `directory` (in this window), with the cursor on the
/// line `focus`. The buffer it came from stays loaded, as the alternate.
void App.open_listing(str directory, str focus) {
    str target = plain_directory(directory);
    if (!fs.is_directory(target)) {
        notice = "E344: Can't find directory \"" + target + "\" in cdpath";
        return;
    }
    save_active();
    if (is_in_listing()) {
        reload_listing(target, focus);
        return;
    }
    for (Slot known in slots) {
        if (known.is_listing && known.path == target) {
            activate(known.id);
            reload_listing(target, focus);
            return;
        }
    }
    adopt(listing_slot(next_id, target, focus));
}

/// Re-read the listing in the active buffer, now for `directory`.
void App.reload_listing(str directory, str focus) {
    Slot fresh = listing_slot(current_id, directory, focus);
    share_state(editor, fresh.editor);
    fresh.editor.view_height = current_text_rows();
    editor = fresh.editor;
    path = directory;
    saved_current = fresh.saved_current;
    left_column = 0;
    save_active();
}

/// `-` in a listing: the directory above, the cursor on where we came from.
void App.go_up_listing() {
    str here = path;
    open_listing(up_directory(here), base_name(here) + "/");
}

/// Enter in a listing: descend into the directory or edit the file.
void App.open_listing_entry() {
    str entry = editor.buffer.line(editor.row);
    if (entry.size() == 0) {
        return;
    }
    if (entry == "../") {
        go_up_listing();
        return;
    }
    str target = child_path(path, entry);
    if (entry.ends_with("/")) {
        open_listing(target, "");
        return;
    }
    int listing_id = current_id;
    edit(target, false);
    if (current_id == listing_id) {
        return;
    }
    save_active();
    for (MED_window.Win win in wins) {
        if (win.buffer_id == listing_id) {
            return;
        }
    }
    delete_buffer(listing_id.to_str(), true);
}

/// The text of a listing cannot change: undo whatever the last key did by
/// reading the directory again, as Vim refuses with E21 on a non-modifiable buffer.
void App.keep_listing_read_only() {
    bool is_typing = editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE;
    if (editor.current == saved_current && !is_typing) {
        return;
    }
    int row = editor.row;
    reload_listing(path, "");
    editor.row = row;
    editor.clamp();
    editor.want_from_cursor();
    notice = "E21: Cannot make changes, 'modifiable' is off";
}

// ------------------------------------------------------------------ pickers

/// Open the picker `name` (files, buffers, grep, commands, help, explore);
/// `arg` is the starting query of grep or the directory of the explorer.
void App.open_picker(str name, str arg) {
    overlay = [];
    is_leader = false;
    is_which_key = false;
    preview_path = "";
    is_grep_due = false;
    if (name == "files") {
        picker = MED_picker.make(MED_picker.KIND_FILES, "Files");
        root = MED_files.project_root();
        load_files();
    } else if (name == "buffers") {
        picker = MED_picker.make(MED_picker.KIND_BUFFERS, "Buffers");
        load_buffers();
    } else if (name == "grep") {
        picker = MED_picker.make(MED_picker.KIND_GREP, "Grep");
        root = MED_files.project_root();
        load_corpus();
        picker.query = arg.trim();
        run_grep();
    } else if (name == "commands") {
        picker = MED_picker.make(MED_picker.KIND_COMMANDS, "Commands");
        load_commands(false);
    } else if (name == "help") {
        picker = MED_picker.make(MED_picker.KIND_HELP, "Keymap");
        load_commands(true);
    } else if (name == "explore") {
        picker = MED_picker.make(MED_picker.KIND_EXPLORE, "Explore");
        picker.directory = parent_directory(path);
        if (arg.trim().size() > 0) {
            picker.directory = arg.trim();
        }
        load_directory();
    } else {
        notice = "Not supported yet: " + name;
        return;
    }
    has_picker = true;
    update_preview();
}

void App.load_files() {
    List<MED_picker.Entry> entries = [];
    for (str relative in MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used)) {
        entries.push(MED_picker.Entry(relative, path: MED_files.path_of(root, relative)));
    }
    picker.set_entries(entries);
}

void App.load_buffers() {
    save_active();
    List<MED_picker.Entry> entries = [];
    for (Slot slot in slots) {
        str text = slot.id.to_str() + "  " + slot_name(slot);
        if (is_slot_modified(slot)) {
            text = text + " [+]";
        }
        if (slot.id == current_id) {
            text = text + "  (current)";
        }
        entries.push(MED_picker.Entry(text, id: slot.id));
    }
    picker.set_entries(entries);
}

void App.load_commands(bool is_help) {
    List<MED_picker.Entry> entries = [];
    List<str> seen = [];
    List<MED_keymap.Binding> rows = [];
    for (MED_keymap.Binding row in MED_keymap.defaults()) {
        if (row.action.size() > 0) {
            rows.push(row);
        }
    }
    for (MED_keymap.Binding row in MED_keymap.commands()) {
        rows.push(row);
    }
    for (MED_keymap.Binding row in rows) {
        if (!is_help && seen.contains(row.label)) {
            continue;
        }
        seen.push(row.label);
        entries.push(MED_picker.Entry(MED_keymap.entry_text(row, is_help), action: row.action));
    }
    if (is_help) {
        for (MED_keymap.Binding row in MED_keymap.notes()) {
            entries.push(MED_picker.Entry(MED_keymap.entry_text(row, true)));
        }
    }
    picker.set_entries(entries);
}

void App.load_directory() {
    List<MED_picker.Entry> entries = [];
    entries.push(MED_picker.Entry("../", path: child_path(picker.directory, "..")));
    for (str name in MED_files.list_directory(picker.directory, picker.is_hidden_shown)) {
        str bare = name;
        if (name.ends_with("/")) {
            bare = name.substr(0, name.size() - 1);
        }
        entries.push(MED_picker.Entry(name, path: child_path(picker.directory, bare)));
    }
    picker.title = "Explore " + picker.directory;
    picker.query = "";
    picker.set_entries(entries);
}

/// Read the files grep searches (again after a toggle).
void App.load_corpus() {
    corpus = MED_grep.load(root, MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used));
}

void App.run_grep() {
    is_grep_due = false;
    List<MED_picker.Entry> entries = [];
    for (MED_grep.Hit hit in MED_grep.search(corpus, picker.query, picker.is_fixed)) {
        str text = hit.text.trim().split("\t").join(" ");
        entries.push(MED_picker.Entry(hit.path + ":" + (hit.line + 1).to_str() + ": " + text, path: MED_files.path_of(root, hit.path), line: hit.line, column: hit.column));
    }
    picker.set_entries(entries);
}

/// A toggle changed what the picker lists.
void App.reload_picker() {
    if (picker.kind == MED_picker.KIND_FILES) {
        load_files();
    } else if (picker.kind == MED_picker.KIND_GREP) {
        load_corpus();
        run_grep();
    } else if (picker.kind == MED_picker.KIND_EXPLORE) {
        load_directory();
    }
}

/// The lines previewed for the selection, read again only when the file changes.
void App.update_preview() {
    preview = MED_picker_view.Preview();
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            if (picker.kind == MED_picker.KIND_BUFFERS) {
                save_active();
                int position = index_of(entry.id);
                if (position >= 0) {
                    Slot slot = slots[position];
                    preview = MED_picker_view.Preview(title: slot_name(slot), lines: slot.editor.buffer.dump().split("\n"), focus: slot.editor.row);
                }
                return;
            }
            bool is_file = picker.kind == MED_picker.KIND_FILES || picker.kind == MED_picker.KIND_GREP || picker.kind == MED_picker.KIND_EXPLORE;
            if (!is_file || entry.path.size() == 0 || entry.text.ends_with("/")) {
                return;
            }
            if (entry.path != preview_path) {
                preview_lines = read_preview(entry.path);
                preview_path = entry.path;
            }
            int focus = -1;
            if (picker.kind == MED_picker.KIND_GREP) {
                focus = entry.line;
            }
            preview = MED_picker_view.Preview(title: entry.path, lines: preview_lines, focus: focus);
        }
        case None: {
        }
    }
}

/// Run an action row: `picker:NAME` or `ex:LINE`. True when the editor should quit.
bool App.should_quit_after_action(str action) {
    if (action.starts_with("picker:")) {
        open_picker(action.substr(7, action.size()), "");
        return false;
    }
    if (action.starts_with("ex:")) {
        MED_ex.feed(editor, 58);
        for (int code_point in action.substr(3, action.size()).chars()) {
            MED_ex.feed(editor, code_point);
        }
        MED_ex.feed(editor, MED_key.CARRIAGE_RETURN);
        return did_finish();
    }
    return false;
}

/// Enter in the picker. True when the editor should quit.
bool App.should_quit_after_accept() {
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            int kind = picker.kind;
            if (kind == MED_picker.KIND_EXPLORE && entry.text.ends_with("/")) {
                if (entry.text == "../") {
                    picker.directory = up_directory(picker.directory);
                } else {
                    picker.directory = entry.path;
                }
                load_directory();
                update_preview();
                return false;
            }
            has_picker = false;
            if (kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_EXPLORE) {
                edit(entry.path, false);
            } else if (kind == MED_picker.KIND_BUFFERS) {
                go_buffer(entry.id.to_str());
            } else if (kind == MED_picker.KIND_GREP) {
                edit(entry.path, false);
                editor.row = entry.line;
                editor.col = entry.column;
                editor.clamp();
                editor.want_from_cursor();
            } else if (entry.action.size() > 0) {
                return should_quit_after_action(entry.action);
            }
        }
        case None: {
            has_picker = false;
        }
    }
    return false;
}

/// CTRL-S / CTRL-V in a picker: a file, buffer or grep hit opens in a new
/// window; the other pickers (and directories) take the key as plain Enter.
bool App.should_quit_after_accept_in_split(bool is_vertical) {
    bool is_target = false;
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            int kind = picker.kind;
            is_target = kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_BUFFERS || kind == MED_picker.KIND_GREP || (kind == MED_picker.KIND_EXPLORE && !entry.text.ends_with("/"));
        }
        case None: {
        }
    }
    if (is_target) {
        has_picker = false;
        if (!did_split(is_vertical)) {
            return false;
        }
        has_picker = true;
    }
    return should_quit_after_accept();
}

/// One event while a picker is open.
TUI_app.Action App.handle_picker(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            keys = keys_of_key(key);
        }
        case Paste(str text): {
            for (int code_point in text.chars()) {
                if (code_point >= 32) {
                    keys.push(code_point);
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    for (int key in keys) {
        match (picker.feed(key)) {
            case Stay: {
            }
            case Accept: {
                if (should_quit_after_accept()) {
                    return TUI_app.Action.Quit;
                }
            }
            case Cancel: {
                has_picker = false;
            }
            case Requery: {
                is_grep_due = true;
                idle_ms = 0;
            }
            case Reload: {
                reload_picker();
            }
            case Up: {
                picker.directory = up_directory(picker.directory);
                load_directory();
            }
            case AcceptSplit: {
                if (should_quit_after_accept_in_split(false)) {
                    return TUI_app.Action.Quit;
                }
            }
            case AcceptVsplit: {
                if (should_quit_after_accept_in_split(true)) {
                    return TUI_app.Action.Quit;
                }
            }
        }
        if (!has_picker) {
            break;
        }
    }
    if (has_picker) {
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

// -------------------------------------------------------------- leader keys

void App.cancel_leader() {
    is_leader = false;
    is_which_key = false;
    leader = "";
}

/// One key after <Space>. True when the editor should quit.
bool App.should_quit_after_leader(int key) {
    if (key < 32 || key > 126) {
        cancel_leader();
        return false;
    }
    leader = leader + str.from_chars([key]);
    List<MED_keymap.Binding> table = MED_keymap.defaults();
    int found = MED_keymap.lookup(table, leader);
    if (found == MED_keymap.IS_LEAF) {
        MED_keymap.Binding row = MED_keymap.leaf(table, leader);
        cancel_leader();
        return should_quit_after_action(row.action);
    }
    if (found == MED_keymap.IS_PREFIX) {
        leader_ms = 0;
        return false;
    }
    notice = "No mapping for <Space>" + leader;
    cancel_leader();
    return false;
}

/// The timer: which-key after a pending leader waits, and the grep debounce.
pub TUI_app.Action App.tick(int elapsed_ms) {
    if (is_leader && !is_which_key) {
        leader_ms = leader_ms + elapsed_ms;
        if (leader_ms >= MED_keymap.WHICH_KEY_MS) {
            is_which_key = true;
            return TUI_app.Action.Redraw;
        }
    }
    if (editor.ta_keys.size() > 0 && !has_picker) {
        map_ms = map_ms + elapsed_ms;
        if (map_ms >= MAP_TIMEOUT_MS) {
            map_ms = 0;
            MED_ex.flush_maps(editor);
            did_finish();
            return TUI_app.Action.Redraw;
        }
    }
    if (has_picker && is_grep_due) {
        idle_ms = idle_ms + elapsed_ms;
        if (idle_ms >= GREP_DEBOUNCE_MS) {
            run_grep();
            update_preview();
            return TUI_app.Action.Redraw;
        }
    }
    return TUI_app.Action.Continue;
}

/// One key for the engine, with the front end's own mappings first. True when
/// the editor should quit.
bool App.should_quit_after(int key) {
    if (is_leader) {
        return should_quit_after_leader(key);
    }
    if (is_window_key) {
        is_window_key = false;
        if (key != MED_key.ESC) {
            window_command(key);
        }
        return did_finish();
    }
    if (editor.mode == MED_editor.NORMAL && key == 23 && editor.pending.size() == 0) {
        is_window_key = true;
        return false;
    }
    if (editor.mode == MED_editor.NORMAL && key == MED_key.SPACE && editor.pending.size() == 0 && editor.ta_keys.size() == 0 && !editor.maps.has_prefix("n", MED_key.SPACE)) {
        is_leader = true;
        is_which_key = false;
        leader = "";
        leader_ms = 0;
        return false;
    }
    int sent = key;
    if (editor.mode == MED_editor.INSERT && key == 107 && last_key == 106 && !editor.maps.has_prefix("i", 106)) {
        // jk: take back the j and leave Insert mode
        MED_ex.feed(editor, MED_key.BACKSPACE);
        sent = MED_key.ESC;
    } else if (editor.mode == MED_editor.CMDLINE && editor.cmd_type == 58 && editor.cmdline.size() == 0 && key == MED_key.CARRIAGE_RETURN) {
        // Enter on an empty `:` opens the palette
        MED_ex.feed(editor, MED_key.ESC);
        open_picker("commands", "");
        last_key = 0;
        return false;
    }
    last_key = sent;
    if (sent == MED_key.ESC) {
        last_key = 0;
    }
    if (editor.mode == MED_editor.NORMAL && editor.pending.size() == 0 && is_in_listing()) {
        if (sent == MED_key.CARRIAGE_RETURN) {
            open_listing_entry();
            return did_finish();
        }
        if (sent == 45) {
            go_up_listing();
            return did_finish();
        }
    }
    MED_ex.feed(editor, sent);
    if (is_in_listing()) {
        keep_listing_read_only();
    }
    return did_finish();
}

/// Read the system clipboard into the `+` register when the keys may use it.
void App.refresh_clipboard(List<int> keys) {
    if (!clipboard.is_present) {
        return;
    }
    bool is_wanted = false;
    for (int key in keys) {
        if (key == 112 || key == 80 || key == 43 || key == 42 || key == 18 || key == 34 || key == 58) {
            is_wanted = true;
        }
    }
    if (!is_wanted) {
        return;
    }
    match (MED_clip.paste(clipboard)) {
        case Some(str text): {
            editor.regs.set_clipboard(text);
        }
        case None: {
        }
    }
}

/// Hand a changed `+` register to the system clipboard.
void App.flush_clipboard() {
    if (clipboard.is_present && editor.regs.is_clip_dirty) {
        MED_clip.did_copy(clipboard, editor.regs.clip_text());
        editor.regs.did_flush_clipboard();
    }
}

/// One event: feed its keys to the engine, then the UI requests.
pub TUI_app.Action App.handle(term.Event event) {
    if (has_picker) {
        return handle_picker(event);
    }
    List<int> keys = keys_of(event);
    if (keys.size() == 0) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    if (overlay.size() > 0) {
        // the listing goes away with the next key; Enter, Space and Esc only dismiss it
        overlay = [];
        if (keys.size() == 1 && (keys[0] == MED_key.CARRIAGE_RETURN || keys[0] == 32 || keys[0] == MED_key.ESC)) {
            return TUI_app.Action.Redraw;
        }
    }
    editor.view_height = current_text_rows();
    map_ms = 0;
    refresh_clipboard(keys);
    for (int key in keys) {
        if (has_picker) {
            // a request opened a picker; the rest of the keys are its
            picker.feed(key);
            continue;
        }
        if (should_quit_after(key)) {
            flush_clipboard();
            return TUI_app.Action.Quit;
        }
    }
    flush_clipboard();
    if (has_picker) {
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

/// The byte offset in line `row` of the character shown at display column `spot`.
int App.offset_at(int row, int spot) {
    str line = editor.buffer.line(row);
    int shown_to = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        shown_to = shown_to + MED_text.cell_width(line, offset, shown_to, editor.tab);
        if (spot < shown_to) {
            return offset;
        }
    }
    return line.size();
}

/// Put the cursor on the text cell under the pointer; false outside the text.
bool App.did_place_cursor(int screen_x, int screen_y) {
    MED_window.Placed here = MED_window.placed_of(layout_in(screen_rect()), current_win);
    int x_cell = screen_x - here.x;
    int y_cell = screen_y - here.y;
    int rows = here.height - 1;
    if (y_cell < 0 || y_cell >= rows || x_cell < 0) {
        return false;
    }
    int row = editor.view_top + y_cell;
    if (row >= editor.buffer.line_count()) {
        row = editor.buffer.line_count() - 1;
    }
    int spot = left_column;
    if (x_cell > gutter_width()) {
        spot = spot + x_cell - gutter_width();
    }
    editor.row = row;
    editor.col = offset_at(row, spot);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

/// A mouse gesture: a press puts the cursor there, a drag selects, the wheel scrolls.
pub TUI_app.Action App.handle_mouse(TUI_mouse.Routed routed) {
    TUI_mouse.Gesture gesture = routed.gesture;
    if (has_picker) {
        return handle_picker_wheel(gesture);
    }
    if (is_leader) {
        cancel_leader();
    }
    if (editor.mode == MED_editor.CMDLINE || editor.mode == MED_editor.REPLACE) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    overlay = [];
    editor.view_height = current_text_rows();
    match (gesture.kind) {
        case Press: {
            if (gesture.button == 0) {
                if (editor.mode == MED_editor.VISUAL) {
                    MED_ex.feed(editor, MED_key.ESC);
                }
                int hit = MED_window.window_at(layout_in(screen_rect()), gesture.x, gesture.y);
                if (hit > 0 && hit != current_win) {
                    focus_window(hit);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case Drag: {
            if (gesture.button == 0) {
                if (editor.mode == MED_editor.NORMAL) {
                    MED_ex.feed(editor, VKIND_CHAR);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case ScrollUp: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 25);
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollDown: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 5);
            }
            return TUI_app.Action.Redraw;
        }
        case Release: {
        }
        case Click: {
        }
        case Hover: {
        }
        case Leave: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
    return TUI_app.Action.Continue;
}

str App.mode_name() {
    if (editor.mode == MED_editor.INSERT) {
        return "INSERT";
    }
    if (editor.mode == MED_editor.REPLACE) {
        return "REPLACE";
    }
    if (editor.mode == MED_editor.CMDLINE) {
        return "COMMAND";
    }
    if (editor.mode == MED_editor.VISUAL) {
        if (editor.vkind == VKIND_CHAR) {
            return "VISUAL";
        }
        if (editor.vkind == VKIND_LINE) {
            return "V-LINE";
        }
        return "V-BLOCK";
    }
    return "NORMAL";
}

/// The columns of the line-number gutter, with its trailing space.
int App.gutter_width() {
    return gutter_of(editor);
}

/// Whether the character at (`row`, `col`), shown from display column `spot`,
/// is inside the Visual selection.
bool App.is_selected(int row, int col, int spot) {
    if (editor.mode != MED_editor.VISUAL) {
        return false;
    }
    MED_buffer.Pos anchor = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos cursor = editor.cursor();
    MED_buffer.Pos first = anchor;
    MED_buffer.Pos last = cursor;
    if (anchor.cmp(cursor) > 0) {
        first = cursor;
        last = anchor;
    }
    if (row < first.row || row > last.row) {
        return false;
    }
    if (editor.vkind == VKIND_LINE) {
        return true;
    }
    if (editor.vkind == VKIND_CHAR) {
        MED_buffer.Pos here = MED_buffer.Pos(row, col);
        return here.cmp(first) >= 0 && here.cmp(last) <= 0;
    }
    int anchor_spot = MED_text.display_col(editor.buffer.line(editor.vrow), editor.vcol, editor.tab);
    int cursor_spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int low = anchor_spot;
    int high = cursor_spot;
    if (anchor_spot > cursor_spot) {
        low = cursor_spot;
        high = anchor_spot;
    }
    return spot >= low && spot <= high;
}

/// The matches of the last search pattern in `row`: start and end byte offsets.
List<int> App.search_spans(MED_editor.Editor subject, MED_regex.Regex regex, int row) {
    List<int> spans = [];
    str line = subject.buffer.line(row);
    int from = 0;
    int guard = 0;
    while (from <= line.size() && guard < 500) {
        guard = guard + 1;
        MED_regex.Match found = regex.search_line(subject.buffer, row, from);
        if (!found.is_ok || found.srow != row) {
            break;
        }
        int stop = line.size();
        if (found.erow == row) {
            stop = found.ecol;
        }
        spans.push(found.scol);
        spans.push(stop);
        if (stop > found.scol) {
            from = stop;
        } else if (found.scol < line.size()) {
            from = MED_text.next_col(line, found.scol);
        } else {
            break;
        }
    }
    return spans;
}

/// Draw the part [`from`, `to`) of a line of `subject` at screen row `y`:
/// cells whose display column is in [`left`, `left` + `text_width`).
void App.draw_line(TUI_buffer.Buffer buffer, MED_editor.Editor subject, int left, bool is_active, int row, int x_start, int y, int text_width, int from, int stop_at, List<int> spans) {
    str line = subject.buffer.line(row);
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style selected = TUI_style.Style(background: TUI_style.Colour.Indexed(SELECTION_COLOUR));
    TUI_style.Style found = TUI_style.Style(foreground: TUI_style.Colour.Indexed(0), background: TUI_style.Colour.Indexed(3));
    bool is_list = subject.is_option_on("list", false);
    int spot = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size() || offset >= stop_at) {
            break;
        }
        int width = MED_text.cell_width(line, offset, spot, subject.tab);
        int next = MED_text.next_col(line, offset);
        if (offset >= from && spot >= left && spot + width <= left + text_width) {
            TUI_style.Style style = plain;
            if (is_in_spans(spans, offset)) {
                style = found;
            }
            if (is_active && is_selected(row, offset, spot)) {
                style = selected;
            }
            str text = shown(line, offset, next, width);
            if (is_list && MED_text.cp_at(line, offset) == 9) {
                text = "^I" + " ".repeat(width - 2);
                if (width < 2) {
                    text = "^";
                }
            }
            buffer.set_str(x_start + spot - left, y, text, style);
        }
        spot = spot + width;
        if (spot >= left + text_width && !subject.is_option_on("wrap", true)) {
            break;
        }
    }
    if (is_list && stop_at >= line.size()) {
        // 'list' shows the end of the line as $
        int end_spot = MED_text.line_width(line, subject.tab);
        if (end_spot >= left && end_spot < left + text_width) {
            buffer.set_str(x_start + end_spot - left, y, "$", TUI_style.Style(foreground: TUI_style.Colour.Indexed(4)));
        }
    }
}

/// The pending keys of an unfinished command (`2d`), as typed.
str App.pending_text() {
    if (is_leader) {
        return "<Space>" + leader;
    }
    if (is_window_key) {
        return "^W";
    }
    str out = "";
    for (int key in editor.pending) {
        if (key >= 32 && key < 127) {
            out = out + str.from_chars([key]);
        } else if (key > 0 && key < 32) {
            out = out + "^" + str.from_chars([key + 64]);
        }
    }
    return out;
}

/// A window's status line at its last row: (the mode of the active one,) name
/// and modified flag on the left; position on the right.
void App.draw_status(TUI_buffer.Buffer buffer, MED_window.Placed frame, MED_editor.Editor subject, str file, bool is_changed, bool is_active) {
    TUI_style.Style bar = TUI_style.Style(attrs: TUI_style.REVERSE);
    TUI_style.Style strong = TUI_style.Style(attrs: TUI_style.REVERSE | TUI_style.BOLD);
    int y = frame.y + frame.height - 1;
    buffer.fill(TUI_geometry.Rect(frame.x, y, frame.width, 1), " ", bar);
    str name = file;
    if (name.size() == 0) {
        name = "[No Name]";
    }
    if (is_changed) {
        name = name + " [+]";
    }
    int used = 0;
    if (is_active) {
        used = buffer.set_str(frame.x, y, " " + mode_name() + " ", strong);
    }
    buffer.set_str(frame.x + used, y, " " + name, bar, max: frame.width - used);
    int vcol = MED_text.display_col(subject.buffer.line(subject.row), subject.col, subject.tab);
    int count = subject.buffer.line_count();
    int percent = (subject.row + 1) * 100 / count;
    str where = (subject.row + 1).to_str() + ":" + (vcol + 1).to_str() + "  " + percent.to_str() + "% ";
    int where_x = frame.x + frame.width - where.size();
    if (where_x > frame.x + used + name.size() + 2) {
        buffer.set_str(where_x, y, where, bar);
    }
}

/// The command line (while typing `:` or `/`) or the message.
void App.draw_message(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int y) {
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style alert = TUI_style.Style(foreground: TUI_style.Colour.Indexed(1), attrs: TUI_style.BOLD);
    if (editor.mode == MED_editor.CMDLINE) {
        buffer.set_str(area.x, y, str.from_chars([editor.cmd_type]) + editor.cmdline, plain, max: area.width);
        return;
    }
    str text = notice;
    if (text.size() == 0) {
        text = editor.message;
    }
    text = first_line(text);
    TUI_style.Style style = plain;
    if (is_error_text(text)) {
        style = alert;
    }
    buffer.set_str(area.x, y, text, style, max: area.width);
    str right = pending_text();
    if (editor.macro_reg.size() > 0) {
        right = "recording @" + editor.macro_reg + " " + right;
    }
    if (right.size() > 0 && text.size() + right.size() + 2 < area.width) {
        buffer.set_str(area.x + area.width - right.size() - 1, y, right, plain);
    }
}

/// The listing over the bottom of the text window, with Vim's prompt.
void App.draw_overlay(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int rows) {
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style prompt = TUI_style.Style(foreground: TUI_style.Colour.Indexed(2));
    List<str> lines = overlay.slice(0, overlay.size());
    int shown_lines = lines.size() + 1;
    if (shown_lines > rows) {
        shown_lines = rows;
    }
    int top = area.y + rows - shown_lines;
    for (int position in 0 .. shown_lines) {
        buffer.fill(TUI_geometry.Rect(area.x, top + position, area.width, 1), " ", plain);
        if (position < shown_lines - 1) {
            buffer.set_str(area.x, top + position, lines[position], plain, max: area.width);
        } else {
            buffer.set_str(area.x, top + position, "Press ENTER or type command to continue", prompt, max: area.width);
        }
    }
}

/// Draw window `frame` (the active one when `is_active`): the line numbers, the
/// text and the status line. Another window shows its own cursor and view, which
/// are lent to the buffer's editor for the drawing.
void App.draw_window(TUI_buffer.Buffer buffer, MED_window.Placed frame, bool is_active) {
    int rows = frame.height - 1;
    if (rows < 1) {
        rows = 1;
    }
    MED_editor.Editor subject = editor;
    str file = path;
    if (is_in_listing()) {
        file = slot_name(slots[index_of(current_id)]);
    }
    bool is_changed = is_modified();
    int left = left_column;
    MED_window.Win win = wins[win_index(frame.win_id)];
    int kept_row = subject.row;
    int kept_col = subject.col;
    int kept_top = subject.view_top;
    int kept_height = subject.view_height;
    if (!is_active) {
        Slot slot = slots[index_of(win.buffer_id)];
        subject = slot.editor;
        file = slot.path;
        if (slot.is_listing) {
            file = slot_name(slot);
        }
        is_changed = is_slot_modified(slot);
        left = win.left_column;
        kept_row = subject.row;
        kept_col = subject.col;
        kept_top = subject.view_top;
        kept_height = subject.view_height;
        subject.row = win.row;
        subject.col = win.col;
        subject.view_top = win.view_top;
        subject.clamp();
    }
    subject.view_height = rows;
    int gutter = gutter_of(subject);
    int text_width = frame.width - gutter;
    if (text_width < 1) {
        text_width = 1;
    }
    subject.view_width = text_width;
    subject.view_gutter = gutter;
    MED_view.update(subject);
    bool is_wrap = subject.is_option_on("wrap", true);
    int cursor_spot = MED_text.display_col(subject.buffer.line(subject.row), subject.col, subject.tab);
    if (is_wrap) {
        left = 0;
    } else {
        if (cursor_spot < left) {
            left = cursor_spot;
        }
        if (cursor_spot >= left + text_width) {
            left = cursor_spot - text_width + 1;
        }
    }
    TUI_style.Style dim = TUI_style.Style(attrs: TUI_style.DIM);
    TUI_style.Style filler = TUI_style.Style(foreground: TUI_style.Colour.Indexed(4));
    TUI_style.Style current = TUI_style.Style(attrs: TUI_style.BOLD);
    MED_regex.Regex regex = MED_regex.compile("", false, false, "");
    bool is_highlight = false;
    if (subject.is_option_on("hlsearch", true) && !subject.is_no_hl) {
        str pattern = MED_search.last_pattern(subject);
        if (pattern.size() > 0) {
            regex = MED_search.compile_with(subject, pattern, subject.is_search_no_scs);
            is_highlight = regex.is_ok;
        }
    }
    int screen_row = 0;
    int row = subject.view_top;
    int cursor_screen_row = 0;
    int cursor_screen_x = 0;
    while (screen_row < rows) {
        int y = frame.y + screen_row;
        if (row >= subject.buffer.line_count()) {
            buffer.set_str(frame.x, y, "~", filler);
            screen_row = screen_row + 1;
            continue;
        }
        str line = subject.buffer.line(row);
        List<int> breaks = [0];
        if (is_wrap) {
            breaks = MED_text.wrap_breaks(line, text_width, subject.tab);
        }
        List<int> spans = [];
        if (is_highlight) {
            spans = search_spans(subject, regex, row);
        }
        int total = breaks.size();
        if (is_wrap && subject.row == row && subject.col >= line.size() && subject.mode != MED_editor.NORMAL && subject.mode != MED_editor.VISUAL) {
            // the cursor after the last character may need a row of its own
            int last_start = MED_text.display_col(line, breaks[total - 1], subject.tab);
            if (MED_text.line_width(line, subject.tab) - last_start >= text_width) {
                total = total + 1;
            }
        }
        int first_part = 0;
        if (is_wrap && row == subject.view_top) {
            first_part = MED_view.top_skip(subject);
            if (first_part > total - 1) {
                first_part = total - 1;
            }
        }
        int visible = total - first_part;
        if (row == subject.row) {
            int cursor_part = 0;
            for (int part in 0 .. breaks.size()) {
                if (breaks[part] <= subject.col) {
                    cursor_part = part;
                }
            }
            int base = left;
            if (is_wrap) {
                base = MED_text.display_col(line, breaks[cursor_part], subject.tab);
                if (total > breaks.size() && subject.col >= line.size()) {
                    cursor_part = breaks.size();
                    base = MED_text.line_width(line, subject.tab);
                }
            }
            cursor_screen_row = screen_row + cursor_part - first_part;
            cursor_screen_x = cursor_spot - base;
        }
        for (int part in first_part .. total) {
            int shown_part = part - first_part;
            if (screen_row + shown_part >= rows) {
                break;
            }
            int part_y = y + shown_part;
            if (part == 0) {
                buffer.set_str(frame.x, part_y, number_text(subject, row, gutter), dim);
                if (row == subject.row) {
                    buffer.set_str(frame.x, part_y, number_text(subject, row, gutter), current);
                }
            }
            int from = 0;
            int stop_at = line.size();
            int base = left;
            if (is_wrap) {
                if (part < breaks.size()) {
                    from = breaks[part];
                    base = MED_text.display_col(line, from, subject.tab);
                }
                if (part + 1 < breaks.size()) {
                    stop_at = breaks[part + 1];
                }
                if (part >= breaks.size()) {
                    from = line.size();
                    base = MED_text.line_width(line, subject.tab);
                }
            }
            draw_line(buffer, subject, base, is_active, row, frame.x + gutter, part_y, text_width, from, stop_at, spans);
            if (shown_part == 0 && first_part > 0) {
                buffer.set_str(frame.x + gutter, part_y, "<<<", filler);
            }
        }
        if (screen_row > 0 && screen_row + visible > rows && is_wrap) {
            // a last line that does not fit: what fits, then "@@@" (display=lastline)
            buffer.set_str(frame.x + gutter, frame.y + rows - 1, "@@@", filler);
        }
        screen_row = screen_row + visible;
        row = row + 1;
    }
    draw_status(buffer, frame, subject, file, is_changed, is_active);
    if (is_active) {
        left_column = left;
        cursor_x = frame.x + gutter + cursor_screen_x;
        cursor_y = frame.y + cursor_screen_row;
    } else {
        win.row = subject.row;
        win.col = subject.col;
        win.view_top = subject.view_top;
        win.left_column = left;
        subject.row = kept_row;
        subject.col = kept_col;
        subject.view_top = kept_top;
        subject.view_height = kept_height;
    }
}

/// Draw the whole screen.
pub void App.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    save_active();
    MED_window.Layout placed = layout_in(area);
    for (MED_window.Placed one in placed.windows) {
        draw_window(buffer, one, one.win_id == current_win);
    }
    TUI_style.Style dim = TUI_style.Style(attrs: TUI_style.DIM);
    for (MED_window.Placed bar in placed.separators) {
        for (int offset in 0 .. bar.height) {
            buffer.set_str(bar.x, bar.y + offset, "|", dim);
        }
    }
    int rows = area.height - FOOTER_ROWS;
    if (rows < 1) {
        rows = 1;
    }
    if (overlay.size() > 0) {
        draw_overlay(buffer, area, rows);
    }
    if (is_leader && is_which_key) {
        TUI_menu.WhichKey menu = TUI_menu.WhichKey("<Space>" + leader, MED_keymap.next_items(MED_keymap.defaults(), leader));
        menu.render(buffer, TUI_geometry.Rect(area.x, area.y, area.width, rows));
    }
    if (has_picker) {
        picker.scroll_to(MED_picker_view.list_rows(area));
        if (preview.focus >= 0) {
            preview.first = preview.focus - MED_picker_view.list_rows(area) / 3;
            if (preview.first < 0) {
                preview.first = 0;
            }
        }
        MED_picker_view.render(buffer, area, picker, preview);
    }
    int message_y = area.y + area.height - 1;
    draw_message(buffer, area, message_y);
    TUI_style.Style cursor_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    if (overlay.size() > 0 || has_picker || is_leader) {
        return;
    }
    if (editor.mode == MED_editor.CMDLINE) {
        int command_x = area.x + 1 + MED_text.line_width(editor.cmdline.substr(0, editor.cmd_position), editor.tab);
        if (command_x < area.x + area.width) {
            buffer.set_style(command_x, message_y, cursor_style);
        }
    } else {
        buffer.set_style(cursor_x, cursor_y, cursor_style);
    }
}

/// The mouse wheel moves the picker's selection; nothing else is handled.
TUI_app.Action App.handle_picker_wheel(TUI_mouse.Gesture gesture) {
    match (gesture.kind) {
        case ScrollUp: {
            picker.feed(MED_key.UP_KEY);
        }
        case ScrollDown: {
            picker.feed(MED_key.DOWN);
        }
        case Press: {
            return TUI_app.Action.Continue;
        }
        case Drag: {
            return TUI_app.Action.Continue;
        }
        case Release: {
            return TUI_app.Action.Continue;
        }
        case Click: {
            return TUI_app.Action.Continue;
        }
        case Hover: {
            return TUI_app.Action.Continue;
        }
        case Leave: {
            return TUI_app.Action.Continue;
        }
        case ScrollLeft: {
            return TUI_app.Action.Continue;
        }
        case ScrollRight: {
            return TUI_app.Action.Continue;
        }
    }
    update_preview();
    return TUI_app.Action.Redraw;
}

/// Run ex lines from `text` (a keymap file or `:source`): blank lines and `"`
/// comments are skipped, a leading `:` is dropped. The first failure stops the
/// run; the result is its message, or "" when every line ran.
pub str App.run_script(str text, str label) {
    int number = 0;
    for (str raw in text.split("\n")) {
        number = number + 1;
        str line = raw.trim();
        if (line.size() == 0 || line.starts_with("\"")) {
            continue;
        }
        while (line.starts_with(":")) {
            line = line.substr(1, line.size()).trim();
        }
        if (line.size() == 0) {
            continue;
        }
        if (!MED_ex.did_run_line(editor, line)) {
            return label + " line " + number.to_str() + ": " + editor.message;
        }
    }
    return "";
}

/// `:source FILE`: run the file's ex lines.
void App.source_file(str name) {
    if (name.size() == 0) {
        notice = "E471: Argument required";
        return;
    }
    str file = expand_home(name);
    if (!fs.is_present(file) || fs.is_directory(file)) {
        notice = "E484: Can't open file " + name;
        return;
    }
    match (io.read(file)) {
        case Ok(str content): {
            str failure = run_script(content, name);
            editor.message = "";
            notice = failure;
        }
        case Err(io.Error error): {
            notice = "E484: Can't open file " + name;
        }
    }
}

/// Load the keymap file into the active buffer's editor (the maps follow to
/// the others). A missing file is not an error unless it was asked for by name.
pub void App.load_keymap(str file, bool is_required) {
    if (file.size() == 0) {
        return;
    }
    if (!fs.is_present(file)) {
        if (is_required) {
            notice = "E484: Can't open file " + file;
        }
        return;
    }
    match (io.read(file)) {
        case Ok(str content): {
            notice = run_script(content, file);
            editor.message = "";
        }
        case Err(io.Error error): {
            notice = "E484: Can't open file " + file;
        }
    }
}

bool is_in_spans(List<int> spans, int offset) {
    int index = 0;
    while (index + 1 < spans.size()) {
        if (offset >= spans[index] && offset < spans[index + 1]) {
            return true;
        }
        index = index + 2;
    }
    return false;
}

int gutter_of(MED_editor.Editor shown) {
    bool is_number = shown.is_option_on("number", true);
    bool is_relative = shown.is_option_on("relativenumber", false);
    if (!is_number && !is_relative) {
        return 0;
    }
    int lines = shown.buffer.line_count();
    if (is_relative && !is_number) {
        lines = shown.view_height;
    }
    int digits = lines.to_str().size();
    int least = shown.option_number("numberwidth", 4) - 1;
    if (least < 1) {
        least = 1;
    }
    if (digits < least) {
        digits = least;
    }
    return digits + 1;
}

/// The line-number column for buffer line `row`, as wide as `gutter`.
str number_text(MED_editor.Editor shown, int row, int gutter) {
    bool is_number = shown.is_option_on("number", true);
    bool is_relative = shown.is_option_on("relativenumber", false);
    if (gutter == 0) {
        return "";
    }
    int shown_number = row + 1;
    bool is_left = false;
    if (is_relative) {
        int distance = row - shown.row;
        if (distance < 0) {
            distance = 0 - distance;
        }
        if (is_number && distance == 0) {
            is_left = true;
        } else {
            shown_number = distance;
        }
    }
    str digits = shown_number.to_str();
    if (is_left) {
        return digits + " ".repeat(gutter - digits.size());
    }
    return " ".repeat(gutter - 1 - digits.size()) + digits + " ";
}

/// Write `slot`'s text to `target` (its own file when `target` is empty) and
/// say what happened, in Vim's words.
str write_slot(Slot slot, str target) {
    if (slot.is_listing) {
        return "E382: Cannot write, 'buftype' option is set";
    }
    str name = target.trim();
    if (name.size() == 0) {
        name = slot.path;
    }
    if (name.size() == 0) {
        return "E32: No file name";
    }
    str text = slot.editor.buffer.dump();
    match (io.write(name, text)) {
        case Ok(int count): {
            if (slot.path.size() == 0) {
                slot.path = name;
                slot.editor.buffer.path = name;
            }
            if (name == slot.path) {
                slot.saved_current = slot.editor.current;
                slot.editor.saved_nodes.push(slot.editor.current);
                slot.editor.buffer.is_modified = false;
            }
            return "\"" + name + "\" " + slot.editor.buffer.line_count().to_str() + "L, " + count.to_str() + "B written";
        }
        case Err(io.Error error): {
            return "E212: Can't open file for writing: " + error.to_str();
        }
    }
}

/// Whether the buffer of `slot` differs from its file.
bool is_slot_modified(Slot slot) {
    if (slot.is_listing) {
        return false;
    }
    return slot.editor.current != slot.saved_current;
}

/// How `:ls` and the errors name a buffer.
str slot_name(Slot slot) {
    if (slot.path.size() == 0) {
        return "[No Name]";
    }
    if (slot.is_listing && !slot.path.ends_with("/")) {
        return slot.path + "/";
    }
    return slot.path;
}

/// `directory` without a trailing slash (the root keeps its own).
str plain_directory(str directory) {
    str plain = directory;
    while (plain.size() > 1 && plain.ends_with("/")) {
        plain = plain.substr(0, plain.size() - 1);
    }
    return plain;
}

/// The last part of a path.
str base_name(str file) {
    int spot = last_slash(file);
    if (spot < 0) {
        return file;
    }
    return file.substr(spot + 1, file.size());
}

/// The text of a directory listing: `../`, then folders, then files.
str listing_text(str directory) {
    List<str> lines = ["../"];
    for (str name in MED_files.list_directory(directory, true)) {
        lines.push(name);
    }
    return lines.join("\n") + "\n";
}

/// A listing slot for `directory`, the cursor on the line `focus` (the first
/// entry when there is no such line).
Slot listing_slot(int id, str directory, str focus) {
    MED_editor.Editor loaded = MED_editor.new(listing_text(directory));
    loaded.buffer.path = directory;
    int row = 0;
    if (loaded.buffer.line_count() > 1) {
        row = 1;
    }
    for (int index in 0 .. loaded.buffer.line_count()) {
        if (focus.size() > 0 && loaded.buffer.line(index) == focus) {
            row = index;
        }
    }
    loaded.row = row;
    loaded.clamp();
    loaded.want_from_cursor();
    return Slot(id, loaded, directory, is_listing: true);
}

/// What the engine keeps across buffers: registers, search and substitute
/// state, the dot command, histories and the options.
void share_state(MED_editor.Editor from, MED_editor.Editor into) {
    into.regs = from.regs;
    into.search_pattern = from.search_pattern;
    into.search_directory = from.search_directory;
    into.sub_pattern = from.sub_pattern;
    into.sub_replacement = from.sub_replacement;
    into.sub_flags = from.sub_flags;
    into.sub_old = from.sub_old;
    into.is_sub_has = from.is_sub_has;
    into.is_last_is_sub = from.is_last_is_sub;
    into.is_search_no_scs = from.is_search_no_scs;
    into.is_search_off_line = from.is_search_off_line;
    into.is_search_off_end = from.is_search_off_end;
    into.search_off = from.search_off;
    into.search_typed = from.search_typed;
    into.is_no_hl = from.is_no_hl;
    into.hist_ex = from.hist_ex;
    into.hist_search = from.hist_search;
    into.last_macro = from.last_macro;
    into.dot = from.dot;
    into.dot_reg = from.dot_reg;
    into.dot_count = from.dot_count;
    into.dot_body = from.dot_body;
    into.dot_tail = from.dot_tail;
    into.dot_vkind = from.dot_vkind;
    into.dot_vlines = from.dot_vlines;
    into.dot_vcols = from.dot_vcols;
    into.dot_vwant = from.dot_vwant;
    into.find = from.find;
    into.is_hexupper = from.is_hexupper;
    into.tab = from.tab;
    into.shiftwidth = from.shiftwidth;
    into.textwidth = from.textwidth;
    into.view_width = from.view_width;
    into.commentstring = from.commentstring;
    into.is_expandtab = from.is_expandtab;
    into.is_autoindent = from.is_autoindent;
    into.is_ignorecase = from.is_ignorecase;
    into.is_smartcase = from.is_smartcase;
    into.is_wrapscan = from.is_wrapscan;
    into.is_joinspaces = from.is_joinspaces;
    into.is_startofline = from.is_startofline;
    into.softtabstop = from.softtabstop;
    into.is_smarttab = from.is_smarttab;
    into.is_shiftround = from.is_shiftround;
    for (str name in from.opts.keys()) {
        into.opts.set(name, from.opts.get(name).or(""));
    }
    into.scroll_opt = from.scroll_opt;
    into.view_height = from.view_height;
    into.maps = from.maps;
}

/// Vim's "file info" message for a buffer just read.
str file_note(str name, MED_editor.Editor loaded) {
    if (name.size() == 0) {
        return "";
    }
    if (fs.is_present(name)) {
        return "\"" + name + "\" " + loaded.buffer.line_count().to_str() + "L, " + loaded.buffer.dump().size().to_str() + "B";
    }
    return "\"" + name + "\" [New]";
}

/// A new slot holding `name` (an empty buffer when the file does not exist yet
/// or `name` is empty); an error for a directory or an unreadable file.
Result<Slot, str> read_slot(int id, str name) {
    str text = "";
    if (name.size() > 0) {
        if (fs.is_directory(name)) {
            return Result<Slot, str>.Err("\"" + name + "\" is a directory");
        }
        if (fs.is_present(name)) {
            match (io.read(name)) {
                case Ok(str content): {
                    text = content;
                }
                case Err(io.Error error): {
                    return Result<Slot, str>.Err("\"" + name + "\": " + error.to_str());
                }
            }
        }
    }
    MED_editor.Editor loaded = MED_editor.new(text);
    loaded.buffer.path = name;
    loaded.commentstring = comment_for(name);
    return Result<Slot, str>.Ok(Slot(id, loaded, name));
}

const List<str> HASH_TYPES = ["py", "sh", "bash", "zsh", "rb", "pl", "toml", "yaml", "yml", "conf", "mk", "cfg", "ini", "r", "jl", "nix", "dockerfile"];
const List<str> SLASH_TYPES = ["m31", "oro", "c", "h", "cpp", "hpp", "cc", "cxx", "rs", "go", "java", "js", "mjs", "ts", "jsx", "tsx", "swift", "kt", "zig", "cs", "scala", "dart", "php", "proto"];
const List<str> DASH_TYPES = ["lua", "sql", "hs", "elm", "ada"];
const List<str> MARKUP_TYPES = ["html", "htm", "xml", "svg", "md", "markdown"];

/// The 'commentstring' for a file name, from its extension ("" when unknown).
pub str comment_for(str name) {
    List<str> parts = name.split("/");
    str base = parts[parts.size() - 1];
    if (base == "Makefile" || base == "makefile" || base == "Dockerfile" || base == "CMakeLists.txt") {
        return "# %s";
    }
    List<str> pieces = base.split(".");
    if (pieces.size() < 2) {
        return "";
    }
    str ext = pieces[pieces.size() - 1].to_lower();
    if (HASH_TYPES.contains(ext)) {
        return "# %s";
    }
    if (SLASH_TYPES.contains(ext)) {
        return "// %s";
    }
    if (DASH_TYPES.contains(ext)) {
        return "-- %s";
    }
    if (MARKUP_TYPES.contains(ext)) {
        return "<!-- %s -->";
    }
    if (ext == "css" || ext == "scss") {
        return "/* %s */";
    }
    if (ext == "vim") {
        return "\" %s";
    }
    if (ext == "tex") {
        return "% %s";
    }
    return "";
}

// -------------------------------------------------------------- keymap file

str expand_home(str path) {
    if (path == "~" || path.starts_with("~/")) {
        match (os.env("HOME")) {
            case Some(str home): {
                return home + path.substr(1, path.size());
            }
            case None: {
                return path;
            }
        }
    }
    return path;
}

/// Where the keymap file is: $M3D1TOR_KEYMAP, else $XDG_CONFIG_HOME/m3d1tor/keymap.vim,
/// else ~/.config/m3d1tor/keymap.vim.
pub str keymap_path() {
    match (os.env("M3D1TOR_KEYMAP")) {
        case Some(str given): {
            return given;
        }
        case None: {
        }
    }
    match (os.env("XDG_CONFIG_HOME")) {
        case Some(str base): {
            if (base.size() > 0) {
                return base + "/m3d1tor/keymap.vim";
            }
        }
        case None: {
        }
    }
    match (os.env("HOME")) {
        case Some(str home): {
            return home + "/.config/m3d1tor/keymap.vim";
        }
        case None: {
            return "";
        }
    }
}

/// Split "name arg" into its two parts.
List<str> split_request(str request) {
    match (request.index_of(" ")) {
        case Some(int position): {
            return [request.substr(0, position), request.substr(position + 1, request.size())];
        }
        case None: {
            return [request, ""];
        }
    }
}

/// Open `path` (a new empty buffer when the file does not exist; an empty path
/// is a buffer with no name).
pub Result<App, str> open(str path) {
    return open_all([path]);
}

/// Open several files as buffers; the first is shown.
pub Result<App, str> open_all(List<str> paths) {
    App app = App(MED_editor.new(""), "");
    app.next_id = 1;
    bool is_first = true;
    for (str path in paths) {
        match (read_slot(app.next_id, path)) {
            case Ok(Slot slot): {
                if (is_first) {
                    app.slots.push(slot);
                    app.wins.push(MED_window.Win(1, slot.id));
                    app.current_id = slot.id;
                    app.editor = slot.editor;
                    app.path = path;
                    app.next_id = slot.id + 1;
                    app.notice = file_note(path, slot.editor);
                    is_first = false;
                } else {
                    slot.editor.view_height = app.editor.view_height;
                    app.slots.push(slot);
                    app.next_id = slot.id + 1;
                }
            }
            case Err(str message): {
                return Result<App, str>.Err(message);
            }
        }
    }
    if (is_first) {
        return Result<App, str>.Err("no buffer");
    }
    return Result<App, str>.Ok(app);
}

/// Where the last `/` of `text` is, or -1.
int last_slash(str text) {
    int spot = text.size() - 1;
    while (spot >= 0) {
        if (text.byte_at(spot) == 47) {
            return spot;
        }
        spot = spot - 1;
    }
    return -1;
}

/// The directory of a file path ("." when it has none).
str parent_directory(str file) {
    int spot = last_slash(file);
    if (spot < 0) {
        return ".";
    }
    if (spot == 0) {
        return "/";
    }
    return file.substr(0, spot);
}

/// The directory above `directory`.
str up_directory(str directory) {
    if (directory == ".") {
        return "..";
    }
    if (directory == ".." || directory.ends_with("/..") || directory == "/") {
        if (directory == "/") {
            return "/";
        }
        return directory + "/..";
    }
    return parent_directory(directory);
}

str child_path(str directory, str name) {
    if (directory == ".") {
        return name;
    }
    if (directory.ends_with("/")) {
        return directory + name;
    }
    return directory + "/" + name;
}

/// The lines of a file for the preview pane.
List<str> read_preview(str file) {
    if (!fs.is_file(file)) {
        return ["(not a file)"];
    }
    match (io.read(file)) {
        case Ok(str text): {
            if (text.size() > MED_grep.MAX_BYTES) {
                return ["(file too large to preview)"];
            }
            for (int spot in 0 .. 512) {
                if (spot < text.size() && text.byte_at(spot) == 0) {
                    return ["(binary file)"];
                }
            }
            List<str> lines = text.split("\n");
            if (lines.size() > PREVIEW_LINES) {
                return lines.slice(0, PREVIEW_LINES);
            }
            return lines;
        }
        case Err(io.Error error): {
            return ["(cannot read: " + error.to_str() + ")"];
        }
    }
}

/// Where `value` is in `items`, or -1.
int position_of(List<int> items, int value) {
    for (int position in 0 .. items.size()) {
        if (items[position] == value) {
            return position;
        }
    }
    return -1;
}

/// The rows of text for a window of `rows` rows.
pub int text_rows(int rows) {
    if (rows - FOOTER_ROWS < 1) {
        return 1;
    }
    return rows - FOOTER_ROWS;
}

/// The engine key for a terminal key code, or -1 when it has none.
int key_code(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return MED_key.CARRIAGE_RETURN;
        }
        case Tab: {
            return MED_key.TAB;
        }
        case BackTab: {
            return -1;
        }
        case Backspace: {
            return MED_key.BACKSPACE;
        }
        case Escape: {
            return MED_key.ESC;
        }
        case Up: {
            return MED_key.UP_KEY;
        }
        case Down: {
            return MED_key.DOWN;
        }
        case Right: {
            return MED_key.RIGHT;
        }
        case Left: {
            return MED_key.LEFT;
        }
        case Home: {
            return MED_key.HOME;
        }
        case End: {
            return MED_key.END;
        }
        case PageUp: {
            return MED_key.PAGE_UP;
        }
        case PageDown: {
            return MED_key.PAGE_DOWN;
        }
        case Insert: {
            return MED_key.INSERT;
        }
        case Delete: {
            return MED_key.DEL;
        }
        case F(int number): {
            if (number >= 1 && number <= 12) {
                return MED_key.FKEY_BASE + number;
            }
            return -1;
        }
    }
}

/// The code point of a character key, or -1 for any other key.
int char_of(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return -1;
        }
        case Tab: {
            return -1;
        }
        case BackTab: {
            return -1;
        }
        case Backspace: {
            return -1;
        }
        case Escape: {
            return -1;
        }
        case Up: {
            return -1;
        }
        case Down: {
            return -1;
        }
        case Right: {
            return -1;
        }
        case Left: {
            return -1;
        }
        case Home: {
            return -1;
        }
        case End: {
            return -1;
        }
        case PageUp: {
            return -1;
        }
        case PageDown: {
            return -1;
        }
        case Insert: {
            return -1;
        }
        case Delete: {
            return -1;
        }
        case F(int number): {
            return -1;
        }
    }
}

/// The control character of a letter or one of `@ [ \ ] ^ _`, or -1.
int control_of(int code_point) {
    if (code_point >= 97 && code_point <= 122) {
        return code_point - 96;
    }
    if (code_point >= 64 && code_point <= 95) {
        return code_point & 31;
    }
    return -1;
}

/// The engine keys for one terminal key press: Alt is an Escape first, Ctrl on
/// a character is its control code, Shift/Ctrl on a special key are modifier
/// bits.
pub List<int> keys_of_key(term.Key key) {
    List<int> keys = [];
    int code = key_code(key.code);
    if (code < 0) {
        return keys;
    }
    bool is_special = code >= MED_key.UP_KEY;
    int code_point = char_of(key.code);
    if (key.has_modifiers(term.CTRL) && code_point >= 0) {
        code = control_of(code_point);
        if (code < 0) {
            return keys;
        }
    }
    if (is_special) {
        if (key.has_modifiers(term.CTRL)) {
            code = code | MED_key.MOD_CTRL;
        }
        if (key.has_modifiers(term.SHIFT)) {
            code = code | MED_key.MOD_SHIFT;
        }
    }
    if (key.has_modifiers(term.ALT)) {
        keys.push(MED_key.ESC);
    }
    keys.push(code);
    return keys;
}

/// What a character shows as: a tab is blanks, a control character is `^X`.
str shown(str line, int col, int next, int width) {
    int code_point = MED_text.cp_at(line, col);
    if (code_point == 9) {
        return " ".repeat(width);
    }
    if (code_point >= 0 && code_point < 32) {
        return "^" + str.from_chars([code_point + 64]);
    }
    if (code_point == 127) {
        return "^?";
    }
    return line.substr(col, next);
}

/// The first line of a message.
str first_line(str text) {
    List<str> parts = text.split("\n");
    return parts[0];
}

bool is_error_text(str text) {
    if (text.size() < 2 || text.byte_at(0) != 69) {
        return false;
    }
    int second = text.byte_at(1);
    return second >= 48 && second <= 57;
}
