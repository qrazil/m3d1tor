// The Vim command layer: motions, operators, insert mode, Visual mode and
// dot-repeat on top of `MED_editor`. `feed(ed, key)` is the whole interface.
//
// API
// ---
//   MED_vim.feed(ed, key)           process one key in whatever mode `ed` is in
//   MED_vim.feed_keys(ed, keys)     many keys, in order
//
// Behaviour is checked against nvim (`tests/oracles/`): each command below
// follows the corresponding Vim source routine named in its comment.

import MED_buffer;
import MED_editor;
import MED_motion;
import MED_num;
import MED_parse;
import MED_register;
import MED_text;
import MED_textobj;
import MED_key;
import MED_case;
import MED_view;
import MED_search;
import MED_nrfmt;

void fail(MED_editor.Editor editor) {
    editor.is_failed = true;
}

int count1(int count) {
    if (count < 1) {
        return 1;
    }
    return count;
}

MED_motion.Motion motion_at(MED_editor.Editor editor) {
    MED_motion.Motion motion = MED_motion.Motion();
    motion.row = editor.row;
    motion.col = editor.col;
    return motion;
}

bool is_visual(MED_editor.Editor editor) {
    return editor.mode == MED_editor.VISUAL;
}

// The column of the cursor line that `want` selects.
pub int col_by_want(MED_editor.Editor editor, int row, int want) {
    return MED_motion.col_for_want(editor.buffer.line(row), want, editor.tab, is_visual(editor));
}

// Vim's `beginline(BL_WHITE | BL_FIX)`: the first non-blank, but never the NUL.
pub int first_nonblank_fix(str line) {
    int col = MED_text.first_nonblank(line);
    if (col >= line.size() && line.size() > 0) {
        return MED_text.last_col(line);
    }
    return col;
}

MED_motion.Motion move_left(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    bool is_wrap = key == 127 || key == 8;
    bool is_moved = false;
    int total = count1(count);
    while (total > 0) {
        if (motion.col > 0) {
            motion.col = MED_text.previous_col(editor.buffer.line(motion.row), motion.col);
            is_moved = true;
        } else if (is_wrap && motion.row > 0) {
            motion.row = motion.row - 1;
            str line = editor.buffer.line(motion.row);
            motion.col = MED_motion.col_for_want(line, -1, editor.tab, is_visual(editor));
            is_moved = true;
            if ((operator == "d" || operator == "c") && line.size() > 0) {
                if (motion.col < line.size()) {
                    motion.col = MED_text.next_col(line, motion.col);
                }
                motion.is_no_adj = true;
            }
        } else {
            if (operator == "" && !is_moved) {
                motion.is_ok = false;
            }
            break;
        }
        total = total - 1;
    }
    return motion;
}

MED_motion.Motion move_right(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    bool is_wrap = key == 32;
    bool is_visual_value = is_visual(editor);
    bool is_moved = false;
    int total = count1(count);
    while (total > 0) {
        str line = editor.buffer.line(motion.row);
        bool is_stuck = false;
        if (is_visual_value) {
            is_stuck = motion.col >= line.size();
        } else {
            is_stuck = motion.col >= line.size() || MED_text.next_col(line, motion.col) >= line.size();
        }
        if (is_stuck) {
            if (is_wrap && motion.row + 1 < editor.buffer.line_count()) {
                if (operator != "" && !motion.is_inclusive && line.size() > 0) {
                    motion.is_inclusive = true;
                } else {
                    motion.row = motion.row + 1;
                    motion.col = 0;
                    motion.is_inclusive = false;
                }
                is_moved = true;
                total = total - 1;
                continue;
            }
            if (operator == "") {
                if (!is_moved) {
                    motion.is_ok = false;
                }
            } else if (line.size() > 0) {
                motion.is_inclusive = true;
            }
            break;
        }
        motion.col = MED_text.next_col(line, motion.col);
        is_moved = true;
        total = total - 1;
    }
    return motion;
}

MED_motion.Motion move_vertical(MED_editor.Editor editor, int delta) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_linewise = true;
    motion.want = -3;
    int last = editor.buffer.line_count() - 1;
    if (delta > 0) {
        if (editor.row >= last) {
            motion.is_ok = false;
            return motion;
        }
        motion.row = MED_num.smaller(editor.row + delta, last);
    } else {
        if (editor.row <= 0) {
            motion.is_ok = false;
            return motion;
        }
        motion.row = MED_num.larger(editor.row + delta, 0);
    }
    motion.col = col_by_want(editor, motion.row, editor.want);
    return motion;
}

// Cursor on the NUL after a word motion moves back onto the last character.
void adjust_cursor(MED_editor.Editor editor, MED_motion.Motion motion) {
    str line = editor.buffer.line(motion.row);
    if (motion.col > 0 && motion.col >= line.size() && !is_visual(editor)) {
        motion.col = MED_text.last_col(line);
        motion.is_inclusive = true;
    }
}

MED_motion.Motion word_motion(MED_editor.Editor editor, int key, int count, str operator) {
    MED_motion.Motion motion = motion_at(editor);
    MED_motion.Cur cursor = MED_motion.Cur(editor.buffer, editor.row, editor.col);
    bool is_big = key == 87 || key == 66 || key == 69;
    bool is_ok = true;
    if (key == 119 || key == 87) {
        bool is_word_end = false;
        bool is_flag = false;
        if (operator == "c") {
            str line = editor.buffer.line(editor.row);
            if (editor.col < line.size()) {
                int code_point = MED_text.cp_at(line, editor.col);
                if (code_point != 32 && code_point != 9) {
                    motion.is_inclusive = true;
                    is_word_end = true;
                    is_flag = true;
                }
            }
        }
        if (is_word_end) {
            is_ok = MED_motion.did_end_word(cursor, count1(count), is_big, is_flag, false);
        } else {
            is_ok = MED_motion.did_fwd_word(cursor, count1(count), is_big, operator != "");
        }
    } else if (key == 98 || key == 66) {
        is_ok = MED_motion.did_bck_word(cursor, count1(count), is_big, false);
    } else {
        is_ok = MED_motion.did_end_word(cursor, count1(count), is_big, false, false);
        motion.is_inclusive = true;
    }
    motion.row = cursor.row;
    motion.col = cursor.col;
    if (editor.row < cursor.row || (editor.row == cursor.row && editor.col < cursor.col)) {
        adjust_cursor(editor, motion);
    }
    if (!is_ok && operator == "") {
        motion.is_beep = true;
    } else if (!is_ok && (key == 98 || key == 66)) {
        // `b` always cancels the operator when it cannot go all the way
        motion.is_ok = false;
        motion.is_moved = true;
    }
    return motion;
}

// Vim's nv_lineop: where the cursor lands on the last line of `_`, `dd`, `yy`...
int lineop_col(MED_editor.Editor editor, str operator, int row, bool is_moved) {
    if (operator == "d" || operator == "<" || operator == ">") {
        return col_by_want(editor, row, editor.want);
    }
    if (operator == "y") {
        if (is_moved) {
            return col_by_want(editor, row, editor.want);
        }
        return editor.col;
    }
    return first_nonblank_fix(editor.buffer.line(row));
}

// Place `motion` on a line number given as a 1-based count or the default.
MED_motion.Motion goto_line(MED_editor.Editor editor, int count, int default_row) {
    MED_motion.Motion motion = MED_motion.Motion();
    int row = default_row;
    if (count != 0) {
        row = count - 1;
    }
    row = MED_num.clamp(row, 0, editor.buffer.line_count() - 1);
    motion.row = row;
    motion.is_linewise = true;
    motion.is_jump = true;
    motion.want = -3;
    if (editor.is_startofline) {
        motion.col = first_nonblank_fix(editor.buffer.line(row));
        motion.want = -2;
    } else {
        motion.col = col_by_want(editor, row, editor.want);
    }
    return motion;
}

// H, M and L: a line of the window.
MED_motion.Motion view_motion(MED_editor.Editor editor, int key, int count) {
    int last = MED_num.smaller(editor.buffer.line_count(), editor.view_top + editor.view_height) - 1;
    int row = editor.view_top;
    if (key == 72) {
        row = editor.view_top + count1(count) - 1;
        row = MED_num.smaller(row, last);
    } else if (key == 76) {
        row = MED_num.larger(last - (count1(count) - 1), editor.view_top);
    } else {
        row = editor.view_top + (last - editor.view_top) / 2;
    }
    return goto_line(editor, row + 1, 0);
}

MED_motion.Motion char_find(MED_editor.Editor editor, int key, int target, int count, bool is_repeat, bool is_reverse) {
    int directory = 1;
    bool is_until = false;
    int goal = target;
    bool is_stop = true;
    if (is_repeat) {
        if (editor.find.target < 0) {
            return MED_motion.failed();
        }
        goal = editor.find.target;
        directory = editor.find.directory;
        if (is_reverse) {
            directory = -directory;
        }
        is_until = editor.find.is_until;
        if (count1(count) == 1 && is_until) {
            is_stop = false;
        }
    } else {
        if (key == 70 || key == 84) {
            directory = -1;
        }
        is_until = key == 116 || key == 84;
        editor.find.target = target;
        editor.find.directory = directory;
        editor.find.is_until = is_until;
    }
    MED_motion.Motion motion = MED_motion.find_char(editor.buffer.line(editor.row), editor.col, goal, directory, is_until, count1(count), is_stop);
    motion.row = editor.row;
    return motion;
}

MED_motion.Motion line_end(MED_editor.Editor editor, int count) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_inclusive = true;
    motion.want = -1;
    int total = count1(count) - 1;
    if (total > 0) {
        if (editor.row >= editor.buffer.line_count() - 1) {
            // Vim sets the wanted column before it finds it cannot go down
            editor.want = -1;
            motion.is_ok = false;
            return motion;
        }
        motion.row = MED_num.smaller(editor.row + total, editor.buffer.line_count() - 1);
    }
    motion.col = MED_motion.col_for_want(editor.buffer.line(motion.row), -1, editor.tab, is_visual(editor));
    return motion;
}

// A finished search as a motion.
MED_motion.Motion search_result(MED_editor.Editor editor, MED_search.Outcome outcome) {
    if (!outcome.is_ok) {
        editor.message = outcome.error;
        // a search, failed or not, makes the wanted column follow the cursor
        editor.want_from_cursor();
        return MED_motion.failed();
    }
    MED_motion.Motion motion = motion_at(editor);
    motion.row = outcome.row;
    motion.col = outcome.col;
    motion.is_jump = true;
    motion.is_inclusive = outcome.is_inclusive;
    int size = editor.buffer.line_size(motion.row);
    if (motion.col > 0 && motion.col >= size) {
        // `/$` lands after the last character: check_cursor() pulls it back
        motion.col = MED_text.last_col(editor.buffer.line(motion.row));
    }
    motion.is_linewise = outcome.kind == 2;
    return motion;
}

// The position of mark `name`, if it is set.
pub Option<MED_buffer.Pos> mark_position(MED_editor.Editor editor, int name) {
    str key = str.from_chars([name]);
    if (name == 96) {
        key = "'";
    }
    Option<MED_buffer.Pos> found = editor.marks.get(key);
    match (found) {
        case Some(MED_buffer.Pos position): {
            if (position.row >= editor.buffer.line_count() || position.row < 0) {
                return Option<MED_buffer.Pos>.None;
            }
            return found;
        }
        case None: {
            if (key == "'") {
                return Option<MED_buffer.Pos>.Some(MED_buffer.Pos(0, 0));
            }
            return found;
        }
    }
}

// `'x` `` `x `` g'x g`x
MED_motion.Motion mark_motion(MED_editor.Editor editor, int cmd, int name, bool is_linewise, bool is_jumps) {
    Option<MED_buffer.Pos> found = mark_position(editor, name);
    match (found) {
        case Some(MED_buffer.Pos position): {
            MED_motion.Motion motion = motion_at(editor);
            motion.row = position.row;
            motion.col = position.col;
            motion.is_jump = is_jumps;
            if (is_linewise) {
                motion.is_linewise = true;
                motion.col = first_nonblank_fix(editor.buffer.line(position.row));
            } else if (motion.col > editor.buffer.line_size(position.row)) {
                motion.col = editor.buffer.line_size(position.row);
            }
            return motion;
        }
        case None: {
            editor.message = "E20: Mark not set";
            return MED_motion.failed();
        }
    }
}

// `%`: the matching bracket, or with a count that percent of the file.
MED_motion.Motion percent_motion(MED_editor.Editor editor, int count) {
    MED_motion.Motion motion = motion_at(editor);
    motion.is_inclusive = true;
    motion.is_jump = true;
    if (count > 0) {
        if (count > 100) {
            return MED_motion.failed();
        }
        motion.is_linewise = true;
        int total = editor.buffer.line_count();
        int lnum = (total * count + 99) / 100;
        if (lnum < 1) {
            lnum = 1;
        }
        if (lnum > total) {
            lnum = total;
        }
        motion.row = lnum - 1;
        motion.col = first_nonblank_fix(editor.buffer.line(motion.row));
        motion.is_inclusive = false;
        return motion;
    }
    MED_buffer.Pos position = MED_search.findmatch(editor.buffer, editor.row, editor.col, 0, 0);
    if (position.row < 0) {
        return MED_motion.failed();
    }
    motion.row = position.row;
    motion.col = position.col;
    return motion;
}

// `[(` `[{` `])` `]}`
MED_motion.Motion bracket_motion(MED_editor.Editor editor, int first, int second, int count) {
    MED_motion.Motion motion = motion_at(editor);
    int directory = 1;
    if (first == 91) {
        directory = -1;
    }
    int row = editor.row;
    int col = editor.col;
    bool is_any = false;
    for (int i in 0 .. count1(count)) {
        MED_buffer.Pos position = MED_search.findmatch(editor.buffer, row, col, second, directory);
        if (position.row < 0) {
            break;
        }
        row = position.row;
        col = position.col;
        is_any = true;
    }
    if (!is_any) {
        return MED_motion.failed();
    }
    motion.row = row;
    motion.col = col;
    motion.is_jump = true;
    return motion;
}

// `[[` `]]` `[]` `][`: the previous / next line that starts with `{` or `}`.
MED_motion.Motion section_motion(MED_editor.Editor editor, int first, int second, int count) {
    int directory = 1;
    if (first == 91) {
        directory = -1;
    }
    int what = 123;
    if (first != second) {
        what = 125;
    }
    int curr = editor.row;
    int left = count1(count);
    while (left > 0) {
        left = left - 1;
        bool did_skip = false;
        bool is_at_first = true;
        while (true) {
            str line = editor.buffer.line(curr);
            if (line.size() != 0) {
                did_skip = true;
            }
            if (!is_at_first && did_skip && line.size() > 0 && (line.byte_at(0) == what || line.byte_at(0) == 12)) {
                break;
            }
            curr = curr + directory;
            if (curr < 0 || curr >= editor.buffer.line_count()) {
                if (left > 0) {
                    return MED_motion.failed();
                }
                curr = curr - directory;
                break;
            }
            is_at_first = false;
        }
    }
    MED_motion.Motion motion = motion_at(editor);
    motion.row = curr;
    motion.col = 0;
    motion.is_jump = true;
    if (curr == editor.buffer.line_count() - 1 && what != 125 && directory > 0) {
        str line = editor.buffer.line(curr);
        if (line.size() != 0) {
            motion.col = MED_text.last_col(line);
            motion.is_inclusive = true;
        }
    }
    return motion;
}

// `n` and `N`.
MED_motion.Motion next_match(MED_editor.Editor editor, bool is_reverse, int count) {
    MED_search.Outcome outcome = MED_search.search_command(editor, 0, "", count1(count), is_reverse, false);
    if (outcome.is_ok && !outcome.is_wrapped && outcome.row == editor.row && outcome.col == editor.col) {
        // stuck on the cursor (an offset on the buffer's last character): once more
        outcome = MED_search.search_command(editor, 0, "", count1(count) + 1, is_reverse, false);
    }
    return search_result(editor, outcome);
}

/// Execute the motion `keys` from the cursor. `operator` is the pending operator
/// name ("" for none). The result says where it lands and how an operator
/// should treat the range.
pub MED_motion.Motion run_motion(MED_editor.Editor editor, List<int> keys, int count, str operator) {
    MED_motion.Motion motion = run_motion_raw(editor, keys, count, operator);
    if (!motion.is_ok && did_sets_curswant(keys)) {
        // these motions ask for the wanted column to follow the cursor even
        // when they fail (Vim's w_set_curswant)
        editor.want_from_cursor();
    }
    return motion;
}

bool did_sets_curswant(List<int> keys) {
    int key = keys[0];
    if (key == 119 || key == 87 || key == 98 || key == 66 || key == 101 || key == 69) {
        return true;
    }
    if (key == 40 || key == 41 || key == 123 || key == 125) {
        return true;
    }
    return key == 103 && keys.size() > 1 && (keys[1] == 101 || keys[1] == 69);
}

MED_motion.Motion run_motion_raw(MED_editor.Editor editor, List<int> keys, int count, str operator) {
    int key = keys[0];
    MED_motion.Motion motion = motion_at(editor);
    if (key == 104 || key == 8 || key == 127 || key == 63234) {
        return move_left(editor, key, count, operator);
    }
    if (key == 108 || key == 32 || key == 63235) {
        return move_right(editor, key, count, operator);
    }
    if (key == 106 || key == 10 || key == 14 || key == 63233) {
        return move_vertical(editor, count1(count));
    }
    if (key == 107 || key == 16 || key == 63232) {
        return move_vertical(editor, 0 - count1(count));
    }
    if (key == 43 || key == 13) {
        MED_motion.Motion motion_value = move_vertical(editor, count1(count));
        if (motion_value.is_ok) {
            motion_value.col = first_nonblank_fix(editor.buffer.line(motion_value.row));
            motion_value.want = -2;
        }
        return motion_value;
    }
    if (key == 45) {
        MED_motion.Motion motion_value = move_vertical(editor, 0 - count1(count));
        if (motion_value.is_ok) {
            motion_value.col = first_nonblank_fix(editor.buffer.line(motion_value.row));
            motion_value.want = -2;
        }
        return motion_value;
    }
    if (key == 95) {
        MED_motion.Motion motion_value = motion_at(editor);
        motion_value.is_linewise = true;
        int amount = count1(count) - 1;
        if (amount > 0) {
            if (editor.row >= editor.buffer.line_count() - 1) {
                motion_value.is_ok = false;
                return motion_value;
            }
            motion_value.row = MED_num.smaller(editor.row + amount, editor.buffer.line_count() - 1);
        }
        motion_value.col = lineop_col(editor, operator, motion_value.row, amount > 0);
        return motion_value;
    }
    if (key == 48 || key == 63236) {
        motion.col = 0;
        return motion;
    }
    if (key == 94) {
        motion.col = first_nonblank_fix(editor.buffer.line(editor.row));
        return motion;
    }
    if (key == 36 || key == 63237) {
        return line_end(editor, count);
    }
    if (key == 124) {
        motion.col = col_by_want(editor, editor.row, count1(count) - 1);
        motion.want = count1(count) - 1;
        return motion;
    }
    if (key == 119 || key == 87 || key == 98 || key == 66 || key == 101 || key == 69) {
        return word_motion(editor, key, count, operator);
    }
    if (key == 71) {
        return goto_line(editor, count, editor.buffer.line_count() - 1);
    }
    if (key == 72 || key == 77 || key == 76) {
        return view_motion(editor, key, count);
    }
    if (key == 123 || key == 125) {
        int directory = 1;
        if (key == 123) {
            directory = -1;
        }
        MED_motion.Motion motion_item = MED_motion.paragraph(editor.buffer, editor.row, directory, count1(count));
        return motion_item;
    }
    if (key == 40 || key == 41) {
        int sdir = 1;
        if (key == 40) {
            sdir = -1;
        }
        MED_motion.Cur cursor = MED_motion.Cur(editor.buffer, editor.row, editor.col);
        if (!MED_motion.did_findsent(cursor, sdir, count1(count))) {
            return MED_motion.failed();
        }
        motion.row = cursor.row;
        motion.col = cursor.col;
        motion.is_jump = true;
        if (cursor.col > 0 && cursor.char_code() == 0) {
            motion.col = MED_text.previous_col(editor.buffer.line(cursor.row), cursor.col);
            motion.is_inclusive = true;
        }
        return motion;
    }
    if (key == 102 || key == 70 || key == 116 || key == 84) {
        return char_find(editor, key, keys[1], count, false, false);
    }
    if (key == 59) {
        return char_find(editor, key, 0, count, true, false);
    }
    if (key == 44) {
        return char_find(editor, key, 0, count, true, true);
    }
    if (key == 47 || key == 63) {
        return search_result(editor, MED_search.search_command(editor, key, editor.search_typed, count1(count), false, true));
    }
    if (key == 110 || key == 78) {
        return next_match(editor, key == 78, count);
    }
    if (key == 42 || key == 35) {
        return search_result(editor, MED_search.star(editor, key, true, count1(count)));
    }
    if (key == 37) {
        return percent_motion(editor, count);
    }
    if (key == 39 || key == 96) {
        return mark_motion(editor, key, keys[1], key == 39, true);
    }
    if (key == 91 || key == 93) {
        int second = keys[1];
        if (second == 91 || second == 93) {
            return section_motion(editor, key, second, count);
        }
        return bracket_motion(editor, key, second, count);
    }
    if (key == 103) {
        int second = keys[1];
        if (second == 103) {
            return goto_line(editor, count, 0);
        }
        if (second == 42 || second == 35) {
            return search_result(editor, MED_search.star(editor, second, false, count1(count)));
        }
        if (second == 39 || second == 96) {
            return mark_motion(editor, second, keys[2], second == 39, false);
        }
        if (second == 101 || second == 69) {
            MED_motion.Cur cursor_value = MED_motion.Cur(editor.buffer, editor.row, editor.col);
            bool is_ok = MED_motion.did_bckend_word(cursor_value, count1(count), second == 69, false);
            motion.row = cursor_value.row;
            motion.col = cursor_value.col;
            motion.is_inclusive = true;
            if (!is_ok) {
                if (operator == "") {
                    motion.is_beep = true;
                } else {
                    motion.is_ok = false;
                    motion.is_moved = true;
                }
            }
            return motion;
        }
        if (second == 95) {
            MED_motion.Motion motion_other = line_end(editor, count);
            if (!motion_other.is_ok) {
                return motion_other;
            }
            str line = editor.buffer.line(motion_other.row);
            int col = motion_other.col;
            if (col > 0 && col >= line.size()) {
                col = MED_text.last_col(line);
            }
            while (col > 0 && (line.byte_at(col) == 32 || line.byte_at(col) == 9)) {
                col = MED_text.previous_col(line, col);
            }
            motion_other.col = col;
            motion_other.want = -2;
            return motion_other;
        }
        if (second == 106 || second == 107) {
            // a screen-line move: charwise (lines here never wrap)
            int delta = count1(count);
            if (second == 107) {
                delta = 0 - delta;
            }
            MED_motion.Motion motion_value = move_vertical(editor, delta);
            motion_value.is_linewise = false;
            return motion_value;
        }
        if (second == 48 || second == 94 || second == 36) {
            List<int> single = [second];
            return run_motion(editor, single, 0, operator);
        }
        if (second == 109 || second == 77) {
            // gm: half a screen (80 columns) in; gM: `count` percent of the line's width
            str line = editor.buffer.line(editor.row);
            int target = 40;
            if (second == 77) {
                int total = MED_text.line_width(line, editor.tab);
                if (count > 0 && count <= 100) {
                    target = total * count / 100;
                } else {
                    target = total / 2;
                }
            }
            motion.col = MED_text.col_at_display(line, target, editor.tab);
            motion.want = -2;
            return motion;
        }
        if (second == 111) {
            // go: byte `count` (1-based) of the buffer, newlines counting one
            int left = count1(count) - 1;
            int row = 0;
            while (row < editor.buffer.line_count() - 1 && left > editor.buffer.line_size(row)) {
                left = left - editor.buffer.line_size(row) - 1;
                row = row + 1;
            }
            int col = left;
            int size = editor.buffer.line_size(row);
            if (col > size) {
                col = size;
            }
            if (col > 0 && col >= size) {
                col = MED_text.last_col(editor.buffer.line(row));
            } else if (col > 0) {
                col = MED_text.snap(editor.buffer.line(row), col);
            }
            motion.row = row;
            motion.col = col;
            motion.is_jump = true;
            return motion;
        }
        return MED_motion.failed();
    }
    return MED_motion.failed();
}

// ---------------------------------------------------------------- operators

/// An operator's target: what do_pending_operator hands to op_delete & co.
type Oap {
    str operator = "";
    str reg = "";
    MED_buffer.Pos start = MED_buffer.Pos(0, 0);
    MED_buffer.Pos end = MED_buffer.Pos(0, 0);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_empty = false;
    bool is_reg_one = false;
    int line_count = 1;
    bool is_visual = false;
    int amount = 1;
    int force = 0;
    bool is_object = false;
    bool is_block = false;
    int left_vcol = 0;
    int right_vcol = 0;
    bool is_eol = false;
    int rlines = 1;
    int rvcol = 0;
}

MED_buffer.Pos copy_position(MED_buffer.Pos position) {
    return MED_buffer.Pos(position.row, position.col);
}

// Where the operated text ends (exclusive) for a charwise range.
MED_buffer.Pos exclusive_end(MED_editor.Editor editor, Oap oap) {
    MED_buffer.Pos position = copy_position(oap.end);
    if (oap.is_inclusive) {
        str line = editor.buffer.line(position.row);
        if (position.col < line.size()) {
            position.col = MED_text.next_col(line, position.col);
        }
    }
    return position;
}

// A no-op edit so the undo block exists (Vim's u_save_cursor on an empty region).
void touch(MED_editor.Editor editor) {
    if (editor.buffer.is_empty) {
        return;
    }
    MED_buffer.Pos position = MED_buffer.Pos(editor.row, editor.col);
    editor.change(position, position, "");
}

// The '[ and '] marks.
void set_op_marks(MED_editor.Editor editor, MED_buffer.Pos position, MED_buffer.Pos position_value) {
    editor.marks.set("[", copy_position(position));
    editor.marks.set("]", copy_position(position_value));
}

// Vim's dec(): one character back, wrapping to the end of the previous line.
MED_buffer.Pos dec_position(MED_editor.Editor editor, MED_buffer.Pos position) {
    if (position.col > 0) {
        return MED_buffer.Pos(position.row, MED_text.previous_col(editor.buffer.line(position.row), MED_num.smaller(position.col, editor.buffer.line_size(position.row))));
    }
    if (position.row > 0) {
        return MED_buffer.Pos(position.row - 1, editor.buffer.line_size(position.row - 1));
    }
    return copy_position(position);
}

// The register content for the range.
MED_register.Reg range_reg(MED_editor.Editor editor, Oap oap) {
    if (oap.is_linewise) {
        List<str> lines = [];
        for (int row in oap.start.row .. oap.end.row + 1) {
            lines.push(editor.buffer.line(row));
        }
        return MED_register.Reg(lines, MED_register.LINE);
    }
    str text = editor.buffer.text(oap.start, exclusive_end(editor, oap));
    return MED_register.Reg(text.split("\n"), MED_register.CHAR);
}

bool is_in_indent(str line, int col) {
    int index = 0;
    while (index < col && index < line.size()) {
        int right = line.byte_at(index);
        if (right != 32 && right != 9) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// Delete `rows` whole lines starting at `first`, leaving at least one line.
void delete_lines(MED_editor.Editor editor, int first, int last) {
    int count = editor.buffer.line_count();
    if (first == 0 && last == count - 1) {
        editor.change(MED_buffer.Pos(0, 0), MED_buffer.Pos(last, editor.buffer.line_size(last)), "");
        editor.buffer.is_empty = true;
    } else if (last == count - 1) {
        editor.change(MED_buffer.Pos(first - 1, editor.buffer.line_size(first - 1)), MED_buffer.Pos(last, editor.buffer.line_size(last)), "");
    } else {
        editor.change(MED_buffer.Pos(first, 0), MED_buffer.Pos(last + 1, 0), "");
    }
    // deleting lines forgets the line "U" would restore
    editor.uline_row = -1;
}

// Vim's op_yank: the register write for a yank.
void op_yank(MED_editor.Editor editor, Oap oap) {
    editor.regs.yank(oap.reg, range_reg(editor, oap));
    if (oap.is_linewise) {
        set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, MAXCOL));
    } else if (oap.is_inclusive || oap.is_block) {
        set_op_marks(editor, oap.start, oap.end);
    } else {
        set_op_marks(editor, oap.start, dec_position(editor, oap.end));
    }
}

// Vim's op_delete (also the first half of op_change). Returns false if the
// operation did not happen.
bool did_op_delete(MED_editor.Editor editor, Oap oap) {
    MED_buffer.Buffer buffer = editor.buffer;
    if (buffer.is_empty && oap.is_linewise) {
        return true;
    }
    if (oap.is_empty) {
        touch(editor);
        return true;
    }
    bool is_delete = oap.operator == "d";
    bool is_converted = false;
    if (!oap.is_linewise && !oap.is_visual && oap.line_count > 1 && oap.force == 0 && is_delete) {
        str end_line = buffer.line(oap.end.row);
        int at_end = oap.end.col;
        if (at_end < end_line.size() && oap.is_inclusive) {
            at_end = MED_text.next_col(end_line, at_end);
        }
        int rest = at_end;
        while (rest < end_line.size() && (end_line.byte_at(rest) == 32 || end_line.byte_at(rest) == 9)) {
            rest = rest + 1;
        }
        if (rest >= end_line.size() && is_in_indent(buffer.line(oap.start.row), oap.start.col)) {
            oap.is_linewise = true;
            is_converted = true;
        }
    }
    if (!oap.is_linewise && oap.line_count == 1 && is_delete && buffer.line_size(oap.start.row) == 0) {
        return true;
    }
    MED_register.Reg reg = range_reg(editor, oap);
    bool is_shift = oap.is_linewise || oap.line_count > 1 || oap.is_reg_one;
    bool is_small = !oap.is_linewise && oap.line_count == 1;
    editor.regs.delete(oap.reg, reg, is_shift, is_small);
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise) {
        if (oap.operator == "c") {
            if (oap.end.row > oap.start.row) {
                delete_lines(editor, oap.start.row + 1, oap.end.row);
            }
            str line = buffer.line(oap.start.row);
            int keep = 0;
            if (editor.is_autoindent) {
                keep = MED_text.first_nonblank(line);
                editor.did_ai = true;
            }
            editor.change(MED_buffer.Pos(oap.start.row, keep), MED_buffer.Pos(oap.start.row, line.size()), "");
            editor.row = oap.start.row;
            editor.col = keep;
            if (oap.end.row > oap.start.row) {
                // after the lines went, Vim's "U" line is the emptied one
                editor.uline_row = oap.start.row;
                editor.uline_text = buffer.line(oap.start.row);
                editor.uline_col = keep;
            }
        } else {
            delete_lines(editor, oap.start.row, oap.end.row);
            editor.row = MED_num.smaller(oap.start.row, buffer.line_count() - 1);
            if (is_converted) {
                editor.col = MED_num.smaller(oap.start.col, MED_text.last_col(buffer.line(editor.row)));
            } else {
                editor.col = col_by_want(editor, editor.row, editor.want);
            }
        }
    } else {
        MED_buffer.Pos position = exclusive_end(editor, oap);
        editor.change(oap.start, position, "");
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        if (oap.operator != "c") {
            str line = buffer.line(editor.row);
            if (editor.col > 0 && editor.col >= line.size()) {
                editor.col = MED_text.last_col(line);
            }
        }
    }
    set_op_marks(editor, oap.start, oap.start);
    return true;
}

// The indent (screen columns) of a line and its length in bytes.
pub int indent_width(MED_editor.Editor editor, str line) {
    int spot = 0;
    int index = 0;
    while (index < line.size()) {
        int right = line.byte_at(index);
        if (right == 32) {
            spot = spot + 1;
        } else if (right == 9) {
            spot = spot + editor.tab - (spot % editor.tab);
        } else {
            break;
        }
        index = index + 1;
    }
    return spot;
}

// Replace a line's indent by one of `width` columns (tabs first unless 'expandtab').
pub str with_indent(MED_editor.Editor editor, str line, int width) {
    int skip = MED_text.first_nonblank(line);
    str rest = line.substr(skip, line.size());
    if (editor.is_expandtab) {
        return " ".repeat(width) + rest;
    }
    return "\t".repeat(width / editor.tab) + " ".repeat(width % editor.tab) + rest;
}

// Vim's op_shift for `>` and `<` over whole lines.
void op_shift(MED_editor.Editor editor, Oap oap) {
    touch(editor);
    bool is_saved_off = editor.is_uline_off;
    if (oap.end.row > oap.start.row) {
        editor.is_uline_off = true;
    }
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        if (line.size() == 0) {
            continue;
        }
        int width = indent_width(editor, line);
        int delta = editor.shiftwidth * oap.amount;
        if (oap.operator == ">") {
            width = width + delta;
        } else {
            width = MED_num.larger(width - delta, 0);
        }
        str replaced = with_indent(editor, line, width);
        if (replaced != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), replaced);
        }
    }
    editor.is_uline_off = is_saved_off;
    int end_length = editor.buffer.line_size(oap.end.row);
    if (end_length > 0) {
        end_length = end_length - 1;
    }
    set_op_marks(editor, oap.start, MED_buffer.Pos(oap.end.row, end_length));
    // beginline(BL_SOL | BL_FIX) with 'nostartofline': back to the wanted column
    editor.row = oap.start.row;
    editor.col = col_by_want(editor, editor.row, editor.want);
}

int rot13(int code_point) {
    if (code_point >= 97 && code_point <= 122) {
        return 97 + (code_point - 97 + 13) % 26;
    }
    if (code_point >= 65 && code_point <= 90) {
        return 65 + (code_point - 65 + 13) % 26;
    }
    return code_point;
}

str map_case(str text, str operator) {
    List<int> out = [];
    for (int code_point in text.chars()) {
        int mapped = code_point;
        if (operator == "g?") {
            mapped = rot13(code_point);
        } else if (code_point < 128) {
            bool is_lower = code_point >= 97 && code_point <= 122;
            bool is_upper = code_point >= 65 && code_point <= 90;
            if (operator == "gU" || (operator == "g~" && is_lower)) {
                if (is_lower) {
                    mapped = code_point - 32;
                }
            } else if (operator == "gu" || (operator == "g~" && is_upper)) {
                if (is_upper) {
                    mapped = code_point + 32;
                }
            }
        } else {
            str one = str.from_chars([code_point]);
            str upward = MED_case.upper(one);
            str low = MED_case.lower(one);
            if (operator == "gU") {
                mapped = upward.chars()[0];
            } else if (operator == "gu") {
                mapped = low.chars()[0];
            } else if (operator == "g~") {
                if (upward != one) {
                    mapped = upward.chars()[0];
                } else {
                    mapped = low.chars()[0];
                }
            }
        }
        out.push(mapped);
    }
    return str.from_chars(out);
}

// Vim's op_tilde: g~ gu gU g? over a range.
void op_case(MED_editor.Editor editor, Oap oap) {
    touch(editor);
    MED_buffer.Pos from = copy_position(oap.start);
    MED_buffer.Pos position = exclusive_end(editor, oap);
    if (!oap.is_linewise && !oap.is_inclusive && oap.start.row == oap.end.row && oap.start.col == oap.end.col) {
        // Vim's op_tilde steps the end back one position first: at the very
        // start of the buffer that leaves one character, at column 0 of a later
        // line it ends on the previous line and the whole start line changes,
        // anywhere else nothing.
        str here = editor.buffer.line(from.row);
        if (from.row == 0 && from.col == 0) {
            if (here.size() > 0) {
                position = MED_buffer.Pos(from.row, MED_text.next_col(here, 0));
            }
        } else if (from.col == 0) {
            position = MED_buffer.Pos(from.row, here.size());
        }
    }
    if (oap.is_linewise) {
        from = MED_buffer.Pos(oap.start.row, 0);
        position = MED_buffer.Pos(oap.end.row, editor.buffer.line_size(oap.end.row));
    }
    str text = editor.buffer.text(from, position);
    str mapped = map_case(text, oap.operator);
    if (mapped != text) {
        editor.change(from, position, mapped);
    }
    if (oap.is_linewise) {
        int end_length = editor.buffer.line_size(oap.end.row);
        if (end_length > 0) {
            end_length = end_length - 1;
        }
        set_op_marks(editor, MED_buffer.Pos(oap.start.row, 0), MED_buffer.Pos(oap.end.row, end_length));
    } else if (oap.is_inclusive) {
        set_op_marks(editor, oap.start, oap.end);
    } else {
        set_op_marks(editor, oap.start, dec_position(editor, oap.end));
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise && !oap.is_visual) {
        editor.col = oap.start.col;
    }
}

// Vim's do_join: join `count` lines starting at `row`.
pub bool did_do_join(MED_editor.Editor editor, int row, int count, bool is_insert_space) {
    if (row + count > editor.buffer.line_count()) {
        return false;
    }
    str acc = editor.buffer.line(row);
    int sum_col = 0;
    int join_col = 0;
    List<int> mark_shift = [];
    List<int> mark_removed = [];
    for (int target in 1 .. count) {
        str curr = editor.buffer.line(row + target);
        int spaces = 0;
        int removed_ws = 0;
        if (is_insert_space) {
            int skip = 0;
            while (skip < curr.size() && (curr.byte_at(skip) == 32 || curr.byte_at(skip) == 9)) {
                skip = skip + 1;
            }
            removed_ws = skip;
            curr = curr.substr(skip, curr.size());
            if (curr.size() > 0 && curr.byte_at(0) != 41 && acc.size() > 0) {
                int last = acc.byte_at(acc.size() - 1);
                if (last != 9) {
                    if (last != 32) {
                        spaces = 1;
                        if (editor.is_joinspaces && (last == 46 || last == 33 || last == 63)) {
                            spaces = 2;
                        }
                    }
                }
            }
        }
        join_col = acc.size();
        mark_shift.push(join_col + spaces - removed_ws);
        mark_removed.push(removed_ws);
        acc = acc + " ".repeat(spaces) + curr;
        sum_col = join_col;
    }
    editor.join_marks(row, mark_shift, mark_removed);
    str first = editor.buffer.line(row);
    int last_row = row + count - 1;
    editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(last_row, editor.buffer.line_size(last_row)), acc);
    int end_col = acc.size();
    if (end_col > 0) {
        end_col = end_col - 1;
    }
    set_op_marks(editor, MED_buffer.Pos(row, first.size()), MED_buffer.Pos(row, end_col));
    editor.row = row;
    editor.col = join_col;
    return true;
}

const int PUT_LINE = 1;
const int PUT_LINE_SPLIT = 2;
const int PUT_LINE_FORWARD = 4;

// Vim's do_put. `directory` 1 for p / gp, -1 for P / gP; `is_cursor_end` for gp / gP.
bool did_do_put(MED_editor.Editor editor, str regname, int directory, int count, bool is_cursor_end) {
    Option<MED_register.Reg> found = editor.regs.get(regname);
    match (found) {
        case None: {
            editor.message = "E353: Nothing in register " + regname;
            editor.noop_node();
            set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col));
            return false;
        }
        case Some(MED_register.Reg reg): {
            return did_put_reg(editor, reg, directory, count, is_cursor_end, 0, 0);
        }
    }
}

// Put a block-wise register: each line goes into the same columns of the
// lines below the cursor.
bool did_put_block(MED_editor.Editor editor, MED_register.Reg reg, int directory, int count, bool is_cursor_end) {
    int total = count1(count);
    MED_buffer.Buffer buffer = editor.buffer;
    str current = buffer.line(editor.row);
    int curcol = editor.col;
    int col = 0;
    if (directory > 0 && curcol < current.size()) {
        col = MED_text.display_col(current, curcol, editor.tab) + MED_text.cell_width(current, curcol, MED_text.display_col(current, curcol, editor.tab), editor.tab);
        curcol = MED_text.next_col(current, curcol);
    } else {
        col = MED_text.display_col(current, curcol, editor.tab);
    }
    int row0 = editor.row;
    int cursor_col = curcol;
    int cursor_col0 = curcol;
    int last_textcol = 0;
    int last_totlen = 0;
    for (int i in 0 .. reg.lines.size()) {
        int row = row0 + i;
        if (row >= buffer.line_count()) {
            int last_row = buffer.line_count() - 1;
            editor.change(MED_buffer.Pos(last_row, buffer.line_size(last_row)), MED_buffer.Pos(last_row, buffer.line_size(last_row)), "\n");
        }
        str old = buffer.line(row);
        int spot = 0;
        int vcol = 0;
        int incr = 0;
        while (vcol < col && spot < old.size()) {
            incr = MED_text.cell_width(old, spot, vcol, editor.tab);
            vcol = vcol + incr;
            spot = MED_text.next_col(old, spot);
        }
        int textcol = spot;
        bool is_shortline = vcol < col || (vcol == col && spot >= old.size());
        int startspaces = 0;
        int endspaces = 0;
        int delcount = 0;
        if (vcol < col) {
            startspaces = col - vcol;
        } else if (vcol > col) {
            endspaces = vcol - col;
            startspaces = incr - endspaces;
            textcol = MED_text.previous_col(old, spot);
            delcount = spot - textcol;
            if (old.byte_at(textcol) != 9) {
                delcount = 0;
                endspaces = 0;
                textcol = spot;
            }
        }
        str yank = reg.lines[i];
        int spaces = reg.width - MED_text.line_width(yank, editor.tab);
        if (spaces < 0) {
            spaces = 0;
        }
        int totlen = total * (yank.size() + spaces) + startspaces + endspaces;
        List<str> pieces = [old.substr(0, textcol), " ".repeat(startspaces)];
        for (int j in 0 .. total) {
            pieces.push(yank);
            if ((j < total - 1 || !is_shortline) && spaces > 0) {
                pieces.push(" ".repeat(spaces));
            } else {
                totlen = totlen - spaces;
            }
        }
        pieces.push(" ".repeat(endspaces));
        pieces.push(old.substr(textcol + delcount, old.size()));
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, old.size()), pieces.join(""));
        if (i == 0) {
            cursor_col = cursor_col + startspaces;
        }
        last_textcol = textcol;
        last_totlen = totlen;
    }
    set_op_marks(editor, MED_buffer.Pos(row0, cursor_col0), MED_buffer.Pos(row0 + reg.lines.size() - 1, last_textcol + last_totlen - 1));
    if (is_cursor_end) {
        editor.row = row0 + reg.lines.size() - 1;
        editor.col = MED_num.smaller(last_textcol + last_totlen, buffer.line_size(editor.row));
    } else {
        editor.row = row0;
        editor.col = cursor_col;
    }
    editor.clamp();
    return true;
}

// Vim's do_put with its flags (PUT_LINE and friends, used by Visual `p`).
// `vi_row` is the row the Visual end was on, for PUT_LINE_FORWARD.
bool did_put_reg(MED_editor.Editor editor, MED_register.Reg reg0, int dir0, int count, bool is_cursor_end, int flags, int vi_row) {
    MED_register.Reg reg = reg0;
    int directory = dir0;
    int amount = count1(count);
    set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col));
    MED_buffer.Buffer buffer = editor.buffer;
    if (reg.kind == MED_register.BLOCK && (flags & PUT_LINE) == 0) {
        return did_put_block(editor, reg, directory, count, is_cursor_end);
    }
    bool was_line = reg.kind == MED_register.LINE;
    if (was_line) {
        if ((flags & PUT_LINE_SPLIT) != 0) {
            str current = buffer.line(editor.row);
            int spot = editor.col;
            if (directory > 0 && spot < current.size()) {
                spot = MED_text.next_col(current, spot);
            }
            editor.change(MED_buffer.Pos(editor.row, spot), MED_buffer.Pos(editor.row, spot), "\n");
            directory = 1;
        }
        if ((flags & PUT_LINE_FORWARD) != 0) {
            editor.row = MED_num.smaller(vi_row, buffer.line_count() - 1);
            directory = 1;
        }
    }
    if ((flags & PUT_LINE) != 0) {
        reg = MED_register.Reg(reg.lines, MED_register.LINE);
    }
    if (reg.kind == MED_register.LINE) {
        str body = reg.lines.join("\n");
        List<str> parts = [];
        for (int i in 0 .. amount) {
            parts.push(body);
        }
        str text = parts.join("\n");
        int first_row = 0;
        if (directory > 0) {
            editor.change(MED_buffer.Pos(editor.row, buffer.line_size(editor.row)), MED_buffer.Pos(editor.row, buffer.line_size(editor.row)), "\n" + text);
            first_row = editor.row + 1;
        } else {
            editor.change(MED_buffer.Pos(editor.row, 0), MED_buffer.Pos(editor.row, 0), text + "\n");
            first_row = editor.row;
        }
        int total = reg.lines.size() * amount;
        int last_put = first_row + total - 1;
        int last_length = buffer.line_size(last_put);
        if (last_length > 0) {
            last_length = last_length - 1;
        }
        set_op_marks(editor, MED_buffer.Pos(first_row, 0), MED_buffer.Pos(last_put, last_length));
        if (is_cursor_end) {
            int after = first_row + total;
            if (after >= buffer.line_count()) {
                editor.row = buffer.line_count() - 1;
                editor.col = 0;
                editor.row = MED_num.smaller(after, buffer.line_count() - 1);
                editor.col = 0;
            } else {
                editor.row = after;
                editor.col = 0;
            }
        } else {
            editor.row = first_row;
            editor.col = first_nonblank_fix(buffer.line(first_row));
        }
        return true;
    }
    str line = buffer.line(editor.row);
    int spot = editor.col;
    if (directory > 0 && line.size() > 0) {
        spot = MED_text.next_col(line, editor.col);
    }
    if (line.size() == 0) {
        spot = 0;
    }
    str body = reg.lines.join("\n");
    List<str> parts = [];
    for (int i in 0 .. amount) {
        parts.push(body);
    }
    str text = parts.join("");
    MED_buffer.Pos start = MED_buffer.Pos(editor.row, spot);
    editor.change(start, start, text);
    MED_buffer.Pos end = MED_buffer.advance(start, text);
    if (text.size() > 0) {
        set_op_marks(editor, start, dec_position(editor, end));
    }
    if (reg.lines.size() > 1 || text.index_of("\n").is_some()) {
        if (is_cursor_end) {
            editor.row = end.row;
            editor.col = end.col;
        } else {
            editor.row = start.row;
            editor.col = start.col;
        }
    } else if (is_cursor_end) {
        editor.row = end.row;
        editor.col = end.col;
    } else if (text.size() == 0) {
        // Putting nothing leaves the cursor alone.
    } else {
        editor.row = end.row;
        editor.col = MED_text.previous_col(buffer.line(end.row), end.col);
    }
    return true;
}

// ------------------------------------------------------------ cursor helpers

bool is_position_before(MED_buffer.Pos position, MED_buffer.Pos position_value) {
    return position.row < position_value.row || (position.row == position_value.row && position.col < position_value.col);
}

// Make a motion's landing the cursor.
void apply_motion(MED_editor.Editor editor, MED_motion.Motion motion) {
    if (motion.is_jump) {
        pcmark(editor, MED_buffer.Pos(editor.row, editor.col));
    }
    editor.row = motion.row;
    editor.col = motion.col;
    editor.clamp();
    if (motion.want == -2) {
        editor.want_from_cursor();
    } else if (motion.want != -3) {
        editor.want = motion.want;
    }
}

const List<int> REG_ONE_MOTIONS = [37, 40, 41, 96, 47, 63, 110, 78, 123, 125, 42, 35];

// ---------------------------------------------------------------- operators

/// A text-object / motion range handed to the operator code.
type Range {
    bool is_ok = true;
    MED_buffer.Pos start = MED_buffer.Pos(0, 0);
    MED_buffer.Pos end = MED_buffer.Pos(0, 0);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_no_adj = false;
}

Range object_range(MED_editor.Editor editor, List<int> keys, int count) {
    Range range = Range();
    if (keys.size() < 2) {
        range.is_ok = false;
        return range;
    }
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_textobj.Sel sel = MED_textobj.select(editor.buffer, cursor, false, cursor, 0, keys[1], keys[0] == 97, count);
    if (!sel.is_ok) {
        if (sel.is_moved) {
            editor.row = sel.end.row;
            editor.col = sel.end.col;
            editor.clamp();
        }
        // nv_object() asks for the wanted column to follow the cursor either way
        editor.want_from_cursor();
        range.is_ok = false;
        return range;
    }
    range.start = sel.start;
    range.end = sel.end;
    range.is_linewise = sel.is_linewise;
    range.is_inclusive = sel.is_inclusive;
    if (sel.is_jump) {
        pcmark(editor, cursor);
    }
    return range;
}

// Vim's do_pending_operator for a normal-mode operator: find the range,
// then run the operator on it. Returns false when the command failed.
bool did_operate(MED_editor.Editor editor, str operator, str reg, int count, List<int> keys, bool is_doubled, int force) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.force = force;
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_buffer.Pos start = copy_position(cursor);
    MED_buffer.Pos end = copy_position(cursor);
    bool is_linewise = false;
    bool is_inclusive = false;
    bool is_no_adj = false;
    int last = editor.buffer.line_count() - 1;
    if (is_doubled) {
        int total = count1(count);
        if (total > 1 && editor.row >= last) {
            return false;
        }
        int end_row = MED_num.smaller(editor.row + total - 1, last);
        end = MED_buffer.Pos(end_row, lineop_col(editor, operator, end_row, total > 1));
        is_linewise = true;
    } else if (keys[0] == 105 || keys[0] == 97) {
        Range range = object_range(editor, keys, count);
        if (!range.is_ok) {
            return false;
        }
        start = range.start;
        end = range.end;
        is_linewise = range.is_linewise;
        is_inclusive = range.is_inclusive;
        oap.is_object = true;
    } else {
        MED_motion.Motion motion = run_motion(editor, keys, count, operator);
        if (!motion.is_ok) {
            if (motion.is_moved) {
                editor.row = motion.row;
                editor.col = motion.col;
                editor.clamp();
                editor.want_from_cursor();
            }
            return false;
        }
        end = MED_buffer.Pos(motion.row, motion.col);
        is_linewise = motion.is_linewise;
        is_inclusive = motion.is_inclusive;
        is_no_adj = motion.is_no_adj;
        if (motion.want >= 0 || motion.want == -1) {
            // `|` and `$` set the wanted column outright; j/k leave it stale
            editor.want = motion.want;
            oap.is_object = true;
        } else if (motion.want == -2) {
            oap.is_object = true;
        }
        if (motion.is_jump) {
            pcmark(editor, copy_position(cursor));
        }
        if (REG_ONE_MOTIONS.contains(keys[0])) {
            oap.is_reg_one = true;
        }
        if (keys[0] == 103 && keys.size() > 1 && (keys[1] == 39 || keys[1] == 42 || keys[1] == 35)) {
            oap.is_reg_one = true;
        }
    }
    if (force == 118) {
        if (is_linewise) {
            is_inclusive = false;
        } else {
            is_inclusive = !is_inclusive;
        }
        is_linewise = false;
    } else if (force == 86) {
        is_linewise = true;
    }
    if (is_position_before(end, start)) {
        MED_buffer.Pos swap = start;
        start = end;
        end = swap;
    }
    oap.start = start;
    oap.end = end;
    oap.is_linewise = is_linewise;
    oap.is_inclusive = is_inclusive;
    oap.line_count = end.row - start.row + 1;
    if (!is_linewise && !is_inclusive && !is_no_adj && end.col == 0 && oap.line_count > 1) {
        oap.line_count = oap.line_count - 1;
        end = MED_buffer.Pos(end.row - 1, 0);
        if (is_in_indent(editor.buffer.line(start.row), start.col)) {
            oap.is_linewise = true;
        } else {
            int size = editor.buffer.line_size(end.row);
            end.col = size;
            if (size > 0) {
                end.col = MED_text.last_col(editor.buffer.line(end.row));
                oap.is_inclusive = true;
            }
        }
        oap.end = end;
    }
    if (!oap.is_linewise) {
        bool is_at_nul = start.eq(end) && editor.buffer.line_size(start.row) <= start.col;
        oap.is_empty = start.eq(end) && (!oap.is_inclusive || (operator == "y" && is_at_nul));
    }
    editor.row = start.row;
    editor.col = start.col;
    return did_run_op(editor, oap);
}

// The operator itself, with the cursor already on the start of the range.
bool did_run_op(MED_editor.Editor editor, Oap oap) {
    str operator = oap.operator;
    if (operator == "d") {
        did_op_delete(editor, oap);
        if (oap.is_linewise && editor.is_global_busy) {
            editor.want_from_cursor();
        } else {
            // Vim sets w_set_curswant: the wanted column is recomputed lazily
            editor.needs_stale = true;
        }
    } else if (operator == "c") {
        // Vim skips the delete in an empty buffer (ML_EMPTY)
        if (!editor.buffer.is_empty) {
            did_op_delete(editor, oap);
        }
        start_insert(editor, 99, 1, false);
        editor.clamp();
        editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
        editor.ins_mark = editor.ins_start;
        return true;
    } else if (operator == "y") {
        op_yank(editor, oap);
        if (oap.is_linewise) {
            editor.row = oap.start.row;
            editor.col = oap.start.col;
        }
        editor.clamp();
        if (oap.is_object) {
            editor.want_from_cursor();
        }
    } else if (operator == "<" || operator == ">") {
        op_shift(editor, oap);
        editor.want_from_cursor();
    } else if (operator == "g~" || operator == "gu" || operator == "gU" || operator == "g?") {
        op_case(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
    } else {
        return false;
    }
    editor.clamp();
    return true;
}

// -------------------------------------------------------------- insert mode

// Whitespace for an indent of `width` columns.
// The indent of the line a split creates: the line's own, cut short when the
// cursor is inside the indent (Vim's open_line).
int split_indent(MED_editor.Editor editor, str line, int col) {
    int width = indent_width(editor, line);
    int vcol = MED_text.display_col(line, col, editor.tab);
    if (vcol < width) {
        return vcol;
    }
    return width;
}

str make_indent(MED_editor.Editor editor, int width) {
    if (editor.is_expandtab) {
        return " ".repeat(width);
    }
    return "\t".repeat(width / editor.tab) + " ".repeat(width % editor.tab);
}

bool is_white_byte(int right) {
    return right == 32 || right == 9;
}

void start_insert(MED_editor.Editor editor, int cmd, int count, bool is_replace) {
    editor.mode = MED_editor.INSERT;
    if (is_replace) {
        editor.mode = MED_editor.REPLACE;
    }
    editor.ins_cmd = cmd;
    editor.ins_count = count1(count);
    editor.ins_keys = [];
    editor.ins_text = "";
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_mark = editor.ins_start;
    editor.replaced = [];
    editor.ins_wait = 0;
    editor.is_ins_arrow = false;
    editor.restart_edit = 0;
    editor.is_ins_restart = false;
    editor.is_ins_next_set = false;
    editor.is_ins_hold = false;
    editor.is_ins_dirty = false;
    editor.vkind = 0;
    if (count1(count) == 1) {
        editor.want_from_cursor();
    }
}

// Type one printable character (or a literal control character).
void ins_char(MED_editor.Editor editor, int code_point) {
    str text = str.from_chars([code_point]);
    str line = editor.buffer.line(editor.row);
    MED_buffer.Pos position = MED_buffer.Pos(editor.row, editor.col);
    if (editor.mode == MED_editor.REPLACE && editor.col < line.size()) {
        int next = MED_text.next_col(line, editor.col);
        editor.replaced.push(line.substr(editor.col, next));
        editor.change(position, MED_buffer.Pos(editor.row, next), text);
    } else {
        if (editor.mode == MED_editor.REPLACE) {
            editor.replaced.push("");
        }
        editor.change(position, position, text);
    }
    editor.col = editor.col + text.size();
    editor.did_ai = false;
    editor.ins_text = editor.ins_text + text;
}

// <CR> in insert mode: Vim's open_line for the cursor's line.
void ins_cr(MED_editor.Editor editor) {
    // a typed line break forgets the "U" line and nothing typed after it is saved
    editor.uline_row = -1;
    editor.is_uline_off = true;
    str line = editor.buffer.line(editor.row);
    int cut = editor.col;
    int skip = editor.col;
    str indent = "";
    bool is_trunc = false;
    if (editor.is_autoindent) {
        indent = make_indent(editor, split_indent(editor, line, editor.col));
        if (editor.did_ai) {
            is_trunc = true;
        }
        while (skip < line.size() && is_white_byte(line.byte_at(skip))) {
            skip = skip + 1;
        }
        if (is_trunc) {
            while (cut > 0 && is_white_byte(line.byte_at(cut - 1))) {
                cut = cut - 1;
            }
        }
    }
    editor.change(MED_buffer.Pos(editor.row, cut), MED_buffer.Pos(editor.row, skip), "\n" + indent);
    editor.row = editor.row + 1;
    editor.col = indent.size();
    editor.did_ai = editor.is_autoindent;
    editor.ins_text = editor.ins_text + "\n";
    if (editor.mode == MED_editor.REPLACE) {
        editor.replaced.push("\n");
    }
}

// Whether a code point is a "word" character for CTRL-W in insert mode.
bool is_wordc(int code_point) {
    return MED_text.class_of(code_point) >= 2;
}

bool is_space_cp(int code_point) {
    return code_point == 32 || code_point == 9;
}

// CTRL-H / <BS> (mode 0), CTRL-W (1) and CTRL-U (2).
// Whether everything before `col` is blank (Vim's inindent).
bool is_in_indent_before(str line, int col) {
    for (int i in 0 .. col) {
        if (!is_white_byte(line.byte_at(i))) {
            return false;
        }
    }
    return col > 0;
}

bool did_ins_bs(MED_editor.Editor editor, int mode) {
    if (editor.row == 0 && editor.col == 0) {
        return false;
    }
    if (editor.col == 0) {
        int size = editor.buffer.line_size(editor.row - 1);
        editor.change(MED_buffer.Pos(editor.row - 1, size), MED_buffer.Pos(editor.row, 0), "");
        if (editor.ins_start.row == editor.row) {
            editor.ins_start = MED_buffer.Pos(editor.row - 1, size + editor.ins_start.col);
        }
        editor.row = editor.row - 1;
        editor.col = size;
        if (editor.mode == MED_editor.REPLACE && editor.replaced.size() > 0) {
            editor.replaced.pop();
        }
        return true;
    }
    int mincol = 0;
    str line = editor.buffer.line(editor.row);
    if (mode == 0 && editor.mode == MED_editor.INSERT && is_in_indent_before(line, editor.col)) {
        // 'smarttab' (on in nvim): <BS> in the indent steps back one 'shiftwidth'
        int vcol = MED_text.display_col(line, editor.col, editor.tab);
        int want = ((vcol - 1) / editor.shiftwidth) * editor.shiftwidth;
        while (vcol > want && editor.col > 0) {
            int previous = MED_text.previous_col(line, editor.col);
            editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), "");
            editor.col = previous;
            line = editor.buffer.line(editor.row);
            vcol = MED_text.display_col(line, editor.col, editor.tab);
        }
        if (vcol < want) {
            editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col), " ".repeat(want - vcol));
            editor.col = editor.col + want - vcol;
        }
        if (editor.row == editor.ins_start.row && editor.col < editor.ins_start.col) {
            editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
        }
        editor.did_ai = false;
        return true;
    }
    if (mode == 2 && editor.is_autoindent) {
        int fnb = MED_text.first_nonblank(line);
        if (fnb < editor.col) {
            mincol = fnb;
        }
    }
    int state = mode;
    bool is_word = false;
    int cclass = 0;
    int previous_class = 0;
    if (editor.col < line.size()) {
        cclass = MED_text.class_at(line, editor.col);
    }
    while (true) {
        line = editor.buffer.line(editor.row);
        int previous = MED_text.previous_col(line, editor.col);
        int code_point = MED_text.cp_at(line, previous);
        previous_class = cclass;
        cclass = MED_text.class_at(line, previous);
        if (state == 1 && !is_space_cp(code_point)) {
            state = 3;
            is_word = is_wordc(code_point);
        } else if (state == 3 && (is_space_cp(code_point) || is_wordc(code_point) != is_word || previous_class != cclass)) {
            break;
        }
        if (editor.mode == MED_editor.REPLACE) {
            if (editor.replaced.size() > 0) {
                str back = editor.replaced.pop();
                editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), back);
            }
        } else {
            editor.change(MED_buffer.Pos(editor.row, previous), MED_buffer.Pos(editor.row, editor.col), "");
        }
        editor.col = previous;
        if (mode == 0) {
            break;
        }
        if (!(editor.col > mincol && !(editor.row == editor.ins_start.row && editor.col == editor.ins_start.col))) {
            break;
        }
    }
    if (editor.row == editor.ins_start.row && editor.col < editor.ins_start.col) {
        editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    }
    editor.did_ai = false;
    return true;
}

// <Del> in insert mode.
bool did_ins_del(MED_editor.Editor editor) {
    str line = editor.buffer.line(editor.row);
    if (editor.col < line.size()) {
        int next = MED_text.next_col(line, editor.col);
        editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, next), "");
        return true;
    }
    if (editor.row + 1 >= editor.buffer.line_count()) {
        return false;
    }
    editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row + 1, 0), "");
    return true;
}

// Remove the whitespace an auto-indent left behind (Vim's stop_insert).
void strip_autoindent(MED_editor.Editor editor) {
    int row = editor.row;
    int col = editor.col;
    int orig_row = editor.row;
    int orig_col = editor.col;
    str line = editor.buffer.line(row);
    if (col > line.size()) {
        col = line.size();
    }
    int current_col = -1;
    while (true) {
        line = editor.buffer.line(row);
        if (col >= line.size() && col > 0) {
            col = MED_text.previous_col(line, col);
        }
        if (col >= line.size()) {
            current_col = 0;
            break;
        }
        current_col = line.byte_at(col);
        if (!is_white_byte(current_col)) {
            break;
        }
        editor.change(MED_buffer.Pos(row, col), MED_buffer.Pos(row, col + 1), "");
    }
    line = editor.buffer.line(row);
    if (current_col != 0 && MED_text.next_col(line, col) >= line.size()) {
        col = line.size();
    }
    editor.row = row;
    if (orig_col < col && orig_row == row) {
        col = orig_col;
    }
    editor.col = col;
}

// <Esc>: repeat the insert for a count, tidy up, and go back to normal mode.
void finish_insert(MED_editor.Editor editor) {
    int count = editor.ins_count;
    if (editor.is_ins_arrow) {
        count = 1;
    }
    bool is_untouched = editor.is_ins_arrow && editor.is_ins_restart;
    editor.is_ins_arrow = false;
    editor.ins_count = 1;
    str typed_text = editor.ins_text;
    if (count > 1 && !editor.is_failed) {
        List<int> typed = editor.ins_keys;
        int replays = count - 1;
        bool is_saved = editor.is_replaying;
        for (int i in 0 .. replays) {
            if (editor.ins_cmd == 111 || editor.ins_cmd == 79) {
                ins_cr_open(editor);
            }
            for (int key in typed) {
                insert_key_raw(editor, key);
            }
        }
        editor.is_replaying = is_saved;
    }
    if (editor.did_ai) {
        strip_autoindent(editor);
    }
    editor.is_uline_off = false;
    str line = editor.buffer.line(editor.row);
    editor.marks.set("^", MED_buffer.Pos(editor.row, editor.col));
    if (!is_untouched) {
        set_op_marks(editor, editor.ins_mark, MED_buffer.Pos(editor.row, editor.col));
    }
    if (editor.is_ins_ctrl_o) {
        editor.is_ins_at_eol = editor.col >= line.size();
        editor.o_lnum = editor.row;
    }
    if (editor.col > 0 && (!editor.is_ins_ctrl_o || editor.col >= line.size())) {
        editor.col = MED_text.previous_col(line, editor.col);
    }
    editor.mode = MED_editor.NORMAL;
    if (editor.blk_op != 0) {
        block_insert_end(editor);
    }
    if (!is_untouched) {
        editor.regs.set_special(".", typed_text);
    }
    if (!editor.is_in_dot && !is_untouched) {
        List<int> tail = editor.ins_keys.slice(0, editor.ins_keys.size());
        tail.push(27);
        editor.dot_tail = tail;
    }
    editor.ins_keys = [];
    editor.end_block();
    editor.clamp();
    editor.want_from_cursor();
}

// `o` / `O` repeats start with a line break.
void ins_cr_open(MED_editor.Editor editor) {
    ins_cr(editor);
}

// One key in insert mode without the bookkeeping of `ins_keys`.
void insert_key_raw(MED_editor.Editor editor, int key) {
    if (key == 13 || key == 10) {
        ins_cr(editor);
    } else if (key == 127 || key == 8) {
        did_ins_bs(editor, 0);
    } else if (key == 23) {
        did_ins_bs(editor, 1);
    } else if (key == 21) {
        did_ins_bs(editor, 2);
    } else if (key == 63240) {
        did_ins_del(editor);
    } else if (key == 9) {
        ins_tab(editor);
    } else if (key >= 32 && key < 63232) {
        ins_char(editor, key);
    }
}

void ins_tab(MED_editor.Editor editor) {
    if (!editor.is_expandtab) {
        ins_char(editor, 9);
        return;
    }
    str line = editor.buffer.line(editor.row);
    int spot = MED_text.display_col(line, editor.col, editor.tab);
    int count = editor.tab - (spot % editor.tab);
    for (int i in 0 .. count) {
        ins_char(editor, 32);
    }
}

// Move the cursor with an arrow key: that ends the undo block and the
// insert restarts as a fresh `i`.
void ins_move(MED_editor.Editor editor, int key) {
    str line = editor.buffer.line(editor.row);
    // 'whichwrap' is "b,s": no wrapping in insert mode, and a move that cannot
    // happen is only a beep (it does not count as an arrow key).
    if (key == 63234 && editor.col == 0) {
        return;
    }
    if (key == 63235 && editor.col >= line.size()) {
        return;
    }
    if (key == 63232 && editor.row == 0) {
        return;
    }
    if (key == 63233 && editor.row + 1 >= editor.buffer.line_count()) {
        return;
    }
    // Vim's stop_insert() only removes the autoindent when the cursor leaves
    // the line, which Up and Down do and the sideways keys do not.
    if (editor.did_ai && (key == 63232 || key == 63233)) {
        strip_autoindent(editor);
        line = editor.buffer.line(editor.row);
    }
    editor.is_uline_off = false;
    editor.end_block();
    if (key == 63234) {
        editor.col = MED_text.previous_col(line, editor.col);
    } else if (key == 63235) {
        editor.col = MED_text.next_col(line, editor.col);
    } else if (key == 63232 || key == 63233) {
        // up and down use the wanted column, which typing and sideways moves
        // update but opening a line does not
        if (key == 63232) {
            editor.row = editor.row - 1;
        } else {
            editor.row = editor.row + 1;
        }
        if (editor.want < 0) {
            editor.col = editor.buffer.line_size(editor.row);
        } else {
            editor.col = MED_motion.col_for_want(editor.buffer.line(editor.row), editor.want, editor.tab, true);
        }
    } else if (key == 63236) {
        editor.col = 0;
    } else if (key == 63237) {
        editor.col = line.size();
    }
    if (key != 63232 && key != 63233) {
        editor.want_from_cursor();
    }
    if (key == 63237) {
        editor.want = -1;
    }
    editor.did_ai = false;
    editor.ins_keys = [];
    editor.ins_text = "";
    editor.is_ins_arrow = true;
    editor.ins_count = 1;
    editor.ins_cmd = 105;
    editor.dot_body = [105];
    editor.dot_count = 0;
}

// Type a register's text as if it were typed.
void ins_register(MED_editor.Editor editor, str name) {
    Option<MED_register.Reg> found = editor.regs.get(name);
    match (found) {
        case None: {
        }
        case Some(MED_register.Reg reg): {
            str text = reg.text();
            for (int code_point in text.chars()) {
                if (code_point == 10) {
                    editor.ins_keys.push(13);
                    ins_cr(editor);
                } else {
                    editor.ins_keys.push(code_point);
                    ins_char(editor, code_point);
                }
            }
        }
    }
}

// Typing after an arrow key starts a fresh insert (Vim's stop_arrow): only
// now does the insert start move to the cursor.
void stop_arrow(MED_editor.Editor editor) {
    if (editor.is_ins_arrow) {
        if (editor.is_ins_restart) {
            editor.is_ins_restart = false;
            if (!editor.is_in_dot) {
                editor.dot_body = [105];
                editor.dot_count = 0;
                editor.dot_tail = [];
            }
        }
        editor.ins_next = MED_buffer.Pos(editor.row, editor.col);
        editor.is_ins_next_set = true;
        if (editor.col > editor.ins_start.col && editor.is_ins_dirty) {
            // moved right of the original start after typing: keep that start
            editor.is_ins_hold = true;
        }
        editor.is_ins_arrow = false;
    }
    editor.is_ins_dirty = true;
}

int hex_value(int char_code) {
    if (char_code >= 48 && char_code <= 57) {
        return char_code - 48;
    }
    if (char_code >= 97 && char_code <= 102) {
        return char_code - 87;
    }
    if (char_code >= 65 && char_code <= 70) {
        return char_code - 55;
    }
    return -1;
}

// One key after CTRL-V (Vim's get_literal): a decimal, octal (o), hex (x),
// or Unicode (u, U) number, or the key itself.
void ins_literal_key(MED_editor.Editor editor, int next_col) {
    if (next_col >= 63232 && next_col <= 63400 && editor.lit_i == 0 && !editor.is_lit_hex && !editor.is_lit_octal && editor.lit_uni == 0) {
        // a key with no character of its own is inserted by name
        editor.ins_wait = 0;
        editor.ins_text = editor.ins_text + "\x16";
        for (int code_point in MED_key.name(next_col).chars()) {
            ins_char(editor, code_point);
        }
        return;
    }
    bool is_done = false;
    bool is_reuse = false;
    if (next_col == 120 || next_col == 88) {
        editor.is_lit_hex = true;
    } else if (next_col == 111 || next_col == 79) {
        editor.is_lit_octal = true;
    } else if (next_col == 117 || next_col == 85) {
        editor.lit_uni = next_col;
    } else if (editor.is_lit_hex || editor.lit_uni != 0) {
        int digit = hex_value(next_col);
        if (digit < 0) {
            is_done = true;
        } else {
            editor.lit_cc = editor.lit_cc * 16 + digit;
            editor.lit_i = editor.lit_i + 1;
        }
    } else if (editor.is_lit_octal) {
        if (next_col < 48 || next_col > 55) {
            is_done = true;
        } else {
            editor.lit_cc = editor.lit_cc * 8 + next_col - 48;
            editor.lit_i = editor.lit_i + 1;
        }
    } else if (next_col < 48 || next_col > 57) {
        is_done = true;
    } else {
        editor.lit_cc = editor.lit_cc * 10 + next_col - 48;
        editor.lit_i = editor.lit_i + 1;
    }
    if (!is_done) {
        if (editor.lit_cc > 255 && editor.lit_uni == 0) {
            editor.lit_cc = 255;
        }
        if (editor.lit_cc > 1114111) {
            editor.lit_cc = 65533;
        }
        if (editor.is_lit_hex) {
            is_done = editor.lit_i >= 2;
        } else if (editor.lit_uni != 0) {
            is_done = (editor.lit_uni == 117 && editor.lit_i >= 4) || (editor.lit_uni == 85 && editor.lit_i >= 8);
        } else {
            is_done = editor.lit_i >= 3;
        }
        if (!is_done) {
            return;
        }
    } else if (editor.lit_i > 0) {
        is_reuse = true;
    }
    int current_col = editor.lit_cc;
    if (editor.lit_i == 0) {
        current_col = next_col;
    }
    if (current_col == 0) {
        current_col = 10;
    }
    editor.ins_wait = 0;
    editor.is_lit_hex = false;
    editor.is_lit_octal = false;
    editor.lit_uni = 0;
    editor.lit_cc = 0;
    editor.lit_i = 0;
    editor.ins_text = editor.ins_text + "\x16";
    ins_char(editor, current_col);
    if (is_reuse) {
        editor.ins_keys.pop();
        insert_key(editor, next_col);
    }
}

void insert_key(MED_editor.Editor editor, int key) {
    if (editor.is_ins_next_set) {
        if (!editor.is_ins_hold) {
            editor.ins_start = editor.ins_next;
            editor.ins_mark = editor.ins_start;
        }
        editor.is_ins_next_set = false;
    }
    if (editor.ins_wait == 18) {
        editor.ins_wait = 0;
        stop_arrow(editor);
        ins_register(editor, str.from_chars([key]));
        return;
    }
    if (editor.ins_wait == 22) {
        stop_arrow(editor);
        editor.ins_keys.push(key);
        ins_literal_key(editor, key);
        return;
    }
    if (key == 27 || key == 3) {
        finish_insert(editor);
        return;
    }
    if (key == 15) {
        // CTRL-O: one Normal mode command, then back to inserting
        int back = 105;
        if (editor.mode == MED_editor.REPLACE) {
            back = 82;
        }
        editor.is_ins_ctrl_o = true;
        editor.ins_count = 1;
        finish_insert(editor);
        editor.is_ins_ctrl_o = false;
        editor.restart_edit = back;
        editor.is_restart_skip = true;
        return;
    }
    if (key == 18) {
        editor.ins_wait = 18;
        return;
    }
    if (key == 22 || key == 17) {
        editor.ins_wait = 22;
        editor.ins_keys.push(22);
        return;
    }
    if (key >= 63232 && key <= 63237) {
        ins_move(editor, key);
        return;
    }
    stop_arrow(editor);
    editor.ins_keys.push(key);
    if (key == 13 || key == 10) {
        ins_cr(editor);
    } else if (key == 127 || key == 8) {
        if (!did_ins_bs(editor, 0)) {
            editor.ins_keys.pop();
        }
    } else if (key == 23) {
        if (did_ins_bs(editor, 1)) {
            editor.ins_text = editor.ins_text + "\x17";
        } else {
            editor.ins_keys.pop();
        }
    } else if (key == 21) {
        if (did_ins_bs(editor, 2)) {
            editor.ins_text = editor.ins_text + "\x15";
        } else {
            editor.ins_keys.pop();
        }
    } else if (key == 63240) {
        did_ins_del(editor);
    } else if (key == 9) {
        ins_tab(editor);
    } else if (key >= 32 && key < 63232) {
        ins_char(editor, key);
    } else {
        editor.ins_keys.pop();
    }
    if (editor.ins_count <= 1) {
        editor.want_from_cursor();
    }
}

// ------------------------------------------------------------------ commands

// A changing command: remember it for `.`.
void record_dot(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    if (editor.is_in_dot) {
        return;
    }
    editor.dot_reg = parsed.reg;
    editor.dot_count = parsed.count;
    editor.dot_body = parsed.body;
    if (editor.is_search_ready && editor.dot_body.size() > 0) {
        // `d/foo<CR>`: the pattern was typed on the command line, repeat it
        int last = editor.dot_body[editor.dot_body.size() - 1];
        if (last == 47 || last == 63) {
            List<int> body = editor.dot_body.slice(0, editor.dot_body.size());
            for (int code_point in editor.search_typed.chars()) {
                body.push(code_point);
            }
            body.push(13);
            editor.dot_body = body;
        }
    }
    editor.dot_tail = [];
    editor.dot_vkind = 0;
}

List<int> count_keys(int count) {
    List<int> out = [];
    if (count > 0) {
        for (int code_point in count.to_str().chars()) {
            out.push(code_point);
        }
    }
    return out;
}

// Run `keys` as if typed. A failing command stops the rest (macros, dot). A
// command that queued an ex line also stops it: the keys after it are parked in
// `ed.park` and MED_ex continues them once the ex line has run.
pub bool did_replay(MED_editor.Editor editor, List<int> keys) {
    bool is_saved = editor.is_replaying;
    editor.is_replaying = true;
    bool is_ok = true;
    int spot = 0;
    for (int key in keys) {
        editor.is_failed = false;
        spot = spot + 1;
        feed(editor, key);
        if (editor.is_failed) {
            is_ok = false;
            break;
        }
        if (editor.ex_queue.size() > 0) {
            editor.park = keys.slice(spot, keys.size());
            editor.is_park_set = true;
            break;
        }
    }
    editor.is_replaying = is_saved;
    if (!is_ok) {
        editor.pending = [];
        editor.is_failed = true;
    }
    return is_ok;
}

// Run `first`, then `again` more rounds of `full`; park the rest when an ex line interrupts.
pub void run_keys(MED_editor.Editor editor, List<int> first, List<int> full, int again) {
    List<int> keys = first;
    int left = again;
    while (true) {
        if (!did_replay(editor, keys)) {
            return;
        }
        if (editor.is_park_set) {
            editor.is_park_set = false;
            if (editor.park.size() > 0 || left > 0) {
                MED_editor.Resume resume = MED_editor.Resume(editor.park, full);
                resume.again = left;
                editor.resume.push(resume);
            }
            editor.park = [];
            return;
        }
        if (left == 0) {
            return;
        }
        left = left - 1;
        keys = full;
    }
}

// Execute the register's text as typed keys, `count` times.
void run_macro(MED_editor.Editor editor, str name, int count) {
    str reg_name = name;
    if (name == "@") {
        reg_name = editor.last_macro;
        if (reg_name == "") {
            editor.is_failed = true;
            return;
        }
    }
    if (reg_name == ":") {
        editor.last_macro = ":";
        if (editor.regs.last_command == "") {
            editor.message = "E30: No previous command line";
            editor.is_failed = true;
            return;
        }
        for (int i in 0 .. count1(count)) {
            editor.ex_queue.push(editor.regs.last_command);
        }
        return;
    }
    Option<MED_register.Reg> found = editor.regs.get(reg_name);
    match (found) {
        case None: {
            editor.is_failed = true;
        }
        case Some(MED_register.Reg reg): {
            editor.last_macro = reg_name;
            List<int> keys = MED_key.decode(reg.text());
            editor.block_hold = editor.block_hold + 1;
            editor.macro_holds = editor.macro_holds + 1;
            run_keys(editor, keys, keys, count1(count) - 1);
            if (editor.ex_queue.size() == 0 && editor.resume.size() == 0) {
                editor.block_hold = editor.block_hold - 1;
                editor.macro_holds = editor.macro_holds - 1;
                if (editor.block_hold == 0 && editor.mode == MED_editor.NORMAL) {
                    editor.end_block();
                }
            }
        }
    }
}

void dot_repeat(MED_editor.Editor editor, int count) {
    if (editor.dot_body.size() == 0) {
        editor.is_failed = true;
        return;
    }
    int total = editor.dot_count;
    if (count > 0) {
        total = count;
        editor.dot_count = count;
    }
    if (editor.dot_reg.size() == 1) {
        int code = editor.dot_reg.byte_at(0);
        if (code >= 49 && code <= 56) {
            editor.dot_reg = str.from_chars([code + 1]);
        }
    }
    if (editor.dot_vkind != 0) {
        setup_visual_redo(editor);
    }
    List<int> keys = [];
    if (editor.dot_reg != "") {
        keys.push(34);
        keys.push(editor.dot_reg.byte_at(0));
    }
    if (editor.dot_vkind == 0) {
        for (int key in count_keys(total)) {
            keys.push(key);
        }
    } else if (editor.dot_count > 0) {
        for (int key in count_keys(editor.dot_count)) {
            keys.push(key);
        }
    }
    for (int key in editor.dot_body) {
        keys.push(key);
    }
    for (int key in editor.dot_tail) {
        keys.push(key);
    }
    bool is_saved = editor.is_in_dot;
    editor.is_in_dot = true;
    bool is_ok = did_replay(editor, keys);
    editor.is_in_dot = is_saved;
    if (!is_ok) {
        editor.is_failed = true;
    }
}

// setpcmark(): does nothing inside `:global`.
void pcmark(MED_editor.Editor editor, MED_buffer.Pos position) {
    editor.set_pcmark(position);
}

pub bool did_mark_name_ok(str mode_text) {
    if (mode_text.size() != 1) {
        return false;
    }
    int key = mode_text.byte_at(0);
    return (key >= 97 && key <= 122) || (key >= 65 && key <= 90) || key == 39 || key == 96 || key == 91 || key == 93 || key == 60 || key == 62;
}

void set_mark(MED_editor.Editor editor, int key) {
    bool is_valid = (key >= 97 && key <= 122) || (key >= 65 && key <= 90) || key == 39 || key == 96 || key == 91 || key == 93 || key == 60 || key == 62;
    if (!is_valid) {
        editor.is_failed = true;
        return;
    }
    str name = str.from_chars([key]);
    if (key == 96) {
        name = "'";
    }
    editor.marks.set(name, MED_buffer.Pos(editor.row, editor.col));
}

// `x`, `D`, `s` ... : a one-key synonym for an operator and a motion.
bool is_synonym(MED_editor.Editor editor, MED_parse.Parsed parsed, str operator, List<int> motion, bool is_doubled) {
    record_dot(editor, parsed);
    return did_operate(editor, operator, parsed.reg, parsed.count, motion, is_doubled, 0);
}

// `~`: swap the case of `count` characters and step over them.
bool did_cmd_tilde(MED_editor.Editor editor, int count) {
    str line = editor.buffer.line(editor.row);
    if (line.size() == 0) {
        return false;
    }
    int total = count1(count);
    int end = editor.col;
    int done = 0;
    while (done < total && end < line.size()) {
        end = MED_text.next_col(line, end);
        done = done + 1;
    }
    str text = line.substr(editor.col, end);
    str mapped = map_case(text, "g~");
    if (mapped != text) {
        editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), mapped);
        int shown = end;
        if (shown >= line.size()) {
            shown = MED_text.last_col(line);
        }
        if (shown > 0) {
            shown = MED_text.previous_col(line, shown);
        }
        set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, shown));
    } else {
        // Vim saves the line for undo before it finds that nothing changes
        editor.noop_node();
    }
    editor.col = end;
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

// `r{char}`
bool did_cmd_replace_char(MED_editor.Editor editor, List<int> keys, int count) {
    int key = keys[1];
    if (key == 27) {
        return true;
    }
    str line = editor.buffer.line(editor.row);
    int total = count1(count);
    int end = editor.col;
    int done = 0;
    while (done < total && end < line.size()) {
        end = MED_text.next_col(line, end);
        done = done + 1;
    }
    if (done < total) {
        return false;
    }
    editor.regs.set_special(".", str.from_chars([key]));
    if (key == 13 || key == 10) {
        // Vim deletes the characters, then types <CR><Esc> in insert mode.
        editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), "");
        List<int> saved_tail = editor.dot_tail;
        start_insert(editor, 114, 1, false);
        ins_cr(editor);
        finish_insert(editor);
        editor.dot_tail = saved_tail;
        return true;
    }
    int code_point = key;
    if (keys.size() == 3) {
        code_point = keys[2];
    }
    str one = str.from_chars([code_point]);
    editor.change(MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, end), one.repeat(total));
    set_op_marks(editor, MED_buffer.Pos(editor.row, editor.col), MED_buffer.Pos(editor.row, editor.col + one.size() * (total - 1)));
    editor.col = editor.col + one.size() * (total - 1);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

// `o` and `O`: open a line (Vim's open_line) and start inserting.
void cmd_open(MED_editor.Editor editor, bool is_below, int count) {
    str line = editor.buffer.line(editor.row);
    str indent = "";
    if (editor.is_autoindent) {
        indent = make_indent(editor, indent_width(editor, line));
    }
    if (is_below) {
        MED_buffer.Pos position = MED_buffer.Pos(editor.row, line.size());
        editor.change(position, position, "\n" + indent);
        editor.row = editor.row + 1;
    } else {
        MED_buffer.Pos position = MED_buffer.Pos(editor.row, 0);
        editor.change(position, position, indent + "\n");
    }
    editor.col = indent.size();
    int cmd = 111;
    if (!is_below) {
        cmd = 79;
    }
    start_insert(editor, cmd, count, false);
    // edit() is told "startln": the insert starts at the line's column 0
    editor.ins_start = MED_buffer.Pos(editor.row, 0);
    editor.ins_mark = editor.ins_start;
    editor.did_ai = editor.is_autoindent;
}

bool did_cmd_join(MED_editor.Editor editor, int count, bool is_spaces) {
    int total = count;
    if (total <= 1) {
        total = 2;
    }
    if (editor.row + total > editor.buffer.line_count()) {
        if (total <= 2) {
            return false;
        }
        total = editor.buffer.line_count() - editor.row;
    }
    did_do_join(editor, editor.row, total, is_spaces);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

pub void cmd_undo(MED_editor.Editor editor, int count, bool is_redo) {
    bool is_any = false;
    for (int i in 0 .. count1(count)) {
        bool is_ok = false;
        if (is_redo) {
            is_ok = editor.did_redo();
        } else {
            is_ok = editor.did_undo();
        }
        if (!is_ok) {
            break;
        }
        is_any = true;
    }
    if (!is_any) {
        editor.is_failed = true;
    }
}

// g- and g+: step through the undo states in the order they were made.
bool did_cmd_undo_time(MED_editor.Editor editor, int count, bool is_forward) {
    editor.close_block();
    int total = count1(count);
    int target = editor.current - total;
    if (is_forward) {
        target = editor.current + total;
    }
    if (target < 0) {
        target = 0;
    }
    if (target > editor.nodes.size() - 1) {
        target = editor.nodes.size() - 1;
    }
    if (target == editor.current) {
        return false;
    }
    return editor.did_undo_to(target);
}

void enter_cmdline(MED_editor.Editor editor, int kind, List<int> saved) {
    editor.mode_before_cmd = editor.mode;
    editor.cmd_type = kind;
    editor.cmdline = "";
    editor.hist_at = -1;
    editor.hist_prefix = "";
    editor.cmd_saved = saved;
    editor.mode = MED_editor.CMDLINE;
}

// A normal-mode command that is not an operator or a motion.
bool is_view_key(int key) {
    return key == 122 || key == 5 || key == 25 || key == 4 || key == 21 || key == 6 || key == 2;
}

// The window commands: CTRL-E CTRL-Y CTRL-D CTRL-U CTRL-F CTRL-B and z.
bool did_view_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    int key = parsed.keys[0];
    int count = parsed.count;
    if (key == 122) {
        return MED_view.did_z_command(editor, parsed.keys[1], count);
    }
    if (key == 5 || key == 25) {
        MED_view.scroll_line(editor, key == 5, count1(count));
        return true;
    }
    if (key == 4 || key == 21) {
        if ((key == 21 && editor.row == 0) || (key == 4 && editor.row == editor.buffer.line_count() - 1)) {
            return false;
        }
        return MED_view.did_page(editor, key == 4, count, true);
    }
    return MED_view.did_page(editor, key == 6, count, false);
}

void run_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int key = parsed.keys[0];
    int count = parsed.count;
    bool is_ok = true;
    if (key == 120) {
        is_ok = is_synonym(editor, parsed, "d", [108], false);
    } else if (key == 88) {
        is_ok = is_synonym(editor, parsed, "d", [104], false);
    } else if (key == 68) {
        is_ok = is_synonym(editor, parsed, "d", [36], false);
    } else if (key == 67) {
        is_ok = is_synonym(editor, parsed, "c", [36], false);
    } else if (key == 115) {
        is_ok = is_synonym(editor, parsed, "c", [108], false);
    } else if (key == 83) {
        is_ok = is_synonym(editor, parsed, "c", [99], true);
    } else if (key == 89) {
        is_ok = did_operate(editor, "y", parsed.reg, parsed.count, [36], false, 0);
    } else if (key == 112 || key == 80) {
        record_dot(editor, parsed);
        int directory = 1;
        if (key == 80) {
            directory = -1;
        }
        is_ok = did_do_put(editor, parsed.reg, directory, count, false);
        editor.clamp();
        editor.want_from_cursor();
    } else if (key == 117) {
        cmd_undo(editor, count, false);
    } else if (key == 85) {
        if (!editor.did_undo_line()) {
            editor.is_failed = true;
        }
        editor.end_block();
    } else if (key == 18) {
        cmd_undo(editor, count, true);
    } else if (key == 46) {
        dot_repeat(editor, count);
    } else if (key == 105 || key == 97 || key == 73 || key == 65) {
        record_dot(editor, parsed);
        str line = editor.buffer.line(editor.row);
        if (key == 97 && line.size() > 0) {
            editor.col = MED_text.next_col(line, editor.col);
        } else if (key == 65) {
            editor.col = line.size();
        } else if (key == 73) {
            editor.col = MED_text.first_nonblank(line);
        }
        start_insert(editor, key, count, false);
    } else if (key == 111 || key == 79) {
        record_dot(editor, parsed);
        cmd_open(editor, key == 111, count);
    } else if (key == 82) {
        record_dot(editor, parsed);
        start_insert(editor, 82, count, true);
    } else if (key == 74) {
        record_dot(editor, parsed);
        is_ok = did_cmd_join(editor, count, true);
    } else if (key == 126) {
        record_dot(editor, parsed);
        is_ok = did_cmd_tilde(editor, count);
    } else if (key == 1 || key == 24) {
        record_dot(editor, parsed);
        is_ok = did_cmd_addsub(editor, key == 24, count);
    } else if (key == 114) {
        record_dot(editor, parsed);
        is_ok = did_cmd_replace_char(editor, parsed.keys, count);
    } else if (key == 109) {
        set_mark(editor, parsed.keys[1]);
    } else if (key == 113) {
        int name = parsed.keys[1];
        if (MED_parse.is_valid_register(name) && ((name >= 97 && name <= 122) || (name >= 65 && name <= 90) || (name >= 48 && name <= 57) || name == 34)) {
            editor.macro_reg = str.from_chars([name]);
            editor.macro_keys = [];
        } else {
            is_ok = false;
        }
    } else if (key == 64) {
        run_macro(editor, str.from_chars([parsed.keys[1]]), count);
    } else if (key == 118 || key == 86 || key == 22) {
        enter_visual(editor, key);
        if (count > 1 && editor.dot_vkind == 0) {
            // With a count, select that many characters or lines.
            int step = 108;
            if (key == 86) {
                step = 106;
            }
            MED_motion.Motion motion = run_motion(editor, [step], count - 1, "");
            if (motion.is_ok) {
                apply_motion(editor, motion);
            }
        }
    } else if (key == 58 || key == 47 || key == 63) {
        enter_cmdline(editor, key, typed);
        if (key == 58 && count > 0) {
            if (count == 1) {
                editor.cmdline = ".";
            } else {
                editor.cmdline = ".,.+" + (count - 1).to_str();
            }
        }
    } else if (key == 38) {
        editor.ex_queue.push("s");
    } else if (key == 103) {
        is_ok = did_run_g(editor, parsed, typed);
    } else if (key == 90) {
        int second = parsed.keys[1];
        if (second == 90 || second == 81) {
            editor.is_quit = true;
            editor.is_force_quit = second == 81;
        } else {
            is_ok = false;
        }
    } else if (key == 27) {
        editor.pending = [];
    } else if (is_view_key(key)) {
        is_ok = did_view_cmd(editor, parsed);
    } else if (key == 12 || key == 7) {
        editor.pending = [];
    } else {
        is_ok = false;
    }
    if (!is_ok) {
        editor.is_failed = true;
    }
}

bool did_run_g(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int second = parsed.keys[1];
    int count = parsed.count;
    if (second == 45 || second == 43) {
        return did_cmd_undo_time(editor, count, second == 43);
    }
    if (second == 74) {
        record_dot(editor, parsed);
        return did_cmd_join(editor, count, false);
    }
    if (second == 112 || second == 80) {
        record_dot(editor, parsed);
        int directory = 1;
        if (second == 80) {
            directory = -1;
        }
        bool is_ok = did_do_put(editor, parsed.reg, directory, count, true);
        editor.clamp();
        editor.want_from_cursor();
        return is_ok;
    }
    if (second == 73) {
        record_dot(editor, parsed);
        editor.col = 0;
        start_insert(editor, 73, count, false);
        return true;
    }
    if (second == 105) {
        record_dot(editor, parsed);
        Option<MED_buffer.Pos> mark = editor.marks.get("^");
        match (mark) {
            case Some(MED_buffer.Pos position): {
                editor.row = MED_num.smaller(position.row, editor.buffer.line_count() - 1);
                editor.col = MED_num.smaller(position.col, editor.buffer.line_size(editor.row));
            }
            case None: {
            }
        }
        start_insert(editor, 105, count, false);
        return true;
    }
    if (second == 118) {
        return did_reselect(editor);
    }
    if (second == 38) {
        editor.ex_queue.push("%s//~/&");
        return true;
    }
    return true;
}

// ---------------------------------------------------------------------- feed

/// Process one key in whatever mode `editor` is in.
pub void feed(MED_editor.Editor editor, int key) {
    editor.is_restart_skip = false;
    feed_key(editor, key);
    try_restart(editor);
    MED_view.update(editor);
}

// Back to Insert mode after the Normal command that CTRL-O allowed (Vim's
// edit() with restart_edit).
pub void try_restart(MED_editor.Editor editor) {
    if (editor.restart_edit == 0 || editor.is_restart_skip || editor.mode != MED_editor.NORMAL || editor.pending.size() > 0) {
        return;
    }
    if (editor.ex_queue.size() > 0 || editor.resume.size() > 0) {
        return;
    }
    bool is_replace = editor.restart_edit == 82;
    str line = editor.buffer.line(editor.row);
    bool is_beyond = false;
    if (editor.col < line.size()) {
        is_beyond = editor.want < 0 || editor.want > MED_text.display_col(line, editor.col, editor.tab);
    }
    start_insert(editor, 105, 1, is_replace);
    editor.is_ins_arrow = true;
    editor.is_ins_restart = true;
    // Insstart is the cursor before it moves past the last character, unless the wanted column forces it
    MED_buffer.Pos start = MED_buffer.Pos(editor.row, editor.col);
    if (editor.col < line.size()) {
        if ((editor.is_ins_at_eol && editor.row == editor.o_lnum) || is_beyond) {
            int next_offset = MED_text.next_col(line, editor.col);
            if (next_offset >= line.size()) {
                editor.col = next_offset;
            }
        }
    }
    editor.is_ins_at_eol = false;
    if (is_beyond) {
        // wanted column past the line: Insstart follows the cursor (checked against nvim)
        start = MED_buffer.Pos(editor.row, editor.col);
    }
    editor.ins_start = start;
    editor.ins_mark = start;
}

void feed_key(MED_editor.Editor editor, int key) {
    if (editor.needs_stale) {
        editor.needs_stale = false;
        editor.want_from_cursor();
    }
    if (editor.macro_reg != "" && !editor.is_replaying) {
        editor.macro_keys.push(key);
    }
    if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE) {
        insert_key(editor, key);
        return;
    }
    if (editor.mode == MED_editor.CMDLINE) {
        cmdline_key(editor, key);
        return;
    }
    if (key == 113 && editor.macro_reg != "" && editor.pending.size() == 0 && (editor.mode == MED_editor.NORMAL || editor.mode == MED_editor.VISUAL)) {
        stop_recording(editor);
        return;
    }
    int cmd_key = key;
    if (key == 63240 && (editor.pending.size() == 0 || (editor.pending[editor.pending.size() - 1] >= 48 && editor.pending[editor.pending.size() - 1] <= 57))) {
        cmd_key = 120;
    }
    editor.pending.push(cmd_key);
    feed_pending(editor);
}

// `q` while recording: the register gets the keys typed since `q{reg}`.
void stop_recording(MED_editor.Editor editor) {
    if (editor.macro_keys.size() > 0) {
        editor.macro_keys.pop();
    }
    str text = MED_key.encode(editor.macro_keys);
    editor.regs.set_named(editor.macro_reg, MED_register.Reg(text.split("\n"), MED_register.CHAR));
    editor.macro_reg = "";
    editor.macro_keys = [];
}

// Parse what is pending and run it once it is a whole command.
void feed_pending(MED_editor.Editor editor) {
    MED_parse.Parsed parsed = MED_parse.parse(editor.pending, editor.mode == MED_editor.VISUAL);
    if (parsed.status == MED_parse.NEED_MORE) {
        return;
    }
    List<int> typed = editor.pending;
    editor.pending = [];
    if (parsed.status == MED_parse.INVALID) {
        if (!(typed.size() > 0 && typed[typed.size() - 1] == 27)) {
            editor.is_failed = true;
        }
        return;
    }
    execute(editor, parsed, typed);
}

pub void feed_keys(MED_editor.Editor editor, List<int> keys) {
    for (int key in keys) {
        feed(editor, key);
    }
}

// Run a whole parsed command; Vim's normal_cmd() ends with checkpcmark().
void execute(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    execute_inner(editor, parsed, typed);
    if (editor.mode != MED_editor.INSERT && editor.mode != MED_editor.REPLACE && editor.mode != MED_editor.CMDLINE) {
        editor.check_pcmark();
    }
}

void execute_inner(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    if (!editor.is_replaying) {
        editor.is_failed = false;
    }
    if (editor.mode == MED_editor.VISUAL) {
        execute_visual(editor, parsed, typed);
        return;
    }
    if (parsed.kind == MED_parse.K_MOTION || parsed.kind == MED_parse.K_OP) {
        if (parsed.keys.size() == 1 && (parsed.keys[0] == 47 || parsed.keys[0] == 63) && !editor.is_search_ready) {
            enter_cmdline(editor, parsed.keys[0], typed);
            return;
        }
    }
    if (parsed.kind == MED_parse.K_MOTION) {
        MED_motion.Motion motion = run_motion(editor, parsed.keys, parsed.count, "");
        if (motion.is_ok) {
            apply_motion(editor, motion);
            if (motion.is_beep) {
                editor.is_failed = true;
            }
        } else {
            editor.is_failed = true;
        }
        return;
    }
    if (parsed.kind == MED_parse.K_OP) {
        str s_reg = editor.dot_reg;
        int s_count = editor.dot_count;
        List<int> s_body = editor.dot_body;
        List<int> s_tail = editor.dot_tail;
        int s_vkind = editor.dot_vkind;
        if (parsed.operator != "y" && parsed.operator != "zf") {
            record_dot(editor, parsed);
        }
        bool is_ok = did_operate(editor, parsed.operator, parsed.reg, parsed.count, parsed.keys, parsed.is_doubled, parsed.force);
        if (!is_ok) {
            editor.is_failed = true;
            if (!editor.is_in_dot) {
                editor.dot_reg = s_reg;
                editor.dot_count = s_count;
                editor.dot_body = s_body;
                editor.dot_tail = s_tail;
                editor.dot_vkind = s_vkind;
            }
        }
        if (editor.mode == MED_editor.NORMAL) {
            editor.end_block();
        }
        return;
    }
    run_cmd(editor, parsed, typed);
    if (editor.mode == MED_editor.NORMAL) {
        editor.end_block();
    }
}

// ------------------------------------------------------------------- Visual

const int MAXCOL = 2000000000;

int vcol_start(MED_editor.Editor editor, int row, int col) {
    return MED_text.display_col(editor.buffer.line(row), col, editor.tab);
}

int vcol_end(MED_editor.Editor editor, int row, int col) {
    str line = editor.buffer.line(row);
    int text = MED_text.display_col(line, col, editor.tab);
    if (col >= line.size()) {
        return text;
    }
    return text + MED_text.cell_width(line, col, text, editor.tab) - 1;
}

bool did_op_on_lines(str operator) {
    return operator == "<" || operator == ">" || operator == "J" || operator == "gJ";
}

// Remember the selection for `gv` and the '< '> marks.
void save_visual(MED_editor.Editor editor, int kind) {
    editor.last_vkind = kind;
    editor.last_vstart = MED_buffer.Pos(editor.vrow, editor.vcol);
    editor.last_vend = MED_buffer.Pos(editor.row, editor.col);
    editor.last_vwant = editor.want;
    MED_buffer.Pos position = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos position_value = MED_buffer.Pos(editor.row, editor.col);
    if (is_position_before(position_value, position)) {
        MED_buffer.Pos position_item = position;
        position = position_value;
        position_value = position_item;
    }
    if (kind == 86) {
        position = MED_buffer.Pos(position.row, 0);
        position_value = MED_buffer.Pos(position_value.row, MAXCOL);
    }
    editor.marks.set("<", position);
    editor.marks.set(">", position_value);
}

// Leave Visual mode, the cursor stays (but never on the NUL).
void leave_visual(MED_editor.Editor editor) {
    save_visual(editor, editor.vkind);
    editor.mode = MED_editor.NORMAL;
    editor.vkind = 0;
    str line = editor.buffer.line(editor.row);
    if (editor.col > 0 && editor.col >= line.size()) {
        editor.col = MED_text.last_col(line);
    }
    editor.clamp();
}

// `.` after a Visual operator: select an area of the same size at the cursor.
void setup_visual_redo(MED_editor.Editor editor) {
    int kind = editor.dot_vkind;
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    editor.vrow = editor.row;
    editor.vcol = editor.col;
    int last = editor.buffer.line_count() - 1;
    int end_row = MED_num.smaller(editor.row + editor.dot_vlines - 1, last);
    int vcols = editor.dot_vcols;
    editor.row = end_row;
    if (kind == 118) {
        int want = vcols;
        if (vcols < MAXCOL && editor.dot_vlines <= 1) {
            want = vcol_start(editor, editor.vrow, editor.vcol) + vcols - 1;
        }
        if (vcols >= MAXCOL) {
            want = -1;
        }
        editor.want = want;
        editor.col = MED_motion.col_for_want(editor.buffer.line(end_row), want, editor.tab, true);
    } else if (vcols >= MAXCOL) {
        editor.want = -1;
        editor.col = MED_motion.col_for_want(editor.buffer.line(end_row), -1, editor.tab, true);
    } else {
        editor.col = MED_num.smaller(editor.col, editor.buffer.line_size(end_row));
    }
    editor.is_visible_redo = true;
}

void enter_visual(MED_editor.Editor editor, int kind) {
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    editor.vrow = editor.row;
    editor.vcol = editor.col;
}

// `gv`: select the previous area again (swapping with the current one).
bool did_reselect(MED_editor.Editor editor) {
    if (editor.last_vkind == 0) {
        return false;
    }
    int kind = editor.last_vkind;
    MED_buffer.Pos position = editor.last_vstart;
    MED_buffer.Pos position_value = editor.last_vend;
    int want = editor.last_vwant;
    if (editor.mode == MED_editor.VISUAL) {
        save_visual(editor, editor.vkind);
    }
    editor.mode = MED_editor.VISUAL;
    editor.vkind = kind;
    int last = editor.buffer.line_count() - 1;
    editor.vrow = MED_num.smaller(position.row, last);
    editor.vcol = MED_num.smaller(position.col, editor.buffer.line_size(editor.vrow));
    editor.row = MED_num.smaller(position_value.row, last);
    editor.col = MED_num.smaller(position_value.col, editor.buffer.line_size(editor.row));
    editor.want = want;
    editor.clamp();
    return true;
}

// The selection as an operator target (Vim's do_pending_operator with
// VIsual_active).
Oap visual_oap(MED_editor.Editor editor, str operator, str reg) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.is_visual = true;
    MED_buffer.Pos position = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos position_value = MED_buffer.Pos(editor.row, editor.col);
    if (editor.vkind == 22) {
        return block_oap(editor, oap);
    }
    if (editor.vkind == 86) {
        position = MED_buffer.Pos(position.row, 0);
    }
    if (is_position_before(position, position_value)) {
        oap.start = position;
        oap.end = position_value;
    } else {
        oap.start = position_value;
        oap.end = position;
    }
    position = oap.start;
    position_value = oap.end;
    oap.line_count = position_value.row - position.row + 1;
    oap.rlines = oap.line_count;
    oap.rvcol = MAXCOL;
    if (editor.want != -1) {
        int end_vcol = vcol_end(editor, position_value.row, position_value.col);
        if (oap.line_count <= 1) {
            oap.rvcol = end_vcol - vcol_start(editor, position.row, position.col) + 1;
        } else {
            oap.rvcol = end_vcol;
        }
    }
    oap.is_inclusive = true;
    if (editor.vkind == 86) {
        oap.is_linewise = true;
        return oap;
    }
    str line = editor.buffer.line(position_value.row);
    if (position_value.col >= line.size()) {
        oap.is_inclusive = false;
        if (!did_op_on_lines(operator) && position_value.row < editor.buffer.line_count() - 1) {
            oap.end = MED_buffer.Pos(position_value.row + 1, 0);
            oap.line_count = oap.line_count + 1;
        }
    }
    bool is_at_nul = oap.end.col >= editor.buffer.line_size(oap.end.row);
    oap.is_empty = oap.start.eq(oap.end) && (!oap.is_inclusive || (operator == "y" && is_at_nul));
    return oap;
}

// The corners of a block selection.
Oap block_oap(MED_editor.Editor editor, Oap oap) {
    int top = MED_num.smaller(editor.vrow, editor.row);
    int bottom = MED_num.larger(editor.vrow, editor.row);
    int start_a = vcol_start(editor, editor.vrow, editor.vcol);
    int end_a = vcol_end(editor, editor.vrow, editor.vcol);
    int start_b = vcol_start(editor, editor.row, editor.col);
    int end_b = vcol_end(editor, editor.row, editor.col);
    int left_vcol = MED_num.smaller(start_a, start_b);
    int right_vcol = MED_num.larger(end_a, end_b);
    bool is_eol = editor.want == -1;
    if (editor.is_visible_redo) {
        left_vcol = start_a;
        is_eol = editor.dot_vcols >= MAXCOL;
        right_vcol = left_vcol + editor.dot_vcols - 1;
    }
    if (is_eol) {
        right_vcol = 0;
        for (int row in top .. bottom + 1) {
            right_vcol = MED_num.larger(right_vcol, MED_text.line_width(editor.buffer.line(row), editor.tab));
        }
    }
    oap.is_block = true;
    oap.left_vcol = left_vcol;
    oap.right_vcol = right_vcol;
    oap.is_eol = is_eol;
    oap.is_inclusive = true;
    oap.line_count = bottom - top + 1;
    oap.rlines = oap.line_count;
    oap.rvcol = right_vcol - left_vcol + 1;
    if (is_eol) {
        oap.rvcol = MAXCOL;
    }
    oap.start = MED_buffer.Pos(top, MED_motion.col_for_want(editor.buffer.line(top), left_vcol, editor.tab, true));
    oap.end = MED_buffer.Pos(bottom, MED_motion.col_for_want(editor.buffer.line(bottom), right_vcol, editor.tab, true));
    return oap;
}

/// How one line meets a block: the bytes of the characters it overlaps, the
/// columns of a split character that fall outside the block, and the text a
/// yank takes (a split character becomes spaces).
type BlockCut {
    bool is_too_short = false;
    bool is_ends_inside = false;
    int from = 0;
    int target_position = 0;
    int pre = 0;
    int post = 0;
    int last_width = 0;
    str text = "";
}

BlockCut block_cut(MED_editor.Editor editor, str line, int left_vcol, int right_vcol, bool is_eol) {
    BlockCut block_cut_value = BlockCut();
    int position = 0;
    int vcol = 0;
    bool is_found = false;
    List<str> parts = [];
    while (position < line.size()) {
        int next = MED_text.next_col(line, position);
        int width = MED_text.cell_width(line, position, vcol, editor.tab);
        int first_char = vcol;
        int second_char = vcol + width - 1;
        if (!is_eol && first_char > right_vcol) {
            break;
        }
        if (second_char >= left_vcol) {
            if (!is_found) {
                is_found = true;
                block_cut_value.from = position;
                if (first_char < left_vcol) {
                    block_cut_value.pre = left_vcol - first_char;
                }
            }
            block_cut_value.target_position = next;
            block_cut_value.post = 0;
            if (!is_eol && second_char > right_vcol) {
                block_cut_value.post = second_char - right_vcol;
            }
            if (first_char >= left_vcol && (is_eol || second_char <= right_vcol)) {
                parts.push(line.substr(position, next));
            } else {
                int low = MED_num.larger(first_char, left_vcol);
                int high = second_char;
                if (!is_eol) {
                    high = MED_num.smaller(second_char, right_vcol);
                }
                parts.push(" ".repeat(high - low + 1));
            }
        }
        vcol = vcol + width;
        position = next;
    }
    block_cut_value.last_width = MED_text.line_width(line, editor.tab);
    if (!is_found) {
        block_cut_value.is_too_short = true;
        block_cut_value.from = line.size();
        block_cut_value.target_position = line.size();
    }
    block_cut_value.is_ends_inside = !is_eol && block_cut_value.last_width <= right_vcol;
    block_cut_value.text = parts.join("");
    return block_cut_value;
}

MED_register.Reg block_reg(MED_editor.Editor editor, Oap oap) {
    List<str> lines = [];
    for (int row in oap.start.row .. oap.end.row + 1) {
        BlockCut block_cut_value = block_cut(editor, editor.buffer.line(row), oap.left_vcol, oap.right_vcol, oap.is_eol);
        lines.push(block_cut_value.text);
    }
    MED_register.Reg reg = MED_register.Reg(lines, MED_register.BLOCK);
    if (oap.is_eol) {
        reg.width = 1;
        if (oap.right_vcol - oap.left_vcol > 0) {
            reg.width = oap.right_vcol - oap.left_vcol;
        }
    } else {
        reg.width = oap.right_vcol - oap.left_vcol + 1;
    }
    return reg;
}

void block_delete(MED_editor.Editor editor, Oap oap) {
    MED_register.Reg reg = block_reg(editor, oap);
    editor.regs.delete(oap.reg, reg, oap.line_count > 1, oap.line_count == 1);
    int first_col = oap.start.col;
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        BlockCut block_cut_value = block_cut(editor, editor.buffer.line(row), oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short || block_cut_value.target_position <= block_cut_value.from) {
            continue;
        }
        if (row == oap.start.row) {
            first_col = block_cut_value.from + block_cut_value.pre;
        }
        editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), " ".repeat(block_cut_value.pre + block_cut_value.post));
    }
    editor.row = oap.start.row;
    editor.col = first_col;
}

void block_case(MED_editor.Editor editor, Oap oap) {
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short || block_cut_value.target_position <= block_cut_value.from) {
            continue;
        }
        str text = line.substr(block_cut_value.from, block_cut_value.target_position);
        str mapped = map_case(text, oap.operator);
        if (mapped != text) {
            editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), mapped);
        }
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

// `r{char}` over a block.
void block_replace(MED_editor.Editor editor, Oap oap, int code_point) {
    str character = str.from_chars([code_point]);
    int char_width = MED_text.cell_width(character, 0, 0, editor.tab);
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
        if (block_cut_value.is_too_short) {
            continue;
        }
        int numc = oap.right_vcol - oap.left_vcol + 1;
        bool is_short_end = oap.is_eol || block_cut_value.last_width <= oap.right_vcol;
        if (is_short_end) {
            numc = block_cut_value.last_width - oap.left_vcol;
        }
        int post = block_cut_value.post;
        if (char_width > 1) {
            if (numc % 2 == 1 && !is_short_end) {
                post = post + 1;
            }
            numc = numc / 2;
        }
        str fresh = " ".repeat(block_cut_value.pre) + character.repeat(numc) + " ".repeat(post);
        editor.change(MED_buffer.Pos(row, block_cut_value.from), MED_buffer.Pos(row, block_cut_value.target_position), fresh);
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

bool is_blank_byte(int right) {
    return right == 32 || right == 9;
}

// Vim's shift_block for one line.
void block_shift_line(MED_editor.Editor editor, Oap oap, int row, bool is_left) {
    str line = editor.buffer.line(row);
    if (line.size() == 0) {
        return;
    }
    BlockCut block_cut_value = block_cut(editor, line, oap.left_vcol, oap.right_vcol, oap.is_eol);
    if (block_cut_value.is_too_short || (!is_left && false)) {
        return;
    }
    int total = oap.amount * editor.shiftwidth;
    int from = block_cut_value.from;
    if (block_cut_value.pre > 0) {
        // the block starts inside a character: continue after it
        from = block_cut_value.target_position;
        if (from > line.size()) {
            from = line.size();
        }
    }
    int start_vcol = MED_text.display_col(line, from, editor.tab);
    if (!is_left) {
        int pre_c = 0;
        int back = from;
        while (back > 0 && is_blank_byte(line.byte_at(back - 1))) {
            back = back - 1;
            pre_c = pre_c + 1;
        }
        int ws_vcol = MED_text.display_col(line, back, editor.tab);
        total = total + (start_vcol - ws_vcol);
        int offset = from;
        int vcol = start_vcol;
        while (offset < line.size() && is_blank_byte(line.byte_at(offset))) {
            int width = MED_text.cell_width(line, offset, vcol, editor.tab);
            total = total + width;
            vcol = vcol + width;
            offset = offset + 1;
        }
        int tabs = 0;
        int spaces = total;
        if (!editor.is_expandtab) {
            int end_col = ws_vcol + total;
            tabs = end_col / editor.tab - ws_vcol / editor.tab;
            if (tabs == 0) {
                spaces = end_col - ws_vcol;
            } else {
                spaces = end_col % editor.tab;
            }
        }
        str fresh = line.substr(0, back) + "\t".repeat(tabs) + " ".repeat(spaces) + line.substr(offset, line.size());
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), fresh);
        return;
    }
    int walker = from;
    int non_white_col = start_vcol;
    while (walker < line.size() && is_blank_byte(line.byte_at(walker))) {
        non_white_col = non_white_col + MED_text.cell_width(line, walker, non_white_col, editor.tab);
        walker = walker + 1;
    }
    int block_space = non_white_col - oap.left_vcol;
    int shift_amount = MED_num.smaller(block_space, total);
    int dest = non_white_col - shift_amount;
    int verb_end = from;
    int verb_width = start_vcol;
    if (block_cut_value.pre > 0) {
        verb_end = block_cut_value.from;
        verb_width = MED_text.display_col(line, block_cut_value.from, editor.tab);
    }
    while (verb_width < dest && verb_end < line.size()) {
        int incr = MED_text.cell_width(line, verb_end, verb_width, editor.tab);
        if (verb_width + incr > dest) {
            break;
        }
        verb_width = verb_width + incr;
        verb_end = MED_text.next_col(line, verb_end);
    }
    int fill = dest - verb_width;
    str fresh = line.substr(0, verb_end) + " ".repeat(fill) + line.substr(walker, line.size());
    if (fresh != line) {
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), fresh);
    }
}

void block_shift(MED_editor.Editor editor, Oap oap) {
    touch_at(editor, oap.start);
    for (int row in oap.start.row .. oap.end.row + 1) {
        block_shift_line(editor, oap, row, oap.operator == "<");
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
}

void touch_at(MED_editor.Editor editor, MED_buffer.Pos position) {
    editor.change(position, position, "");
}

// Vim's op_replace for a charwise or linewise Visual area.
void visual_replace(MED_editor.Editor editor, Oap oap, int code_point) {
    touch_at(editor, oap.start);
    str one = str.from_chars([code_point]);
    for (int row in oap.start.row .. oap.end.row + 1) {
        str line = editor.buffer.line(row);
        int first_char = 0;
        int second_char = line.size();
        if (!oap.is_linewise) {
            if (row == oap.start.row) {
                first_char = oap.start.col;
            }
            if (row == oap.end.row) {
                second_char = oap.end.col;
                if (oap.is_inclusive && second_char < line.size()) {
                    second_char = MED_text.next_col(line, second_char);
                }
            }
        }
        if (first_char >= second_char || first_char >= line.size()) {
            continue;
        }
        List<int> starts = [];
        int spot = first_char;
        int count = 0;
        while (spot < second_char && spot < line.size()) {
            spot = MED_text.next_col(line, spot);
            count = count + 1;
        }
        editor.change(MED_buffer.Pos(row, first_char), MED_buffer.Pos(row, spot), one.repeat(count));
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    if (oap.is_linewise) {
        editor.col = 0;
    }
}

// Remember the finished Visual operation for `.`.
void record_visual_dot(MED_editor.Editor editor, Oap oap, int kind, int count, List<int> body) {
    if (editor.is_in_dot) {
        return;
    }
    editor.dot_reg = oap.reg;
    editor.dot_count = count;
    editor.dot_body = body;
    editor.dot_tail = [];
    editor.dot_vkind = kind;
    editor.dot_vlines = oap.rlines;
    editor.dot_vcols = oap.rvcol;
}

// An operator on the Visual area (Vim's do_pending_operator with VIsual_active).
// `kind` is the selection kind the operator acts on (D, X, Y, S turn it into V).
// The operator name for Visual `<C-a>` (1) / `<C-x>` (24), with `is_group` or not.
str nr_op(int key, bool is_group) {
    str name = "nra";
    if (key == 24) {
        name = "nrx";
    }
    if (is_group) {
        return "g" + name;
    }
    return name;
}

// `<C-a>` / `<C-x>`: add to the number at or after the cursor.
bool did_cmd_addsub(MED_editor.Editor editor, bool is_sub, int count) {
    str line = editor.buffer.line(editor.row);
    MED_nrfmt.NrResult nr_result = MED_nrfmt.addsub(line, editor.col, 0, is_sub, count1(count), false, 0, editor.is_hexupper);
    if (!nr_result.is_changed) {
        // Vim saves the line for undo before it looks for a number
        editor.noop_node();
        return false;
    }
    editor.is_hexupper = nr_result.is_hexupper;
    editor.change(MED_buffer.Pos(editor.row, nr_result.from), MED_buffer.Pos(editor.row, nr_result.target_position), nr_result.text);
    editor.col = nr_result.endcol;
    editor.marks.set("[", MED_buffer.Pos(editor.row, nr_result.startcol));
    editor.marks.set("]", MED_buffer.Pos(editor.row, nr_result.endcol));
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

// Visual `<C-a>`, `<C-x>`, `g<C-a>`, `g<C-x>`: every line of the selection.
bool did_visual_addsub(MED_editor.Editor editor, Oap oap, bool is_sub, bool is_progressive) {
    int step = oap.amount;
    int amount = oap.amount;
    int changes = 0;
    MED_buffer.Pos endp = copy_position(oap.end);
    MED_buffer.Pos first = MED_buffer.Pos(0, 0);
    MED_buffer.Pos last = MED_buffer.Pos(0, 0);
    if (!oap.is_block && !oap.is_linewise && !oap.is_inclusive) {
        // Vim steps the end back once, before the first line (and so may drop the last line)
        if (endp.col > 0) {
            endp = MED_buffer.Pos(endp.row, MED_text.previous_col(editor.buffer.line(endp.row), endp.col));
        } else if (endp.row > 0) {
            endp = MED_buffer.Pos(endp.row - 1, editor.buffer.line_size(endp.row - 1));
        }
    }
    int last_row = oap.end.row;
    if (!oap.is_block && !oap.is_linewise) {
        last_row = endp.row;
    }
    for (int row in oap.start.row .. last_row + 1) {
        str line = editor.buffer.line(row);
        int col = 0;
        int length = 0;
        int mode = 1;
        if (oap.is_block) {
            BlockPrep block_prep_value = block_prep(editor, "", oap.left_vcol, oap.right_vcol, row, false);
            col = block_prep_value.textcol;
            length = block_prep_value.textlen;
            if (oap.is_eol) {
                mode = 2;
            }
        } else if (oap.is_linewise) {
            length = line.size();
            mode = 0;
        } else {
            length = line.size();
            if (row == oap.start.row) {
                col = oap.start.col;
                length = length - oap.start.col;
            }
            if (row == endp.row) {
                int ecol = endp.col;
                if (ecol >= line.size()) {
                    ecol = line.size() - 1;
                }
                length = ecol - col + 1;
            }
            if (editor.want == -1 && oap.is_visual) {
                mode = 2;
            }
        }
        MED_nrfmt.NrResult nr_result = MED_nrfmt.addsub(line, col, length, is_sub, amount, true, mode, editor.is_hexupper);
        if (nr_result.is_changed) {
            editor.is_hexupper = nr_result.is_hexupper;
            editor.change(MED_buffer.Pos(row, nr_result.from), MED_buffer.Pos(row, nr_result.target_position), nr_result.text);
            if (changes == 0) {
                first = MED_buffer.Pos(row, nr_result.startcol);
            }
            last = MED_buffer.Pos(row, nr_result.endcol);
            changes = changes + 1;
            if (is_progressive) {
                amount = amount + step;
            }
        }
    }
    if (changes > 0) {
        editor.marks.set("[", first);
        editor.marks.set("]", last);
    } else {
        editor.noop_node();
    }
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    return true;
}

void visual_operator(MED_editor.Editor editor, str operator, str reg, int count, List<int> body, int kind, int shown_kind) {
    int saved_kind = editor.vkind;
    editor.vkind = kind;
    Oap oap = visual_oap(editor, operator, reg);
    editor.vkind = saved_kind;
    editor.is_visible_redo = false;
    oap.amount = count1(count);
    int nchar = 0;
    if (operator == "r") {
        nchar = body[body.size() - 1];
    }
    if (operator != "y") {
        record_visual_dot(editor, oap, kind, count, body);
    }
    // gv remembers the mode the user had, the marks the real selection
    save_visual(editor, shown_kind);
    editor.mode = MED_editor.NORMAL;
    editor.vkind = 0;
    editor.row = oap.start.row;
    editor.col = oap.start.col;
    bool is_ok = true;
    if (operator == "J" || operator == "gJ") {
        int total = MED_num.larger(oap.line_count, 2);
        if (oap.start.row + total > editor.buffer.line_count()) {
            editor.is_failed = true;
        } else {
            did_do_join(editor, oap.start.row, total, operator == "J");
            editor.clamp();
            editor.want_from_cursor();
        }
    } else if (operator == "r") {
        if (oap.is_block) {
            block_replace(editor, oap, nchar);
        } else {
            visual_replace(editor, oap, nchar);
        }
        editor.clamp();
        editor.want_from_cursor();
    } else if (operator.starts_with("nr") || operator.starts_with("gnr")) {
        is_ok = did_visual_addsub(editor, oap, operator.ends_with("x"), operator.starts_with("g"));
        editor.clamp();
        editor.want_from_cursor();
    } else if (oap.is_block) {
        is_ok = did_block_operator(editor, oap);
    } else if (operator == "I" || operator == "A") {
        is_ok = did_visual_insert(editor, oap);
    } else {
        is_ok = did_run_op(editor, oap);
    }
    if (!is_ok) {
        editor.is_failed = true;
    }
    if (operator == "y") {
        editor.want_from_cursor();
    }
    if (editor.mode == MED_editor.NORMAL) {
        editor.end_block();
    }
}

/// Vim's block_def: how one line meets a block, for I, A and c.
type BlockPrep {
    int startspaces = 0;
    int endspaces = 0;
    int textlen = 0;
    int start_vcol = 0;
    int end_vcol = 0;
    bool is_short = false;
    bool is_one_char = false;
    int start_char_vcols = 0;
    int end_char_vcols = 0;
    int textcol = 0;
}

// Vim's block_prep, for the operator `operator` ("I", "A", "c", "r", "<") on the
// block `left_vcol`..`right_vcol`.
BlockPrep block_prep(MED_editor.Editor editor, str operator, int left_vcol, int right_vcol, int row, bool is_del) {
    BlockPrep block_prep_value = BlockPrep();
    str line = editor.buffer.line(row);
    int position = 0;
    int vcol = 0;
    int incr = 0;
    int previous_pstart = 0;
    while (vcol < left_vcol && position < line.size()) {
        incr = MED_text.cell_width(line, position, vcol, editor.tab);
        vcol = vcol + incr;
        previous_pstart = position;
        position = MED_text.next_col(line, position);
    }
    block_prep_value.start_vcol = vcol;
    int pstart = position;
    block_prep_value.start_char_vcols = incr;
    if (block_prep_value.start_vcol < left_vcol) {
        block_prep_value.end_vcol = block_prep_value.start_vcol;
        block_prep_value.is_short = true;
        if (!is_del || operator == "A") {
            block_prep_value.endspaces = right_vcol - left_vcol + 1;
        }
    } else {
        block_prep_value.startspaces = block_prep_value.start_vcol - left_vcol;
        if (is_del && block_prep_value.startspaces != 0) {
            block_prep_value.startspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
        }
        int pend = pstart;
        block_prep_value.end_vcol = block_prep_value.start_vcol;
        if (block_prep_value.end_vcol > right_vcol) {
            block_prep_value.is_one_char = true;
            if (operator == "I") {
                block_prep_value.endspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
            } else if (operator == "A") {
                block_prep_value.startspaces = block_prep_value.startspaces + right_vcol - left_vcol + 1;
                block_prep_value.endspaces = block_prep_value.start_char_vcols - block_prep_value.startspaces;
            } else {
                block_prep_value.startspaces = right_vcol - left_vcol + 1;
                if (is_del && operator != "<") {
                    block_prep_value.startspaces = block_prep_value.start_char_vcols - (block_prep_value.start_vcol - left_vcol);
                    block_prep_value.endspaces = block_prep_value.end_vcol - right_vcol - 1;
                }
            }
        } else {
            int previous_pend = pend;
            int value = block_prep_value.end_vcol;
            int offset = pend;
            while (value <= right_vcol && offset < line.size()) {
                previous_pend = offset;
                incr = MED_text.cell_width(line, offset, value, editor.tab);
                value = value + incr;
                offset = MED_text.next_col(line, offset);
            }
            block_prep_value.end_vcol = value;
            pend = offset;
            if (block_prep_value.end_vcol <= right_vcol && (!is_del || operator == "A" || operator == "r")) {
                block_prep_value.is_short = true;
                if (operator == "A") {
                    block_prep_value.endspaces = right_vcol - block_prep_value.end_vcol + 1;
                } else {
                    block_prep_value.endspaces = 0;
                }
            } else if (block_prep_value.end_vcol > right_vcol) {
                block_prep_value.endspaces = block_prep_value.end_vcol - right_vcol - 1;
                if (!is_del && block_prep_value.endspaces != 0) {
                    block_prep_value.endspaces = incr - block_prep_value.endspaces;
                    if (pend != pstart) {
                        pend = previous_pend;
                    }
                }
            }
        }
        block_prep_value.end_char_vcols = incr;
        if (is_del && block_prep_value.startspaces != 0) {
            pstart = previous_pstart;
        }
        block_prep_value.textlen = pend - pstart;
    }
    block_prep_value.textcol = pstart;
    return block_prep_value;
}

// Vim's block_insert: copy `text` into every line below `top` of the block.
void block_insert(MED_editor.Editor editor, int top, int bottom, int left_vcol, int right_vcol, bool is_max, bool is_b_insert, str text) {
    str operator = "A";
    if (is_b_insert) {
        operator = "I";
    }
    for (int row in top + 1 .. bottom + 1) {
        BlockPrep block_prep_value = block_prep(editor, operator, left_vcol, right_vcol, row, true);
        if (block_prep_value.is_short && is_b_insert) {
            continue;
        }
        str old = editor.buffer.line(row);
        int ts_value = 0;
        int spaces = 0;
        int offset = 0;
        if (is_b_insert) {
            ts_value = block_prep_value.start_char_vcols;
            spaces = block_prep_value.startspaces;
            offset = block_prep_value.textcol;
        } else {
            ts_value = block_prep_value.end_char_vcols;
            if (!block_prep_value.is_short) {
                if (block_prep_value.endspaces != 0) {
                    spaces = ts_value - block_prep_value.endspaces;
                }
                offset = block_prep_value.textcol + block_prep_value.textlen;
                if (spaces != 0) {
                    offset = offset - 1;
                }
            } else {
                if (!is_max) {
                    spaces = right_vcol - block_prep_value.end_vcol + 1;
                }
                offset = block_prep_value.textcol + block_prep_value.textlen;
            }
        }
        if (spaces < 0) {
            spaces = 0;
        }
        if (offset > old.size()) {
            offset = old.size();
        }
        str rest = old.substr(offset, old.size());
        str post = "";
        if (spaces > 0 && !block_prep_value.is_short && rest.size() > 0 && rest.byte_at(0) == 9) {
            post = " ".repeat(ts_value - spaces);
            rest = rest.substr(1, rest.size());
        }
        editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, old.size()), old.substr(0, offset) + " ".repeat(spaces) + text + post + rest);
    }
}

int white_bytes(str line) {
    int index = 0;
    while (index < line.size() && (line.byte_at(index) == 32 || line.byte_at(index) == 9)) {
        index = index + 1;
    }
    return index;
}

// Start of a block-wise I, A or c: remember what the end of the insert needs.
void block_insert_begin(MED_editor.Editor editor, Oap oap, int count) {
    str operator = oap.operator;
    BlockPrep block_prep_value = block_prep(editor, operator, oap.left_vcol, oap.right_vcol, oap.start.row, true);
    str line = editor.buffer.line(oap.start.row);
    int spot = block_prep_value.textcol;
    if (operator == "A") {
        spot = spot + block_prep_value.textlen;
    }
    editor.blk_pre_length = line.size() - MED_num.smaller(spot, line.size());
    editor.blk_ind_col = white_bytes(line);
    editor.blk_ind_vcol = MED_text.line_width(line.substr(0, editor.blk_ind_col), editor.tab);
    editor.blk_col = block_prep_value.textcol;
    editor.blk_tail = block_prep_value.textlen;
    editor.blk_op = 73;
    if (operator == "A") {
        editor.blk_op = 65;
        int col = oap.start.col;
        while (col < line.size() && col < block_prep_value.textcol + block_prep_value.textlen) {
            col = col + 1;
        }
        editor.col = col;
        if (block_prep_value.is_short && !oap.is_eol) {
            editor.change(MED_buffer.Pos(editor.row, col), MED_buffer.Pos(editor.row, col), " ".repeat(block_prep_value.endspaces));
            editor.col = col + block_prep_value.endspaces;
            editor.blk_tail = block_prep_value.textlen + block_prep_value.endspaces;
        }
    }
    editor.blk_top = oap.start.row;
    editor.blk_bottom = oap.end.row;
    editor.blk_sv = oap.left_vcol;
    editor.blk_ev = oap.right_vcol;
    editor.is_blk_eol = oap.is_eol;
    editor.blk_start_col = oap.start.col;
    start_insert(editor, 105, count, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_mark = editor.ins_start;
}

// Vim's op_change for a block: delete it, then insert on the first line.
bool did_block_change(MED_editor.Editor editor, Oap oap) {
    int start_col = oap.start.col;
    block_delete(editor, oap);
    editor.clamp();
    str line = editor.buffer.line(editor.row);
    if (start_col > editor.col && line.size() > 0) {
        editor.col = MED_text.next_col(line, editor.col);
    }
    editor.blk_pre_length = line.size();
    editor.blk_ind_col = white_bytes(line);
    editor.blk_ind_vcol = 0;
    editor.blk_col = editor.col;
    editor.blk_op = 99;
    editor.blk_top = oap.start.row;
    editor.blk_bottom = oap.end.row;
    editor.blk_sv = oap.left_vcol;
    editor.blk_ev = oap.right_vcol;
    editor.is_blk_eol = oap.is_eol;
    editor.blk_start_col = oap.start.col;
    start_insert(editor, 99, 1, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_mark = editor.ins_start;
    return true;
}

// The insert that began with block_insert_begin / block_change has ended.
void block_insert_end(MED_editor.Editor editor) {
    int op_code = editor.blk_op;
    editor.blk_op = 0;
    int top = editor.blk_top;
    int bottom = editor.blk_bottom;
    if (editor.row != top || (op_code == 99 && top == bottom)) {
        return;
    }
    str line = editor.buffer.line(top);
    if (op_code == 99) {
        int textcol = editor.blk_col;
        int pre_length = editor.blk_pre_length;
        if (textcol > editor.blk_ind_col) {
            int new_indent = white_bytes(line);
            pre_length = pre_length + new_indent - editor.blk_ind_col;
            textcol = textcol + new_indent - editor.blk_ind_col;
        }
        int ins_length = line.size() - pre_length;
        if (ins_length > 0 && textcol + ins_length <= line.size()) {
            str text = line.substr(textcol, textcol + ins_length);
            for (int row in top + 1 .. bottom + 1) {
                BlockPrep block_prep_value = block_prep(editor, "c", editor.blk_sv, editor.blk_ev, row, true);
                if (!block_prep_value.is_short) {
                    str old = editor.buffer.line(row);
                    editor.change(MED_buffer.Pos(row, block_prep_value.textcol), MED_buffer.Pos(row, block_prep_value.textcol), text);
                }
            }
            editor.clamp();
        }
        return;
    }
    bool is_max = editor.is_blk_eol;
    int left_vcol = editor.blk_sv;
    int right_vcol = editor.blk_ev;
    int start_col = editor.blk_start_col;
    int pre_length = editor.blk_pre_length;
    int textcol = editor.blk_col;
    int textlen = editor.blk_tail;
    str mode = "I";
    if (op_code == 65) {
        mode = "A";
    }
    int ind_post = white_bytes(line);
    bool did_indent = false;
    if (editor.ins_start.col > editor.blk_ind_col && ind_post > editor.blk_ind_col) {
        textcol = textcol + ind_post - editor.blk_ind_col;
        did_indent = true;
    }
    if (editor.ins_start.row == top && !is_max && !did_indent) {
        int target = MED_text.display_col(line, MED_num.smaller(editor.ins_start.col, line.size()), editor.tab);
        if (mode == "I" && start_col != editor.ins_start.col) {
            start_col = editor.ins_start.col;
            pre_length = pre_length - (target - left_vcol);
            left_vcol = target;
        } else if (mode == "A" && start_col >= editor.ins_start.col) {
            start_col = editor.ins_start.col;
            pre_length = pre_length + textlen - (target - left_vcol);
            left_vcol = target;
            mode = "I";
        }
    }
    BlockPrep bd2 = block_prep(editor, mode, left_vcol, right_vcol, top, true);
    if (!is_max || bd2.textlen < textlen) {
        if (mode == "A") {
            pre_length = pre_length + bd2.textlen - textlen;
            if (bd2.endspaces != 0) {
                bd2.textlen = bd2.textlen - 1;
            }
        }
        textcol = bd2.textcol;
        textlen = bd2.textlen;
    }
    int add = textcol;
    if (mode == "A") {
        add = add + textlen;
    }
    if (add > line.size()) {
        add = line.size();
    }
    int ins_length = line.size() - add - pre_length;
    if (pre_length >= 0 && ins_length > 0) {
        str text = line.substr(add, add + ins_length);
        block_insert(editor, top, bottom, left_vcol, right_vcol, is_max, mode == "I", text);
        editor.marks.set("]", MED_buffer.Pos(bottom, editor.marks.get("]").or(MED_buffer.Pos(0, 0)).col));
        editor.col = start_col;
        editor.clamp();
    }
}

// I and A on a Visual area that is not a block: insert at the start of the
// first line / after the end.
bool did_visual_insert(MED_editor.Editor editor, Oap oap) {
    if (oap.operator == "I") {
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        if (oap.is_linewise) {
            editor.col = 0;
        }
    } else {
        editor.row = oap.end.row;
        editor.col = oap.end.col;
        editor.clamp();
        str line = editor.buffer.line(editor.row);
        if (line.size() > 0) {
            editor.col = MED_text.next_col(line, editor.col);
        }
    }
    start_insert(editor, 105, oap.amount, false);
    editor.clamp();
    editor.ins_start = MED_buffer.Pos(editor.row, editor.col);
    editor.ins_mark = editor.ins_start;
    return true;
}

// Block-wise operators other than r.
bool did_block_operator(MED_editor.Editor editor, Oap oap) {
    str operator = oap.operator;
    if (operator == "y") {
        editor.regs.yank(oap.reg, block_reg(editor, oap));
        set_op_marks(editor, oap.start, oap.end);
        editor.row = oap.start.row;
        editor.col = oap.start.col;
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "d") {
        if (oap.line_count == 1 && editor.buffer.line_size(oap.start.row) == 0) {
            // Vim's "delete in an empty line" check also covers a one-line block.
            touch_at(editor, oap.start);
            editor.row = oap.start.row;
            editor.col = 0;
            return true;
        }
        block_delete(editor, oap);
        set_op_marks(editor, oap.start, MED_buffer.Pos(oap.end.row, oap.start.col));
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "c") {
        return did_block_change(editor, oap);
    }
    if (operator == "I" || operator == "A") {
        block_insert_begin(editor, oap, oap.amount);
        return true;
    }
    if (operator == "<" || operator == ">") {
        block_shift(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    if (operator == "g~" || operator == "gu" || operator == "gU" || operator == "g?") {
        block_case(editor, oap);
        editor.clamp();
        editor.want_from_cursor();
        return true;
    }
    return false;
}

const List<int> BLOCK_OBJECTS = [98, 40, 41, 66, 123, 125, 91, 93, 60, 62, 116];

void visual_object(MED_editor.Editor editor, MED_parse.Parsed parsed) {
    List<int> keys = parsed.keys;
    MED_buffer.Pos cursor = MED_buffer.Pos(editor.row, editor.col);
    MED_buffer.Pos anchor = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_textobj.Sel sel = MED_textobj.select(editor.buffer, cursor, true, anchor, editor.vkind, keys[1], keys[0] == 97, parsed.count);
    if (!sel.is_ok) {
        if (sel.is_moved) {
            editor.row = sel.end.row;
            editor.col = sel.end.col;
            editor.clamp();
        }
        editor.want_from_cursor();
        editor.is_failed = true;
        return;
    }
    editor.vrow = sel.start.row;
    editor.vcol = sel.start.col;
    editor.row = sel.end.row;
    editor.col = sel.end.col;
    if (sel.vmode >= 0 && !(editor.vkind == 22 && sel.vmode == 118 && !BLOCK_OBJECTS.contains(keys[1]))) {
        editor.vkind = sel.vmode;
    }
    if (sel.is_jump) {
        pcmark(editor, cursor);
    }
    editor.clamp();
    editor.want_from_cursor();
}

void visual_swap(MED_editor.Editor editor, bool is_corner) {
    if (is_corner && editor.vkind == 22) {
        MED_buffer.Pos old = MED_buffer.Pos(editor.row, editor.col);
        int first_start = vcol_start(editor, editor.row, editor.col);
        int first_end = vcol_end(editor, editor.row, editor.col);
        int other_start = vcol_start(editor, editor.vrow, editor.vcol);
        int second_end = vcol_end(editor, editor.vrow, editor.vcol);
        int left = MED_num.smaller(first_start, other_start);
        int right = MED_num.larger(first_end, second_end);
        editor.vrow = editor.vrow;
        editor.vcol = MED_motion.col_for_want(editor.buffer.line(editor.vrow), left, editor.tab, true);
        editor.row = old.row;
        editor.col = MED_motion.col_for_want(editor.buffer.line(old.row), right, editor.tab, true);
        editor.want = right;
        if (editor.col == old.col) {
            editor.vcol = MED_motion.col_for_want(editor.buffer.line(editor.vrow), right, editor.tab, true);
            editor.col = MED_motion.col_for_want(editor.buffer.line(old.row), left, editor.tab, true);
            editor.want = left;
        }
        return;
    }
    int result = editor.row;
    int char_code = editor.col;
    editor.row = editor.vrow;
    editor.col = editor.vcol;
    editor.vrow = result;
    editor.vcol = char_code;
    editor.want_from_cursor();
}

void execute_visual(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    if (parsed.kind == MED_parse.K_MOTION) {
        if (parsed.keys.size() == 1 && (parsed.keys[0] == 47 || parsed.keys[0] == 63) && !editor.is_search_ready) {
            enter_cmdline(editor, parsed.keys[0], typed);
            return;
        }
        MED_motion.Motion motion = run_motion(editor, parsed.keys, parsed.count, "");
        if (motion.is_ok) {
            apply_motion(editor, motion);
            if (motion.is_beep) {
                editor.is_failed = true;
            }
        } else {
            editor.is_failed = true;
        }
        return;
    }
    if (parsed.kind == MED_parse.K_OBJECT) {
        visual_object(editor, parsed);
        return;
    }
    visual_cmd(editor, parsed, typed);
}

// `parsed` / `P` / `gp` / `gP` in Visual mode: the register replaces the selection.
void visual_put(MED_editor.Editor editor, MED_parse.Parsed parsed, bool is_keep, bool is_back, bool is_cursor_end) {
    int kind = editor.vkind;
    str regname = parsed.reg;
    Option<MED_register.Reg> found = editor.regs.get(regname);
    Oap area = visual_oap(editor, "d", regname);
    MED_buffer.Pos op_start = area.start;
    int dir0 = 1;
    if (is_back) {
        dir0 = -1;
    }
    str del_reg = regname;
    if (is_keep) {
        del_reg = "_";
    } else {
        del_reg = "";
    }
    visual_operator(editor, "d", del_reg, 0, [100], kind, kind);
    bool is_empty = editor.buffer.is_empty;
    int directory = -1;
    if ((kind != 86 && editor.col < op_start.col) || (kind == 86 && editor.row < op_start.row)) {
        directory = 1;
    }
    int flags = 0;
    if (kind == 86) {
        flags = PUT_LINE;
    } else if (kind == 118) {
        flags = PUT_LINE_SPLIT;
    } else if (dir0 > 0) {
        flags = PUT_LINE_FORWARD;
    }
    match (found) {
        case None: {
            editor.is_failed = true;
        }
        case Some(MED_register.Reg reg): {
            did_put_reg(editor, reg, directory, parsed.count, is_cursor_end, flags, editor.last_vend.row);
        }
    }
    int last = editor.buffer.line_count() - 1;
    if (is_empty && last > 0 && editor.buffer.line(last) == "") {
        editor.change(MED_buffer.Pos(last - 1, editor.buffer.line_size(last - 1)), MED_buffer.Pos(last, 0), "");
        last = last - 1;
        if (editor.row > last) {
            editor.row = last;
            editor.col = MED_text.last_col(editor.buffer.line(last));
        }
    }
    editor.clamp();
    editor.want_from_cursor();
}

void visual_cmd(MED_editor.Editor editor, MED_parse.Parsed parsed, List<int> typed) {
    int key = parsed.keys[0];
    int kind = editor.vkind;
    str reg = parsed.reg;
    if (is_view_key(key)) {
        if (!did_view_cmd(editor, parsed)) {
            editor.is_failed = true;
        }
        return;
    }
    if (key == 27 || key == 3) {
        leave_visual(editor);
    } else if (key == 118 || key == 86 || key == 22) {
        if (kind == key) {
            leave_visual(editor);
        } else {
            editor.vkind = key;
        }
    } else if (key == 111) {
        visual_swap(editor, false);
    } else if (key == 79) {
        visual_swap(editor, true);
    } else if (key == 100 || key == 120 || key == 63240) {
        visual_operator(editor, "d", reg, parsed.count, [100], kind, kind);
    } else if (key == 68 || key == 88) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
            if (key == 68) {
                editor.want = -1;
            }
        }
        visual_operator(editor, "d", reg, parsed.count, [key], next_key, kind);
    } else if (key == 121) {
        visual_operator(editor, "y", reg, parsed.count, [121], kind, kind);
    } else if (key == 89) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
        }
        visual_operator(editor, "y", reg, parsed.count, [89], next_key, kind);
    } else if (key == 99 || key == 115) {
        visual_operator(editor, "c", reg, parsed.count, [key], kind, kind);
    } else if (key == 67) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
            editor.want = -1;
        }
        visual_operator(editor, "c", reg, parsed.count, [key], next_key, kind);
    } else if (key == 73 || key == 65) {
        int next_key = 86;
        if (kind == 22) {
            next_key = 22;
        }
        visual_operator(editor, str.from_chars([key]), reg, parsed.count, [key], next_key, kind);
    } else if (key == 83 || key == 82) {
        visual_operator(editor, "c", reg, parsed.count, [key], 86, kind);
    } else if (key == 60 || key == 62) {
        visual_operator(editor, str.from_chars([key]), reg, parsed.count, [key], kind, kind);
    } else if (key == 126) {
        visual_operator(editor, "g~", reg, parsed.count, [key], kind, kind);
    } else if (key == 117) {
        visual_operator(editor, "gu", reg, parsed.count, [key], kind, kind);
    } else if (key == 85) {
        visual_operator(editor, "gU", reg, parsed.count, [key], kind, kind);
    } else if (key == 1 || key == 24) {
        visual_operator(editor, nr_op(key, false), reg, parsed.count, [key], kind, kind);
    } else if (key == 74) {
        visual_operator(editor, "J", reg, parsed.count, [key], kind, kind);
    } else if (key == 114) {
        int code_point = parsed.keys[1];
        if (parsed.keys.size() == 3) {
            code_point = parsed.keys[2];
        }
        if (code_point == 27) {
            leave_visual(editor);
        } else {
            visual_operator(editor, "r", reg, parsed.count, [114, code_point], kind, kind);
        }
    } else if (key == 109) {
        set_mark(editor, parsed.keys[1]);
    } else if (key == 103) {
        int second = parsed.keys[1];
        if (second == 74) {
            visual_operator(editor, "gJ", reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 126 || second == 117 || second == 85 || second == 63) {
            visual_operator(editor, "g" + str.from_chars([second]), reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 1 || second == 24) {
            visual_operator(editor, nr_op(second, true), reg, parsed.count, parsed.keys, kind, kind);
        } else if (second == 118) {
            if (!did_reselect(editor)) {
                editor.is_failed = true;
            }
        } else if (second == 112 || second == 80) {
            visual_put(editor, parsed, false, second == 80, true);
        } else {
            editor.is_failed = true;
        }
    } else if (key == 64) {
        // characterwise and blockwise Visual stay active while the register
        // runs (checked against nvim)
        if (editor.vkind == 86) {
            // `{Visual}@r` over lines is `:'<,'>normal @r`
            leave_visual(editor);
            str name = "";
            if (parsed.count > 1) {
                name = parsed.count.to_str();
            }
            editor.ex_queue.push("'<,'>normal " + name + "@" + str.from_chars([parsed.keys[1]]));
        } else {
            run_macro(editor, str.from_chars([parsed.keys[1]]), parsed.count);
        }
    } else if (key == 58) {
        leave_visual(editor);
        enter_cmdline(editor, 58, typed);
        editor.cmdline = "'<,'>";
    } else if (key == 112 || key == 80) {
        visual_put(editor, parsed, key == 80, key == 80, false);
    } else {
        editor.is_failed = true;
    }
}

// ------------------------------------------------------------- command line

void cmdline_leave(MED_editor.Editor editor) {
    editor.mode = editor.mode_before_cmd;
    editor.cmdline = "";
}

List<str> hist_for(MED_editor.Editor editor) {
    if (editor.cmd_type == 58) {
        return editor.hist_ex;
    }
    return editor.hist_search;
}

void hist_add(MED_editor.Editor editor, str line) {
    if (line == "") {
        return;
    }
    List<str> history = hist_for(editor);
    List<str> kept = [];
    for (str piece in history) {
        if (piece != line) {
            kept.push(piece);
        }
    }
    kept.push(line);
    if (editor.cmd_type == 58) {
        editor.hist_ex = kept;
    } else {
        editor.hist_search = kept;
    }
}

// <Up> / <Down>: recall the older / newer history entry that starts with what
// was typed before browsing began.
void hist_browse(MED_editor.Editor editor, bool is_older) {
    List<str> history = hist_for(editor);
    if (editor.hist_at < 0) {
        if (!is_older) {
            return;
        }
        editor.hist_prefix = editor.cmdline;
        editor.hist_at = history.size();
    }
    int index = editor.hist_at;
    while (true) {
        if (is_older) {
            index = index - 1;
        } else {
            index = index + 1;
        }
        if (index < 0) {
            return;
        }
        if (index >= history.size()) {
            editor.hist_at = -1;
            editor.cmdline = editor.hist_prefix;
            return;
        }
        if (history[index].starts_with(editor.hist_prefix)) {
            editor.hist_at = index;
            editor.cmdline = history[index];
            return;
        }
    }
}

void cmdline_key(MED_editor.Editor editor, int key) {
    if (key == 63232 || key == 63233) {
        hist_browse(editor, key == 63232);
        return;
    }
    if (key == 27 || key == 3) {
        cmdline_leave(editor);
        return;
    }
    if (key == 13 || key == 10) {
        str line = editor.cmdline;
        int kind = editor.cmd_type;
        List<int> saved = editor.cmd_saved;
        hist_add(editor, line);
        cmdline_leave(editor);
        if (kind == 58) {
            editor.ex_queue.push(str.from_chars([1]) + line);
        } else {
            editor.search_typed = line;
            editor.is_search_ready = true;
            editor.pending = saved;
            feed_pending(editor);
            editor.is_search_ready = false;
        }
        return;
    }
    if (key == 127 || key == 8) {
        if (editor.cmdline.size() == 0) {
            cmdline_leave(editor);
            return;
        }
        List<int> chars = editor.cmdline.chars();
        chars.pop();
        editor.cmdline = str.from_chars(chars);
        return;
    }
    if (key == 21) {
        editor.cmdline = "";
        return;
    }
    if (key >= 32 && key < 63232) {
        editor.cmdline = editor.cmdline + str.from_chars([key]);
    }
}

// ------------------------------------------------------------------ for ex
// What MED_ex needs from this module: line operators with Vim's cursor rules.
// Rows are 0-based and inclusive.

pub int first_nb(MED_editor.Editor editor, int row) {
    return first_nonblank_fix(editor.buffer.line(row));
}

pub void ex_marks(MED_editor.Editor editor, MED_buffer.Pos position, MED_buffer.Pos position_value) {
    set_op_marks(editor, position, position_value);
}

Oap ex_oap(str operator, str reg, int first, int last) {
    Oap oap = Oap();
    oap.operator = operator;
    oap.reg = reg;
    oap.is_linewise = true;
    oap.start = MED_buffer.Pos(first, 0);
    oap.end = MED_buffer.Pos(last, 0);
    oap.line_count = last - first + 1;
    return oap;
}

// :d
pub void ex_delete(MED_editor.Editor editor, int first, int last, str reg) {
    int want = editor.want;
    editor.row = first;
    editor.col = col_by_want(editor, first, want);
    editor.open_block();
    did_op_delete(editor, ex_oap("d", reg, first, last));
    editor.row = MED_num.smaller(editor.row, editor.buffer.line_count() - 1);
    editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
    editor.want = want;
    editor.needs_stale = true;
}

// :y
pub void ex_yank(MED_editor.Editor editor, int first, int last, str reg) {
    op_yank(editor, ex_oap("y", reg, first, last));
}

// :> and :<
pub void ex_shift(MED_editor.Editor editor, int first, int last, bool is_left, int amount) {
    editor.row = first;
    editor.col = col_by_want(editor, first, editor.want);
    int col = editor.col;
    // several lines are saved for undo as one block: no "U" line
    bool is_saved_off = editor.is_uline_off;
    if (last > first) {
        editor.is_uline_off = true;
    }
    for (int row in first .. last + 1) {
        str line = editor.buffer.line(row);
        if (line.size() == 0) {
            continue;
        }
        int width = indent_width(editor, line);
        int delta = editor.shiftwidth * amount;
        if (!is_left) {
            width = width + delta;
        } else {
            width = MED_num.larger(width - delta, 0);
        }
        str replaced = with_indent(editor, line, width);
        if (replaced != line) {
            editor.change(MED_buffer.Pos(row, 0), MED_buffer.Pos(row, line.size()), replaced);
            col = MED_text.first_nonblank(replaced);
        }
    }
    editor.is_uline_off = is_saved_off;
    int end_length = editor.buffer.line_size(last);
    if (end_length > 0) {
        end_length = end_length - 1;
    }
    set_op_marks(editor, MED_buffer.Pos(first, 0), MED_buffer.Pos(last, end_length));
    editor.row = last;
    editor.col = col;
    editor.clamp();
}

// :put after row `row` (-1: above the first line), or above it when `is_above`.
pub bool did_ex_put(MED_editor.Editor editor, str regname, int row, bool is_above) {
    int directory = 1;
    if (row < 0) {
        editor.row = 0;
        directory = -1;
    } else {
        editor.row = row;
        if (is_above) {
            directory = -1;
        }
    }
    editor.clamp();
    Option<MED_register.Reg> found = editor.regs.get(regname);
    if (found.is_none() && (regname == "_" || regname == ".")) {
        // the black hole and an unset "." put one empty line
        found = Option<MED_register.Reg>.Some(MED_register.Reg([""], MED_register.LINE));
    }
    match (found) {
        case None: {
            return false;
        }
        case Some(MED_register.Reg reg): {
            int want = editor.want;
            bool is_ok = did_put_reg(editor, reg, directory, 1, false, PUT_LINE, 0);
            editor.row = editor.marks.get("]").or(MED_buffer.Pos(editor.row, 0)).row;
            editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
            editor.want = want;
            editor.needs_stale = true;
            return is_ok;
        }
    }
}

// :join, `count` lines from `row`.
pub bool did_ex_join(MED_editor.Editor editor, int row, int count, bool is_spaces) {
    int want = editor.want;
    bool is_ok = did_do_join(editor, row, count, is_spaces);
    editor.col = first_nonblank_fix(editor.buffer.line(editor.row));
    editor.want = want;
    editor.needs_stale = true;
    return is_ok;
}
