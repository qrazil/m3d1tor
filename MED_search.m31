// Searching the buffer: `/ ? n N * # g* g#`, search offsets, `%` and `[(`.
//
// A port of Vim's searchit(), do_search(), find_ident_under_cursor() and
// findmatchlimit(), checked against nvim.
//
// API
// ---
//   MED_search.compile_last(ed, pat)              compile with the editor's options
//   MED_search.searchit(ed, re, row, col, dir, count, at_start, at_end, no_offset) -> Hit
//   MED_search.search_command(ed, dirc, typed, count, reverse, use_typed) -> Outcome
//   MED_search.star(ed, key, whole_word, count)   `*` `#` `g*` `g#`
//   MED_search.skip_regexp(text, delim)           where the pattern in `text` ends
//   MED_search.findmatch(buf, row, col, initc, dir) -> MED_buffer.Pos (row -1: none)
//   MED_search.set_last_pattern(ed, pat, is_sub)  make `pat` the pattern `n` and `//` use

import MED_editor;
import MED_regex;
import MED_buffer;
import MED_text;

pub type Hit {
    pub bool ok = false;
    pub int row = 0;
    pub int col = 0;
    pub int erow = 0;
    pub int ecol = 0;
    /// The search ran past the end (or start) of the buffer to find this.
    pub bool wrapped = false;
    pub str error = "";
}

pub type Outcome {
    pub bool ok = false;
    pub int row = 0;
    pub int col = 0;
    /// 2 when a line offset was added (the motion becomes linewise).
    pub int kind = 1;
    pub bool inclusive = false;
    pub bool wrapped = false;
    pub str error = "";
}

/// The pattern `n` and an empty pattern use.
pub str last_pattern(MED_editor.Editor ed) {
    if (ed.last_is_sub) {
        return ed.sub_pat;
    }
    return ed.search_pat;
}

pub void set_last_pattern(MED_editor.Editor ed, str pat, bool is_sub) {
    if (is_sub) {
        ed.sub_pat = pat;
    } else {
        ed.search_pat = pat;
    }
    ed.last_is_sub = is_sub;
    ed.no_hl = false;
    ed.regs.set_special("/", pat);
}

pub MED_regex.Regex compile_with(MED_editor.Editor ed, str pat, bool no_scs) {
    bool scs = ed.smartcase;
    if (no_scs) {
        scs = false;
    }
    return MED_regex.compile(pat, ed.ignorecase, scs, ed.sub_rep);
}

// ----------------------------------------------------------- pattern ends

int at(str line, int col) {
    if (col < 0 || col >= line.size()) {
        return 0;
    }
    return line.byte_at(col);
}

// After the `[` at `i`: the index just past the closing `]` of a collection,
// or -1 when this `[` does not start one (Vim's skip_anyof()).
int skip_anyof(str s, int i) {
    int p = i + 1;
    if (at(s, p) == 94) {
        p = p + 1;
    }
    if (at(s, p) == 93 || at(s, p) == 45) {
        p = p + 1;
    }
    while (p < s.size() && at(s, p) != 93) {
        int c = at(s, p);
        if (c == 45) {
            p = p + 1;
            if (at(s, p) == 93 || p >= s.size()) {
                break;
            }
            p = p + 1;
        } else if (c == 92) {
            int n = at(s, p + 1);
            if (n != 0 && "]^-n\\nrtebdoxuU".index_of(str.from_chars([n])).is_some()) {
                p = p + 2;
            } else {
                p = p + 1;
            }
        } else if (c == 91) {
            int n = at(s, p + 1);
            if (n == 58 || n == 61 || n == 46) {
                int q = p + 2;
                while (q < s.size() && !(at(s, q) == n && at(s, q + 1) == 93)) {
                    q = q + 1;
                }
                if (q < s.size()) {
                    p = q + 2;
                } else {
                    p = p + 1;
                }
            } else {
                p = p + 1;
            }
        } else {
            p = MED_text.next_col(s, p);
        }
    }
    if (at(s, p) == 93) {
        return p + 1;
    }
    return -1;
}

/// The byte index in `text` where the pattern ends: at the first unescaped
/// `delim` outside a `[]` collection (Vim's skip_regexp()).
pub int skip_regexp(str text, int delim) {
    int p = 0;
    bool magic = true;
    while (p < text.size()) {
        int c = text.byte_at(p);
        if (c == delim) {
            break;
        }
        if ((c == 91 && magic) || (c == 92 && at(text, p + 1) == 91 && !magic)) {
            int from = p;
            if (c == 92) {
                from = p + 1;
            }
            int end = skip_anyof(text, from);
            if (end > 0) {
                p = end;
            } else {
                p = from + 1;
            }
        } else if (c == 92 && p + 1 < text.size()) {
            int n = text.byte_at(p + 1);
            if (n == 118) {
                magic = true;
            } else if (n == 86) {
                magic = false;
            }
            p = p + 2;
        } else {
            p = MED_text.next_col(text, p);
        }
    }
    return p;
}

// --------------------------------------------------------------- searchit

int line_len(MED_buffer.Buffer buf, int row) {
    return buf.line_size(row);
}

/// One search of `re` from (prow, pcol), `count` times, in direction `dir`
/// (1 or -1). `at_start` accepts a match at the start (SEARCH_START),
/// `at_end` puts the position on the last character of the match
/// (SEARCH_END), unless `no_offset`.
pub Hit searchit(MED_editor.Editor ed, MED_regex.Regex re, int prow, int pcol, int dir, int count, bool at_start, bool at_end, bool no_offset) {
    MED_buffer.Buffer buf = ed.buf;
    int nlines = buf.line_count();
    Hit hit = Hit();
    int cr = prow;
    int cc = pcol;
    bool first_match = true;
    int remaining = count;
    if (remaining < 1) {
        remaining = 1;
    }
    while (true) {
        int start_row = cr;
        int start_col = cc;
        int sclen = 1;
        if (start_row < nlines && start_col < line_len(buf, start_row)) {
            sclen = MED_text.next_col(buf.line(start_row), start_col) - start_col;
        }
        int extra = 0;
        if (dir > 0) {
            if (!at_start) {
                extra = sclen;
            }
        } else if (at_start) {
            extra = sclen;
        }
        bool found = false;
        bool first_line = true;
        int lnum = cr;
        if (dir < 0 && cc == 0 && !at_start) {
            lnum = cr - 1;
            first_line = false;
        }
        int fr = 0;
        int fc = 0;
        int fer = 0;
        int fec = 0;
        for (int pass in 0 .. 2) {
            while (lnum >= 0 && lnum < nlines) {
                bool stop_check = true;
                MED_regex.Match m = re.search_line(buf, lnum, 0);
                if (m.aborted) {
                    hit.error = "E363: Pattern uses more memory than 'maxmempattern'";
                    return hit;
                }
                if (m.ok) {
                    int mr = m.srow;
                    int mc = m.scol;
                    int er = m.erow;
                    int ec = m.ecol;
                    bool match_ok = true;
                    if (dir > 0 && first_line) {
                        while (mr == lnum) {
                            int len = line_len(buf, lnum);
                            bool before = false;
                            if (at_end && first_match) {
                                before = er == lnum && ec - 1 < start_col + extra;
                            } else {
                                int adj = 0;
                                if (mc >= len) {
                                    adj = 1;
                                }
                                before = mc - adj < start_col + extra;
                            }
                            if (!before) {
                                break;
                            }
                            int matchcol = 0;
                            if (er > lnum) {
                                match_ok = false;
                                break;
                            }
                            matchcol = ec;
                            if (matchcol == mc && matchcol < len) {
                                matchcol = MED_text.next_col(buf.line(lnum), matchcol);
                            }
                            if (matchcol == 0 && at_start) {
                                break;
                            }
                            if (matchcol >= len) {
                                match_ok = false;
                                break;
                            }
                            MED_regex.Match m2 = re.search_line(buf, lnum, matchcol);
                            if (!m2.ok) {
                                match_ok = false;
                                break;
                            }
                            mr = m2.srow;
                            mc = m2.scol;
                            er = m2.erow;
                            ec = m2.ecol;
                        }
                        if (!match_ok) {
                            stop_check = false;
                        }
                    } else if (dir < 0) {
                        match_ok = false;
                        int ar = 0;
                        int ac = 0;
                        int aer = 0;
                        int aec = 0;
                        int cur_r = mr;
                        int cur_c = mc;
                        int cur_er = er;
                        int cur_ec = ec;
                        while (true) {
                            bool accept = false;
                            if (pass == 1) {
                                accept = true;
                            } else if (at_end) {
                                accept = cur_er < start_row || (cur_er == start_row && cur_ec - 1 < start_col + extra);
                            } else {
                                accept = cur_r < start_row || (cur_r == start_row && cur_c < start_col + extra);
                            }
                            if (!accept) {
                                break;
                            }
                            match_ok = true;
                            ar = cur_r;
                            ac = cur_c;
                            aer = cur_er;
                            aec = cur_ec;
                            int matchcol = 0;
                            if (cur_er > lnum) {
                                break;
                            }
                            matchcol = cur_ec;
                            int rlen = line_len(buf, cur_r);
                            if (matchcol == cur_c && matchcol < rlen) {
                                matchcol = MED_text.next_col(buf.line(cur_r), matchcol);
                            }
                            if (matchcol >= rlen) {
                                break;
                            }
                            MED_regex.Match m2 = re.search_line(buf, cur_r, matchcol);
                            if (!m2.ok) {
                                break;
                            }
                            cur_r = m2.srow;
                            cur_c = m2.scol;
                            cur_er = m2.erow;
                            cur_ec = m2.ecol;
                        }
                        if (match_ok) {
                            mr = ar;
                            mc = ac;
                            er = aer;
                            ec = aec;
                        } else {
                            stop_check = false;
                        }
                    }
                    if (match_ok) {
                        if (at_end && !no_offset && !(mr == er && mc == ec)) {
                            fr = er;
                            fc = ec;
                            if (ec == 0) {
                                if (fr > 0) {
                                    fr = fr - 1;
                                    fc = line_len(buf, fr);
                                }
                            } else {
                                fc = MED_text.prev_col(buf.line(fr), ec);
                            }
                        } else {
                            fr = mr;
                            fc = mc;
                        }
                        hit.erow = er;
                        hit.ecol = ec;
                        if (pass == 1) {
                            hit.wrapped = true;
                        }
                        found = true;
                        first_match = false;
                        break;
                    }
                }
                if (stop_check && pass == 1 && lnum == start_row) {
                    break;
                }
                lnum = lnum + dir;
                first_line = false;
            }
            first_line = false;
            if (!ed.wrapscan || found || pass == 1) {
                break;
            }
            if (dir < 0) {
                lnum = nlines - 1;
            } else {
                lnum = 0;
            }
        }
        if (!found) {
            hit.ok = false;
            return hit;
        }
        cr = fr;
        cc = fc;
        remaining = remaining - 1;
        if (remaining <= 0) {
            break;
        }
    }
    hit.ok = true;
    hit.row = cr;
    hit.col = cc;
    return hit;
}

// ------------------------------------------------------------- do_search

bool is_digit(int c) {
    return c >= 48 && c <= 57;
}

int parse_int_at(str s, int i) {
    int v = 0;
    int p = i;
    while (p < s.size() && is_digit(s.byte_at(p))) {
        v = v * 10 + (s.byte_at(p) - 48);
        p = p + 1;
    }
    return v;
}

// Vim's inc(): one position forward, stopping on the NUL ending a line; 0 for
// a move inside the line, 2 when it reached the NUL, 1 for the next line and
// -1 at the end of the buffer.
int inc_pos(MED_buffer.Buffer buf, List<int> pos) {
    str line = buf.line(pos[0]);
    if (pos[1] < line.size()) {
        pos[1] = MED_text.next_col(line, pos[1]);
        if (pos[1] < line.size()) {
            return 0;
        }
        return 2;
    }
    if (pos[0] + 1 < buf.line_count()) {
        pos[0] = pos[0] + 1;
        pos[1] = 0;
        return 1;
    }
    return -1;
}

// Vim's dec(): 0 inside a line, 1 onto the NUL of the previous line, -1 at the start.
int dec_pos(MED_buffer.Buffer buf, List<int> pos) {
    if (pos[1] > 0) {
        pos[1] = MED_text.prev_col(buf.line(pos[0]), pos[1]);
        return 0;
    }
    if (pos[0] > 0) {
        pos[0] = pos[0] - 1;
        pos[1] = buf.line_size(pos[0]);
        return 1;
    }
    return -1;
}

int incl_pos(MED_buffer.Buffer buf, List<int> pos) {
    int r = inc_pos(buf, pos);
    if (r >= 1 && pos[1] > 0) {
        r = inc_pos(buf, pos);
    }
    return r;
}

int decl_pos(MED_buffer.Buffer buf, List<int> pos) {
    int r = dec_pos(buf, pos);
    if (r == 1 && pos[1] > 0) {
        r = dec_pos(buf, pos);
    }
    return r;
}

// Step the position `n` characters forward (`n` > 0, incl()) or back (n < 0,
// decl()). False when the buffer's edge was hit first.
bool step_chars(MED_buffer.Buffer buf, List<int> pos, int n) {
    int left = n;
    while (left != 0) {
        int r = 0;
        if (left > 0) {
            r = incl_pos(buf, pos);
            left = left - 1;
        } else {
            r = decl_pos(buf, pos);
            left = left + 1;
        }
        if (r == -1) {
            return false;
        }
    }
    return true;
}

str unescape_question(str pattern) {
    List<int> cs = pattern.chars();
    List<int> out = [];
    int i = 0;
    while (i < cs.size()) {
        if (cs[i] == 92 && i + 1 < cs.size()) {
            if (cs[i + 1] == 63) {
                out.push(63);
            } else {
                out.push(92);
                out.push(cs[i + 1]);
            }
            i = i + 2;
        } else {
            out.push(cs[i]);
            i = i + 1;
        }
    }
    return str.from_chars(out);
}

/// Run a `/` or `?` command (or `n` / `N`: `use_typed` false). `typed` is the
/// text after the `/` as typed on the command line; `dirc` is 47 or 63 (0 for
/// n and N, which use the last direction); `reverse` flips it (N).
pub Outcome search_command(MED_editor.Editor ed, int dirc_in, str typed, int count, bool reverse, bool use_typed) {
    Outcome out = Outcome();
    int dirc = dirc_in;
    if (dirc == 0) {
        dirc = 47;
        if (ed.search_dir < 0) {
            dirc = 63;
        }
    } else {
        ed.search_dir = 1;
        if (dirc == 63) {
            ed.search_dir = -1;
        }
    }
    if (reverse) {
        if (dirc == 47) {
            dirc = 63;
        } else {
            dirc = 47;
        }
    }
    if (!use_typed && last_pattern(ed) == "" && ed.sub_pat == "") {
        out.error = "E35: No previous regular expression";
        return out;
    }
    int pr = ed.row;
    int pc = ed.col;
    str rest = typed;
    bool have_text = use_typed && typed != "";
    int cnt = count;
    while (true) {
        int delim = dirc;
        str pattern = "";
        bool use_last = true;
        bool follow = false;
        str after = "";
        if (have_text) {
            int end = skip_regexp(rest, delim);
            pattern = rest.substr(0, end);
            int p = end;
            if (p < rest.size() && rest.byte_at(p) == delim) {
                p = p + 1;
            }
            if (delim == 63) {
                pattern = unescape_question(pattern);
            }
            ed.search_off_line = false;
            ed.search_off_end = false;
            ed.search_off = 0;
            int c0 = at(rest, p);
            if (c0 == 43 || c0 == 45 || is_digit(c0)) {
                ed.search_off_line = true;
            } else if (c0 == 101 || c0 == 115 || c0 == 98) {
                if (c0 == 101) {
                    ed.search_off_end = true;
                }
                p = p + 1;
            }
            int c1 = at(rest, p);
            if (is_digit(c1) || c1 == 43 || c1 == 45) {
                if (is_digit(c1) || is_digit(at(rest, p + 1))) {
                    int sign = 1;
                    int q = p;
                    if (c1 == 45) {
                        sign = -1;
                        q = p + 1;
                    } else if (c1 == 43) {
                        q = p + 1;
                    }
                    ed.search_off = sign * parse_int_at(rest, q);
                } else if (c1 == 45) {
                    ed.search_off = -1;
                } else {
                    ed.search_off = 1;
                }
                p = p + 1;
                while (p < rest.size() && is_digit(rest.byte_at(p))) {
                    p = p + 1;
                }
            }
            after = rest.substr(p, rest.size());
            if (after.size() > 0 && after.byte_at(0) == 59) {
                follow = true;
            }
            use_last = pattern == "";
        }
        // the pattern to search for
        str pat_text = "";
        bool no_scs = false;
        if (use_last) {
            pat_text = last_pattern(ed);
            if (ed.search_pat == "" && ed.sub_pat != "") {
                pat_text = ed.sub_pat;
            }
            no_scs = ed.search_no_scs;
            if (ed.last_is_sub) {
                no_scs = false;
            }
            if (pat_text == "") {
                out.error = "E35: No previous regular expression";
                return out;
            }
        } else {
            pat_text = pattern;
            no_scs = ed.search_no_scs_next;
            set_last_pattern(ed, pat_text, false);
            ed.search_no_scs = no_scs;
        }
        MED_regex.Regex re = compile_with(ed, pat_text, no_scs);
        if (!re.ok) {
            out.error = re.error;
            return out;
        }
        // with a character offset, start from where that offset would have come from
        List<int> pos = [pr, pc];
        bool beyond = false;
        if (!ed.search_off_line && ed.search_off != 0) {
            int back = 0 - ed.search_off;
            if (!step_chars(ed.buf, pos, back)) {
                beyond = true;
            }
        }
        Hit hit = Hit();
        int sdir = 1;
        if (dirc == 63) {
            sdir = -1;
        }
        if (beyond) {
            // Vim puts the start before the first line (or after the last): the
            // search then begins at that edge
            if (ed.search_off > 0) {
                hit = searchit(ed, re, 0, 0, sdir, cnt, true, ed.search_off_end, false);
            } else {
                hit = searchit(ed, re, ed.buf.line_count() - 1, ed.buf.line_size(ed.buf.line_count() - 1), sdir, cnt, false, ed.search_off_end, false);
            }
        } else {
            hit = searchit(ed, re, pos[0], pos[1], sdir, cnt, false, ed.search_off_end, false);
        }
        if (!hit.ok) {
            if (hit.error != "") {
                out.error = hit.error;
            } else if (!ed.wrapscan) {
                if (dirc == 47) {
                    out.error = "E385: Search hit BOTTOM without match for: " + pat_text;
                } else {
                    out.error = "E384: Search hit TOP without match for: " + pat_text;
                }
            } else {
                out.error = "E486: Pattern not found: " + pat_text;
            }
            return out;
        }
        pr = hit.row;
        pc = hit.col;
        if (hit.wrapped) {
            out.wrapped = true;
        }
        out.kind = 1;
        if (ed.search_off_line) {
            int target = pr + ed.search_off;
            if (target < 0) {
                target = 0;
            }
            if (target > ed.buf.line_count() - 1) {
                target = ed.buf.line_count() - 1;
            }
            pr = target;
            pc = 0;
            out.kind = 2;
        } else if (ed.search_off != 0) {
            List<int> q = [pr, pc];
            step_chars(ed.buf, q, ed.search_off);
            pr = q[0];
            pc = q[1];
        }
        if (!follow) {
            break;
        }
        // "/foo/;/bar/": another search from here
        int nd = at(after, 1);
        if (nd != 47 && nd != 63) {
            out.error = "E386: Expected '?' or '/'  after ';'";
            return out;
        }
        dirc = nd;
        rest = after.substr(2, after.size());
        have_text = true;
        cnt = 1;
    }
    out.ok = true;
    out.row = pr;
    out.col = pc;
    out.inclusive = ed.search_off_end;
    return out;
}

// ----------------------------------------------------------------- * and #

/// The identifier (or, failing that, the non-blank text) at or after `col`:
/// start and end byte columns, end exclusive; start -1 when there is none.
pub List<int> ident_at(str line, int col) {
    List<int> none = [-1, -1];
    for (int i in 0 .. 2) {
        int c = col;
        while (c < line.size()) {
            int cls = MED_text.class_at(line, c);
            if (cls != 0 && (i == 1 || cls != 1)) {
                break;
            }
            c = MED_text.next_col(line, c);
        }
        int this_class = MED_text.class_at(line, c);
        while (c > 0 && this_class != 0) {
            int prevcol = MED_text.prev_col(line, c);
            int prev_class = MED_text.class_at(line, prevcol);
            if (this_class != prev_class) {
                break;
            }
            c = prevcol;
        }
        if (this_class > 2) {
            this_class = 2;
        }
        if (this_class == 2 || i == 1) {
            if (c >= line.size() || (i == 0 && this_class != 2)) {
                if (i == 1) {
                    return none;
                }
                continue;
            }
            // the end
            int start_class = MED_text.class_at(line, c);
            int e = c;
            while (e < line.size()) {
                int cls = MED_text.class_at(line, e);
                bool same = false;
                if (i == 0) {
                    same = cls == start_class;
                } else {
                    same = cls != 0;
                }
                if (!same) {
                    break;
                }
                e = MED_text.next_col(line, e);
            }
            return [c, e];
        }
    }
    return none;
}

/// `*` `#` (`whole_word`) and `g*` `g#`: search for the word under the cursor.
/// Moves nothing itself; the result is the new position like search_command().
pub Outcome star(MED_editor.Editor ed, int key, bool whole_word, int count) {
    Outcome out = Outcome();
    str line = ed.buf.line(ed.row);
    List<int> span = ident_at(line, ed.col);
    if (span[0] < 0) {
        out.error = "E348: No string under cursor";
        return out;
    }
    str word = line.substr(span[0], span[1]);
    str special = "/.*~[^$\\";
    if (key == 35) {
        special = "/?.*~[^$\\";
    }
    List<int> pieces = [];
    bool word_start = MED_text.class_at(line, span[0]) >= 2;
    if (whole_word && word_start) {
        pieces.push(92);
        pieces.push(60);
    }
    for (int cp in word.chars()) {
        if (cp < 128 && special.index_of(str.from_chars([cp])).is_some()) {
            pieces.push(92);
        }
        pieces.push(cp);
    }
    int last_start = span[0];
    int p = span[0];
    while (p < span[1]) {
        last_start = p;
        p = MED_text.next_col(line, p);
    }
    if (whole_word && MED_text.class_at(line, last_start) >= 2) {
        pieces.push(92);
        pieces.push(62);
    }
    str pat = str.from_chars(pieces);
    int saved_row = ed.row;
    int saved_col = ed.col;
    ed.col = span[0];
    ed.search_no_scs_next = true;
    int dirc = 47;
    if (key == 35) {
        dirc = 63;
    }
    Outcome r = search_command(ed, dirc, pat, count, false, true);
    ed.search_no_scs_next = false;
    ed.row = saved_row;
    ed.col = saved_col;
    return r;
}

// ------------------------------------------------------------ findmatch

// Is there a `ch` in `line` just before `col` (Vim's check_prevcol())?
bool prev_is(str line, int col, int ch) {
    int c = col - 1;
    if (c > 0) {
        c = MED_text.snap(line, c);
    }
    return c >= 0 && at(line, c) == ch;
}

int prev_of(str line, int col) {
    int c = col - 1;
    if (c > 0) {
        c = MED_text.snap(line, c);
    }
    return c;
}

// The matchpairs: [open, close, ...]
const List<int> PAIRS = [40, 41, 123, 125, 91, 93];

/// Where the bracket under or after the cursor (initc 0), or the bracket
/// `initc` searched in direction `dir` (1 forward, -1 backward, 0 as the
/// bracket says; for `[(` and friends), has its partner. Row -1: none.
/// Vim's findmatchlimit() with 'cpoptions' as nvim's default.
pub MED_buffer.Pos findmatch(MED_buffer.Buffer buf, int row, int col, int initc_in, int dir) {
    MED_buffer.Pos none = MED_buffer.Pos(-1, 0);
    int pr = row;
    int pc = col;
    str linep = buf.line(pr);
    int initc = initc_in;
    int findc = 0;
    bool backwards = false;
    int match_escaped = 0;
    if (initc != 0) {
        // find_mps_values(&initc, &findc, &backwards, true)
        bool seen = false;
        for (int k in 0 .. PAIRS.size()) {
            if (PAIRS[k] == initc) {
                // (the assignment is shared by both arms: hoisted for m31 gap G8)
                findc = initc;
                if (k % 2 == 0) {
                    initc = PAIRS[k + 1];
                    backwards = true;
                } else {
                    initc = PAIRS[k - 1];
                    backwards = false;
                }
                seen = true;
                break;
            }
        }
        if (!seen) {
            return none;
        }
        if (dir != 0) {
            backwards = dir < 0;
        }
    } else {
        if (at(linep, pc) == 0 && pc > 0) {
            pc = prev_of(linep, pc);
        }
        while (true) {
            int c = at(linep, pc);
            if (c == 0 || pc >= linep.size()) {
                break;
            }
            bool hit = false;
            for (int k in 0 .. PAIRS.size()) {
                if (PAIRS[k] == c) {
                    initc = c;
                    if (k % 2 == 0) {
                        findc = PAIRS[k + 1];
                        backwards = false;
                    } else {
                        findc = PAIRS[k - 1];
                        backwards = true;
                    }
                    hit = true;
                    break;
                }
            }
            if (hit) {
                break;
            }
            pc = MED_text.next_col(linep, pc);
        }
        if (findc == 0) {
            return none;
        }
        int bslcnt = 0;
        int cc = pc;
        while (prev_is(linep, cc, 92)) {
            bslcnt = bslcnt + 1;
            cc = prev_of(linep, cc);
        }
        match_escaped = bslcnt % 2;
    }
    int do_quotes = -1;
    int start_in_quotes = 0;
    bool inquote = false;
    int count = 0;
    int at_start = 0;
    int nlines = buf.line_count();
    int guard = 0;
    while (true) {
        guard = guard + 1;
        if (backwards) {
            if (pc == 0) {
                if (pr == 0) {
                    break;
                }
                pr = pr - 1;
                linep = buf.line(pr);
                pc = linep.size();
                do_quotes = -1;
            } else {
                pc = pc - 1;
                pc = MED_text.snap(linep, pc);
            }
        } else if (pc >= linep.size()) {
            if (pr == nlines - 1) {
                break;
            }
            pr = pr + 1;
            linep = buf.line(pr);
            pc = 0;
            do_quotes = -1;
        } else {
            pc = MED_text.next_col(linep, pc);
        }
        if (do_quotes == -1) {
            at_start = do_quotes;
            int bw = 0;
            if (backwards) {
                bw = 1;
            }
            do_quotes = 0 - 1;
            int ptr = 0;
            while (ptr < linep.size()) {
                if (ptr == pc + bw) {
                    at_start = do_quotes & 1;
                }
                int ch = linep.byte_at(ptr);
                if (ch == 34 && (ptr == 0 || at(linep, ptr - 1) != 39 || at(linep, ptr + 1) != 39)) {
                    do_quotes = do_quotes + 1;
                }
                if (ch == 92 && at(linep, ptr + 1) != 0) {
                    ptr = ptr + 1;
                }
                ptr = ptr + 1;
            }
            do_quotes = do_quotes & 1;
            if (do_quotes == 0) {
                inquote = false;
                if (linep.size() > 0 && at(linep, linep.size() - 1) == 92) {
                    do_quotes = 1;
                    if (start_in_quotes == 0) {
                        inquote = true;
                        start_in_quotes = 1;
                    } else if (backwards) {
                        inquote = true;
                    }
                }
                if (pr > 0) {
                    str prev = buf.line(pr - 1);
                    if (prev.size() > 0 && at(prev, prev.size() - 1) == 92) {
                        do_quotes = 1;
                        if (start_in_quotes == 0) {
                            inquote = at_start != 0;
                            if (inquote) {
                                start_in_quotes = 1;
                            }
                        } else if (!backwards) {
                            inquote = true;
                        }
                    }
                }
            }
        }
        if (start_in_quotes == 0) {
            start_in_quotes = 2;
        }
        int c = at(linep, pc);
        bool handled = false;
        if (pc >= linep.size()) {
            if (pc == 0 || at(linep, pc - 1) != 92) {
                inquote = false;
                start_in_quotes = 2;
            }
            handled = true;
        } else if (c == 34) {
            if (do_quotes != 0) {
                int cl = pc - 1;
                while (cl >= 0 && at(linep, cl) == 92) {
                    cl = cl - 1;
                }
                if (((pc - 1 - cl) & 1) == 0) {
                    inquote = !inquote;
                    start_in_quotes = 2;
                }
            }
            handled = true;
        } else if (c == 39 && initc != 39 && findc != 39) {
            if (backwards) {
                if (pc > 1) {
                    if (at(linep, pc - 2) == 39) {
                        pc = pc - 2;
                        handled = true;
                    } else if (at(linep, pc - 2) == 92 && pc > 2 && at(linep, pc - 3) == 39) {
                        pc = pc - 3;
                        handled = true;
                    }
                }
            } else if (at(linep, pc + 1) != 0) {
                if (at(linep, pc + 1) == 92 && at(linep, pc + 2) != 0 && at(linep, pc + 3) == 39) {
                    pc = pc + 3;
                    handled = true;
                } else if (at(linep, pc + 2) == 39) {
                    pc = pc + 2;
                    handled = true;
                }
            }
        }
        if (!handled) {
            if ((!inquote || start_in_quotes == 1) && (c == initc || c == findc)) {
                int bslcnt = 0;
                int cc = pc;
                while (prev_is(linep, cc, 92)) {
                    bslcnt = bslcnt + 1;
                    cc = prev_of(linep, cc);
                }
                if (bslcnt % 2 == match_escaped) {
                    if (c == initc) {
                        count = count + 1;
                    } else {
                        if (count == 0) {
                            return MED_buffer.Pos(pr, pc);
                        }
                        count = count - 1;
                    }
                }
            }
        }
    }
    return none;
}
