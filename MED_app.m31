// The terminal front end: one `App` joins the editing engine (MED_ex.feed) to
// tui's application loop. It is a Widget (draws the text window, a status line
// and the command line) and a Handler (turns a terminal event into engine keys,
// then carries out what the engine asked of the UI: `:w`, `:q`).
//
//   row 0 .. height-3   the text, with a line-number gutter, no wrapping
//   row height-2        the status line: mode, file name, modified flag, position
//   row height-1        the command line while typing `:` or `/`, else the message
//
// tui hides the terminal cursor, so the cursor is drawn as a reverse-video cell.
// The engine owns every editing decision; nothing here knows what a motion is.

import fs;
import io;
import term;
import tui.TUI_app;
import tui.TUI_buffer;
import tui.TUI_geometry;
import tui.TUI_menu;
import tui.TUI_mouse;
import tui.TUI_style;
import MED_buffer;
import MED_editor;
import MED_ex;
import MED_files;
import MED_grep;
import MED_key;
import MED_keymap;
import MED_picker;
import MED_picker_view;
import MED_text;
import MED_view;

/// Rows below the text: the status line and the command line.
const int FOOTER_ROWS = 2;
/// The fewest digits the line-number gutter shows.
const int MIN_DIGITS = 3;
/// Visual selection background (a palette grey).
const int SELECTION_COLOUR = 240;
/// Lines the mouse wheel scrolls per notch.
const int WHEEL_LINES = 3;
/// Quiet time (ms) after typing in the grep prompt before the search runs.
const int GREP_DEBOUNCE_MS = 120;
const int PREVIEW_LINES = 3000;
const int VKIND_CHAR = 118;
const int VKIND_LINE = 86;

/// One buffer of the session: its engine state (a reference, so the active
/// buffer's editor is the very object the App drives) and its file.
pub type Slot {
    /// Buffer number, as `:ls` shows it; never reused.
    pub int id;
    pub MED_editor.Editor editor;
    pub str path;
    pub int saved_current = 0;
    pub int left_column = 0;
}

pub type App {
    pub MED_editor.Editor editor;
    /// The file `:w` writes; empty for a buffer with no name yet.
    pub str path;
    /// The undo node (`editor.current`) that was last written to disk.
    pub int saved_current = 0;
    /// A message of the UI layer (written, E37 ...), cleared by the next key.
    pub str notice = "";
    /// First display column shown (horizontal scrolling).
    pub int left_column = 0;
    /// Every buffer; `editor`, `path`, `saved_current` and `left_column` belong
    /// to the active one (`current_id`) and are stored back by `save_active`.
    pub List<Slot> slots = [];
    pub int current_id = 1;
    /// The buffer `:b#` and CTRL-^ go to; 0 when there is none.
    pub int alternate_id = 0;
    pub int next_id = 2;
    /// Lines shown over the text until the next key (`:ls` and long messages).
    pub List<str> overlay = [];
    /// The open picker, if any.
    pub MED_picker.Picker picker = MED_picker.make(0, "");
    pub bool has_picker = false;
    /// The project root the file and grep pickers walk.
    pub str root = ".";
    pub MED_grep.Corpus corpus = MED_grep.Corpus();
    pub bool is_grep_due = false;
    pub int idle_ms = 0;
    pub MED_picker_view.Preview preview = MED_picker_view.Preview();
    pub str preview_path = "";
    pub List<str> preview_lines = [];
    /// <Space> was typed: the keys after it so far, and the wait for which-key.
    pub bool is_leader = false;
    pub str leader = "";
    pub int leader_ms = 0;
    pub bool is_which_key = false;
    /// The previous key fed to the engine (for the `jk` mapping).
    pub int last_key = 0;
}

/// Whether the text differs from what was last written (undo back to the
/// written state counts as unmodified).
pub bool App.is_modified() {
    return editor.current != saved_current;
}

/// The engine keys typed by a terminal event.
List<int> App.keys_of(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            return keys_of_key(key);
        }
        case Paste(str text): {
            // a paste is typed text in Insert mode; elsewhere it would run as commands
            if (editor.mode == MED_editor.INSERT || editor.mode == MED_editor.REPLACE || editor.mode == MED_editor.CMDLINE) {
                for (int code_point in text.chars()) {
                    if (code_point == 10) {
                        keys.push(MED_key.CARRIAGE_RETURN);
                    } else if (code_point != 13) {
                        keys.push(code_point);
                    }
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    return keys;
}

/// The slot of the active buffer, brought up to date.
Slot App.active_slot() {
    save_active();
    return slots[index_of(current_id)];
}

/// Store the active buffer's own values back into its slot.
void App.save_active() {
    int position = index_of(current_id);
    if (position < 0) {
        return;
    }
    Slot slot = slots[position];
    slot.editor = editor;
    slot.path = path;
    slot.saved_current = saved_current;
    slot.left_column = left_column;
}

/// Where buffer `id` is in `slots`, or -1.
int App.index_of(int id) {
    for (int position in 0 .. slots.size()) {
        if (slots[position].id == id) {
            return position;
        }
    }
    return -1;
}

/// Write the active buffer to `target` (the buffer's own file when empty).
void App.write_file(str target) {
    Slot slot = active_slot();
    notice = write_slot(slot, target);
    path = slot.path;
    saved_current = slot.saved_current;
}

/// `:w` for every buffer that has changed (`:wall`).
void App.write_all() {
    save_active();
    int written = 0;
    for (Slot slot in slots) {
        if (!is_slot_modified(slot)) {
            continue;
        }
        if (slot.path.size() == 0) {
            notice = "E141: No file name for buffer " + slot.id.to_str();
            return;
        }
        str result = write_slot(slot, "");
        if (result.starts_with("E")) {
            notice = result;
            return;
        }
        written = written + 1;
    }
    Slot active = slots[index_of(current_id)];
    path = active.path;
    saved_current = active.saved_current;
    if (written > 0) {
        notice = written.to_str() + " buffer(s) written";
    }
}

/// Make buffer `id` the active one; the buffer left becomes the alternate.
void App.activate(int id) {
    save_active();
    int position = index_of(id);
    if (position < 0 || id == current_id) {
        return;
    }
    Slot target = slots[position];
    share_state(editor, target.editor);
    alternate_id = current_id;
    current_id = id;
    editor = target.editor;
    path = target.path;
    saved_current = target.saved_current;
    left_column = target.left_column;
    editor.view_height = text_rows(TUI_app.screen_size().rows);
}

/// Add `slot` to the session and make it active.
void App.adopt(Slot slot) {
    slots.push(slot);
    next_id = slot.id + 1;
    activate(slot.id);
}

/// `:e [file]`, `:e!`, `:e #`, `:enew`.
void App.edit(str target, bool is_forced) {
    str name = target.trim();
    if (name == "#") {
        switch_alternate();
        return;
    }
    if (name.size() == 0) {
        // re-read the file of this buffer
        if (!is_forced && is_modified()) {
            notice = "E37: No write since last change (add ! to override)";
            return;
        }
        match (read_slot(current_id, path)) {
            case Ok(Slot fresh): {
                MED_editor.Editor old = editor;
                share_state(old, fresh.editor);
                editor = fresh.editor;
                saved_current = fresh.saved_current;
                left_column = 0;
                save_active();
                notice = file_note(path, editor);
            }
            case Err(str message): {
                notice = message;
            }
        }
        return;
    }
    for (Slot known in slots) {
        if (known.path == name) {
            activate(known.id);
            notice = file_note(path, editor);
            return;
        }
    }
    match (read_slot(next_id, name)) {
        case Ok(Slot fresh): {
            adopt(fresh);
            notice = file_note(name, editor);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

/// `:enew`: a buffer with no name.
void App.new_buffer() {
    match (read_slot(next_id, "")) {
        case Ok(Slot fresh): {
            adopt(fresh);
        }
        case Err(str message): {
            notice = message;
        }
    }
}

void App.switch_alternate() {
    if (alternate_id == 0 || index_of(alternate_id) < 0) {
        notice = "E23: No alternate file";
        return;
    }
    activate(alternate_id);
    notice = file_note(path, editor);
}

/// The buffer `:b ARG` names: a number, `#`, `%`, or part of a file name that
/// only one buffer has. 0 when there is none, -1 when the name is ambiguous.
int App.find_buffer(str arg) {
    str word = arg.trim();
    if (word == "#") {
        return alternate_id;
    }
    if (word == "%") {
        return current_id;
    }
    match (word.parse_int()) {
        case Some(int number): {
            if (index_of(number) >= 0) {
                return number;
            }
            return 0;
        }
        case None: {
        }
    }
    int found = 0;
    int matches = 0;
    for (Slot slot in slots) {
        if (slot.path.contains(word)) {
            found = slot.id;
            matches = matches + 1;
        }
    }
    if (matches > 1) {
        return -1;
    }
    return found;
}

/// `:b ARG`.
void App.go_buffer(str arg) {
    if (arg.trim().size() == 0) {
        return;
    }
    save_active();
    int id = find_buffer(arg);
    if (id < 0) {
        notice = "E93: More than one match for " + arg.trim();
        return;
    }
    if (id == 0) {
        if (arg.trim() == "#") {
            notice = "E23: No alternate file";
        } else {
            notice = "E86: Buffer " + arg.trim() + " does not exist";
        }
        return;
    }
    activate(id);
    notice = file_note(path, editor);
}

/// `:bn`, `:bp`, `:bf`, `:bl` by position in the list; `step` wraps around.
void App.go_relative(int step, bool is_absolute) {
    save_active();
    int count = slots.size();
    int position = index_of(current_id);
    int target = 0;
    if (is_absolute) {
        if (step < 0) {
            target = count - 1;
        }
    } else {
        target = (position + step + count) % count;
    }
    activate(slots[target].id);
    notice = file_note(path, editor);
}

/// `:bd [N]`: drop a buffer; the last one is replaced by an empty buffer.
void App.delete_buffer(str arg, bool is_forced) {
    save_active();
    int id = current_id;
    if (arg.trim().size() > 0) {
        id = find_buffer(arg);
    }
    if (id <= 0) {
        notice = "E516: No buffers were deleted: bd " + arg.trim();
        return;
    }
    int position = index_of(id);
    Slot victim = slots[position];
    if (is_slot_modified(victim) && !is_forced) {
        notice = "E89: No write since last change for buffer " + id.to_str() + " (add ! to override)";
        return;
    }
    if (slots.size() == 1) {
        match (read_slot(next_id, "")) {
            case Ok(Slot fresh): {
                slots.push(fresh);
                next_id = fresh.id + 1;
            }
            case Err(str message): {
                notice = message;
                return;
            }
        }
    }
    if (id == current_id) {
        int target = alternate_id;
        if (target == 0 || target == id || index_of(target) < 0) {
            target = 0;
            for (Slot slot in slots) {
                if (slot.id != id && target == 0) {
                    target = slot.id;
                }
            }
        }
        activate(target);
    }
    slots.remove_at(index_of(id));
    if (alternate_id == id) {
        alternate_id = 0;
    }
}

/// The `:ls` listing, one line per buffer.
List<str> App.buffer_list() {
    save_active();
    List<str> lines = [];
    for (Slot slot in slots) {
        str flags = " ";
        if (slot.id == current_id) {
            flags = "%a";
        } else if (slot.id == alternate_id) {
            flags = "# ";
        } else {
            flags = "  ";
        }
        str modified = " ";
        if (is_slot_modified(slot)) {
            modified = "+";
        }
        str line = slot.id.to_str();
        while (line.size() < 3) {
            line = " " + line;
        }
        int row = slot.editor.row + 1;
        lines.push(line + " " + flags + " " + modified + " \"" + slot_name(slot) + "\" line " + row.to_str());
    }
    return lines;
}

/// Carry out what the engine asked of the UI layer.
void App.run_request(str request) {
    List<str> parts = split_request(request);
    str name = parts[0];
    str arg = parts[1];
    bool is_forced = name.ends_with("!");
    if (is_forced) {
        name = name.substr(0, name.size() - 1);
    }
    if (name == "write") {
        write_file(arg);
    } else if (name == "update") {
        if (is_modified() || arg.trim().size() > 0) {
            write_file(arg);
        }
    } else if (name == "wall") {
        write_all();
    } else if (name == "edit") {
        edit(arg, is_forced);
    } else if (name == "enew") {
        new_buffer();
    } else if (name == "buffer") {
        go_buffer(arg);
    } else if (name == "bnext") {
        go_relative(1, false);
    } else if (name == "bprevious" || name == "bNext") {
        go_relative(-1, false);
    } else if (name == "bfirst" || name == "brewind") {
        go_relative(1, true);
    } else if (name == "blast") {
        go_relative(-1, true);
    } else if (name == "bdelete" || name == "bwipeout" || name == "bunload") {
        delete_buffer(arg, is_forced);
    } else if (name == "ls" || name == "buffers" || name == "files") {
        overlay = buffer_list();
    } else if (name == "Files") {
        open_picker("files", arg);
    } else if (name == "Buffers") {
        open_picker("buffers", arg);
    } else if (name == "Grep") {
        open_picker("grep", arg);
    } else if (name == "Commands") {
        open_picker("commands", arg);
    } else if (name == "help") {
        open_picker("help", arg);
    } else if (name == "Explore") {
        open_picker("explore", arg);
    } else {
        notice = "Not supported yet: :" + request.trim();
    }
}

/// Run the pending requests, then say whether the editor should quit now. A
/// quit with unsaved changes is refused the way Vim refuses it (E37, or E162
/// for another buffer) unless it was forced.
bool App.did_finish() {
    List<str> requests = editor.requests;
    editor.requests = [];
    for (str request in requests) {
        run_request(request);
    }
    if (editor.message.contains("\n") && editor.mode != MED_editor.CMDLINE) {
        overlay = editor.message.split("\n");
    }
    if (!editor.is_quit) {
        return false;
    }
    editor.is_quit = false;
    bool is_forced = editor.is_force_quit;
    editor.is_force_quit = false;
    if (is_forced) {
        return true;
    }
    save_active();
    if (is_modified()) {
        notice = "E37: No write since last change (add ! to override)";
        return false;
    }
    for (Slot slot in slots) {
        if (is_slot_modified(slot)) {
            notice = "E162: No write since last change for buffer \"" + slot_name(slot) + "\" (add ! to override)";
            return false;
        }
    }
    return true;
}

// ------------------------------------------------------------------ pickers

/// Open the picker `name` (files, buffers, grep, commands, help, explore);
/// `arg` is the starting query of grep or the directory of the explorer.
void App.open_picker(str name, str arg) {
    overlay = [];
    is_leader = false;
    is_which_key = false;
    preview_path = "";
    is_grep_due = false;
    if (name == "files") {
        picker = MED_picker.make(MED_picker.KIND_FILES, "Files");
        root = MED_files.project_root();
        load_files();
    } else if (name == "buffers") {
        picker = MED_picker.make(MED_picker.KIND_BUFFERS, "Buffers");
        load_buffers();
    } else if (name == "grep") {
        picker = MED_picker.make(MED_picker.KIND_GREP, "Grep");
        root = MED_files.project_root();
        load_corpus();
        picker.query = arg.trim();
        run_grep();
    } else if (name == "commands") {
        picker = MED_picker.make(MED_picker.KIND_COMMANDS, "Commands");
        load_commands(false);
    } else if (name == "help") {
        picker = MED_picker.make(MED_picker.KIND_HELP, "Keymap");
        load_commands(true);
    } else if (name == "explore") {
        picker = MED_picker.make(MED_picker.KIND_EXPLORE, "Explore");
        picker.directory = parent_directory(path);
        if (arg.trim().size() > 0) {
            picker.directory = arg.trim();
        }
        load_directory();
    } else {
        notice = "Not supported yet: " + name;
        return;
    }
    has_picker = true;
    update_preview();
}

void App.load_files() {
    List<MED_picker.Entry> entries = [];
    for (str relative in MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used)) {
        entries.push(MED_picker.Entry(relative, path: MED_files.path_of(root, relative)));
    }
    picker.set_entries(entries);
}

void App.load_buffers() {
    save_active();
    List<MED_picker.Entry> entries = [];
    for (Slot slot in slots) {
        str text = slot.id.to_str() + "  " + slot_name(slot);
        if (is_slot_modified(slot)) {
            text = text + " [+]";
        }
        if (slot.id == current_id) {
            text = text + "  (current)";
        }
        entries.push(MED_picker.Entry(text, id: slot.id));
    }
    picker.set_entries(entries);
}

void App.load_commands(bool is_help) {
    List<MED_picker.Entry> entries = [];
    List<str> seen = [];
    List<MED_keymap.Binding> rows = [];
    for (MED_keymap.Binding row in MED_keymap.defaults()) {
        if (row.action.size() > 0) {
            rows.push(row);
        }
    }
    for (MED_keymap.Binding row in MED_keymap.commands()) {
        rows.push(row);
    }
    for (MED_keymap.Binding row in rows) {
        if (!is_help && seen.contains(row.label)) {
            continue;
        }
        seen.push(row.label);
        entries.push(MED_picker.Entry(MED_keymap.entry_text(row, is_help), action: row.action));
    }
    if (is_help) {
        for (MED_keymap.Binding row in MED_keymap.notes()) {
            entries.push(MED_picker.Entry(MED_keymap.entry_text(row, true)));
        }
    }
    picker.set_entries(entries);
}

void App.load_directory() {
    List<MED_picker.Entry> entries = [];
    entries.push(MED_picker.Entry("../", path: child_path(picker.directory, "..")));
    for (str name in MED_files.list_directory(picker.directory, picker.is_hidden_shown)) {
        str bare = name;
        if (name.ends_with("/")) {
            bare = name.substr(0, name.size() - 1);
        }
        entries.push(MED_picker.Entry(name, path: child_path(picker.directory, bare)));
    }
    picker.title = "Explore " + picker.directory;
    picker.query = "";
    picker.set_entries(entries);
}

/// Read the files grep searches (again after a toggle).
void App.load_corpus() {
    corpus = MED_grep.load(root, MED_files.list_files(root, picker.is_hidden_shown, picker.is_ignore_used));
}

void App.run_grep() {
    is_grep_due = false;
    List<MED_picker.Entry> entries = [];
    for (MED_grep.Hit hit in MED_grep.search(corpus, picker.query, picker.is_fixed)) {
        str text = hit.text.trim().split("\t").join(" ");
        entries.push(MED_picker.Entry(hit.path + ":" + (hit.line + 1).to_str() + ": " + text, path: MED_files.path_of(root, hit.path), line: hit.line, column: hit.column));
    }
    picker.set_entries(entries);
}

/// A toggle changed what the picker lists.
void App.reload_picker() {
    if (picker.kind == MED_picker.KIND_FILES) {
        load_files();
    } else if (picker.kind == MED_picker.KIND_GREP) {
        load_corpus();
        run_grep();
    } else if (picker.kind == MED_picker.KIND_EXPLORE) {
        load_directory();
    }
}

/// The lines previewed for the selection, read again only when the file changes.
void App.update_preview() {
    preview = MED_picker_view.Preview();
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            if (picker.kind == MED_picker.KIND_BUFFERS) {
                save_active();
                int position = index_of(entry.id);
                if (position >= 0) {
                    Slot slot = slots[position];
                    preview = MED_picker_view.Preview(title: slot_name(slot), lines: slot.editor.buffer.dump().split("\n"), focus: slot.editor.row);
                }
                return;
            }
            bool is_file = picker.kind == MED_picker.KIND_FILES || picker.kind == MED_picker.KIND_GREP || picker.kind == MED_picker.KIND_EXPLORE;
            if (!is_file || entry.path.size() == 0 || entry.text.ends_with("/")) {
                return;
            }
            if (entry.path != preview_path) {
                preview_lines = read_preview(entry.path);
                preview_path = entry.path;
            }
            int focus = -1;
            if (picker.kind == MED_picker.KIND_GREP) {
                focus = entry.line;
            }
            preview = MED_picker_view.Preview(title: entry.path, lines: preview_lines, focus: focus);
        }
        case None: {
        }
    }
}

/// Run an action row: `picker:NAME` or `ex:LINE`. True when the editor should quit.
bool App.should_quit_after_action(str action) {
    if (action.starts_with("picker:")) {
        open_picker(action.substr(7, action.size()), "");
        return false;
    }
    if (action.starts_with("ex:")) {
        MED_ex.feed(editor, 58);
        for (int code_point in action.substr(3, action.size()).chars()) {
            MED_ex.feed(editor, code_point);
        }
        MED_ex.feed(editor, MED_key.CARRIAGE_RETURN);
        return did_finish();
    }
    return false;
}

/// Enter in the picker. True when the editor should quit.
bool App.should_quit_after_accept() {
    match (picker.current()) {
        case Some(MED_picker.Entry entry): {
            int kind = picker.kind;
            if (kind == MED_picker.KIND_EXPLORE && entry.text.ends_with("/")) {
                if (entry.text == "../") {
                    picker.directory = up_directory(picker.directory);
                } else {
                    picker.directory = entry.path;
                }
                load_directory();
                update_preview();
                return false;
            }
            has_picker = false;
            if (kind == MED_picker.KIND_FILES || kind == MED_picker.KIND_EXPLORE) {
                edit(entry.path, false);
            } else if (kind == MED_picker.KIND_BUFFERS) {
                go_buffer(entry.id.to_str());
            } else if (kind == MED_picker.KIND_GREP) {
                edit(entry.path, false);
                editor.row = entry.line;
                editor.col = entry.column;
                editor.clamp();
                editor.want_from_cursor();
            } else if (entry.action.size() > 0) {
                return should_quit_after_action(entry.action);
            }
        }
        case None: {
            has_picker = false;
        }
    }
    return false;
}

/// One event while a picker is open.
TUI_app.Action App.handle_picker(term.Event event) {
    List<int> keys = [];
    match (event) {
        case Key(term.Key key): {
            keys = keys_of_key(key);
        }
        case Paste(str text): {
            for (int code_point in text.chars()) {
                if (code_point >= 32) {
                    keys.push(code_point);
                }
            }
        }
        case Mouse(term.Mouse mouse): {
        }
        case Unknown(bytes data): {
        }
    }
    for (int key in keys) {
        match (picker.feed(key)) {
            case Stay: {
            }
            case Accept: {
                if (should_quit_after_accept()) {
                    return TUI_app.Action.Quit;
                }
            }
            case Cancel: {
                has_picker = false;
            }
            case Requery: {
                is_grep_due = true;
                idle_ms = 0;
            }
            case Reload: {
                reload_picker();
            }
            case Up: {
                picker.directory = up_directory(picker.directory);
                load_directory();
            }
        }
        if (!has_picker) {
            break;
        }
    }
    if (has_picker) {
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

// -------------------------------------------------------------- leader keys

void App.cancel_leader() {
    is_leader = false;
    is_which_key = false;
    leader = "";
}

/// One key after <Space>. True when the editor should quit.
bool App.should_quit_after_leader(int key) {
    if (key < 32 || key > 126) {
        cancel_leader();
        return false;
    }
    leader = leader + str.from_chars([key]);
    List<MED_keymap.Binding> table = MED_keymap.defaults();
    int found = MED_keymap.lookup(table, leader);
    if (found == MED_keymap.IS_LEAF) {
        MED_keymap.Binding row = MED_keymap.leaf(table, leader);
        cancel_leader();
        return should_quit_after_action(row.action);
    }
    if (found == MED_keymap.IS_PREFIX) {
        leader_ms = 0;
        return false;
    }
    notice = "No mapping for <Space>" + leader;
    cancel_leader();
    return false;
}

/// The timer: which-key after a pending leader waits, and the grep debounce.
pub TUI_app.Action App.tick(int elapsed_ms) {
    if (is_leader && !is_which_key) {
        leader_ms = leader_ms + elapsed_ms;
        if (leader_ms >= MED_keymap.WHICH_KEY_MS) {
            is_which_key = true;
            return TUI_app.Action.Redraw;
        }
    }
    if (has_picker && is_grep_due) {
        idle_ms = idle_ms + elapsed_ms;
        if (idle_ms >= GREP_DEBOUNCE_MS) {
            run_grep();
            update_preview();
            return TUI_app.Action.Redraw;
        }
    }
    return TUI_app.Action.Continue;
}

/// One key for the engine, with the front end's own mappings first. True when
/// the editor should quit.
bool App.should_quit_after(int key) {
    if (is_leader) {
        return should_quit_after_leader(key);
    }
    if (editor.mode == MED_editor.NORMAL && key == MED_key.SPACE && editor.pending.size() == 0) {
        is_leader = true;
        is_which_key = false;
        leader = "";
        leader_ms = 0;
        return false;
    }
    int sent = key;
    if (editor.mode == MED_editor.INSERT && key == 107 && last_key == 106) {
        // jk: take back the j and leave Insert mode
        MED_ex.feed(editor, MED_key.BACKSPACE);
        sent = MED_key.ESC;
    } else if (editor.mode == MED_editor.CMDLINE && editor.cmd_type == 58 && editor.cmdline.size() == 0 && key == MED_key.CARRIAGE_RETURN) {
        // Enter on an empty `:` opens the palette
        MED_ex.feed(editor, MED_key.ESC);
        open_picker("commands", "");
        last_key = 0;
        return false;
    }
    last_key = sent;
    if (sent == MED_key.ESC) {
        last_key = 0;
    }
    MED_ex.feed(editor, sent);
    return did_finish();
}

/// One event: feed its keys to the engine, then the UI requests.
pub TUI_app.Action App.handle(term.Event event) {
    if (has_picker) {
        return handle_picker(event);
    }
    List<int> keys = keys_of(event);
    if (keys.size() == 0) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    if (overlay.size() > 0) {
        // the listing goes away with the next key; Enter, Space and Esc only dismiss it
        overlay = [];
        if (keys.size() == 1 && (keys[0] == MED_key.CARRIAGE_RETURN || keys[0] == 32 || keys[0] == MED_key.ESC)) {
            return TUI_app.Action.Redraw;
        }
    }
    editor.view_height = text_rows(TUI_app.screen_size().rows);
    for (int key in keys) {
        if (has_picker) {
            // a request opened a picker; the rest of the keys are its
            picker.feed(key);
            continue;
        }
        if (should_quit_after(key)) {
            return TUI_app.Action.Quit;
        }
    }
    if (has_picker) {
        update_preview();
    }
    return TUI_app.Action.Redraw;
}

/// The byte offset in line `row` of the character shown at display column `spot`.
int App.offset_at(int row, int spot) {
    str line = editor.buffer.line(row);
    int shown_to = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        shown_to = shown_to + MED_text.cell_width(line, offset, shown_to, editor.tab);
        if (spot < shown_to) {
            return offset;
        }
    }
    return line.size();
}

/// Put the cursor on the text cell under the pointer; false outside the text.
bool App.did_place_cursor(int x_cell, int y_cell) {
    int rows = text_rows(TUI_app.screen_size().rows);
    if (y_cell < 0 || y_cell >= rows) {
        return false;
    }
    int row = editor.view_top + y_cell;
    if (row >= editor.buffer.line_count()) {
        row = editor.buffer.line_count() - 1;
    }
    int spot = left_column;
    if (x_cell > gutter_width()) {
        spot = spot + x_cell - gutter_width();
    }
    editor.row = row;
    editor.col = offset_at(row, spot);
    editor.clamp();
    editor.want_from_cursor();
    return true;
}

/// A mouse gesture: a press puts the cursor there, a drag selects, the wheel scrolls.
pub TUI_app.Action App.handle_mouse(TUI_mouse.Routed routed) {
    TUI_mouse.Gesture gesture = routed.gesture;
    if (has_picker) {
        return handle_picker_wheel(gesture);
    }
    if (is_leader) {
        cancel_leader();
    }
    if (editor.mode == MED_editor.CMDLINE || editor.mode == MED_editor.REPLACE) {
        return TUI_app.Action.Continue;
    }
    notice = "";
    overlay = [];
    editor.view_height = text_rows(TUI_app.screen_size().rows);
    match (gesture.kind) {
        case Press: {
            if (gesture.button == 0) {
                if (editor.mode == MED_editor.VISUAL) {
                    MED_ex.feed(editor, MED_key.ESC);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case Drag: {
            if (gesture.button == 0) {
                if (editor.mode == MED_editor.NORMAL) {
                    MED_ex.feed(editor, VKIND_CHAR);
                }
                if (did_place_cursor(gesture.x, gesture.y)) {
                    return TUI_app.Action.Redraw;
                }
            }
        }
        case ScrollUp: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 25);
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollDown: {
            for (int step in 0 .. WHEEL_LINES) {
                MED_ex.feed(editor, 5);
            }
            return TUI_app.Action.Redraw;
        }
        case Release: {
        }
        case Click: {
        }
        case Hover: {
        }
        case Leave: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
    return TUI_app.Action.Continue;
}

str App.mode_name() {
    if (editor.mode == MED_editor.INSERT) {
        return "INSERT";
    }
    if (editor.mode == MED_editor.REPLACE) {
        return "REPLACE";
    }
    if (editor.mode == MED_editor.CMDLINE) {
        return "COMMAND";
    }
    if (editor.mode == MED_editor.VISUAL) {
        if (editor.vkind == VKIND_CHAR) {
            return "VISUAL";
        }
        if (editor.vkind == VKIND_LINE) {
            return "V-LINE";
        }
        return "V-BLOCK";
    }
    return "NORMAL";
}

/// The columns of the line-number gutter, with its trailing space.
int App.gutter_width() {
    int digits = editor.buffer.line_count().to_str().size();
    if (digits < MIN_DIGITS) {
        digits = MIN_DIGITS;
    }
    return digits + 1;
}

/// Whether the character at (`row`, `col`), shown from display column `spot`,
/// is inside the Visual selection.
bool App.is_selected(int row, int col, int spot) {
    if (editor.mode != MED_editor.VISUAL) {
        return false;
    }
    MED_buffer.Pos anchor = MED_buffer.Pos(editor.vrow, editor.vcol);
    MED_buffer.Pos cursor = editor.cursor();
    MED_buffer.Pos first = anchor;
    MED_buffer.Pos last = cursor;
    if (anchor.cmp(cursor) > 0) {
        first = cursor;
        last = anchor;
    }
    if (row < first.row || row > last.row) {
        return false;
    }
    if (editor.vkind == VKIND_LINE) {
        return true;
    }
    if (editor.vkind == VKIND_CHAR) {
        MED_buffer.Pos here = MED_buffer.Pos(row, col);
        return here.cmp(first) >= 0 && here.cmp(last) <= 0;
    }
    int anchor_spot = MED_text.display_col(editor.buffer.line(editor.vrow), editor.vcol, editor.tab);
    int cursor_spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int low = anchor_spot;
    int high = cursor_spot;
    if (anchor_spot > cursor_spot) {
        low = cursor_spot;
        high = anchor_spot;
    }
    return spot >= low && spot <= high;
}

/// Draw one line of text at screen row `y`.
void App.draw_line(TUI_buffer.Buffer buffer, int row, int x_start, int y, int text_width) {
    str line = editor.buffer.line(row);
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style selected = TUI_style.Style(background: TUI_style.Colour.Indexed(SELECTION_COLOUR));
    int spot = 0;
    for (int offset in MED_text.starts(line)) {
        if (offset >= line.size()) {
            break;
        }
        int width = MED_text.cell_width(line, offset, spot, editor.tab);
        int next = MED_text.next_col(line, offset);
        if (spot >= left_column && spot + width <= left_column + text_width) {
            TUI_style.Style style = plain;
            if (is_selected(row, offset, spot)) {
                style = selected;
            }
            buffer.set_str(x_start + spot - left_column, y, shown(line, offset, next, width), style);
        }
        spot = spot + width;
        if (spot >= left_column + text_width) {
            break;
        }
    }
}

/// The pending keys of an unfinished command (`2d`), as typed.
str App.pending_text() {
    if (is_leader) {
        return "<Space>" + leader;
    }
    str out = "";
    for (int key in editor.pending) {
        if (key >= 32 && key < 127) {
            out = out + str.from_chars([key]);
        } else if (key > 0 && key < 32) {
            out = out + "^" + str.from_chars([key + 64]);
        }
    }
    return out;
}

/// The status line: mode, name, modified flag on the left; position on the right.
void App.draw_status(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int y) {
    TUI_style.Style bar = TUI_style.Style(attrs: TUI_style.REVERSE);
    TUI_style.Style strong = TUI_style.Style(attrs: TUI_style.REVERSE | TUI_style.BOLD);
    buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", bar);
    str name = path;
    if (name.size() == 0) {
        name = "[No Name]";
    }
    if (is_modified()) {
        name = name + " [+]";
    }
    int used = buffer.set_str(area.x, y, " " + mode_name() + " ", strong);
    buffer.set_str(area.x + used, y, " " + name, bar);
    int vcol = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    int count = editor.buffer.line_count();
    int percent = (editor.row + 1) * 100 / count;
    str where = (editor.row + 1).to_str() + ":" + (vcol + 1).to_str() + "  " + percent.to_str() + "% ";
    int where_x = area.x + area.width - where.size();
    if (where_x > area.x + used + name.size() + 2) {
        buffer.set_str(where_x, y, where, bar);
    }
}

/// The command line (while typing `:` or `/`) or the message.
void App.draw_message(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int y) {
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style alert = TUI_style.Style(foreground: TUI_style.Colour.Indexed(1), attrs: TUI_style.BOLD);
    if (editor.mode == MED_editor.CMDLINE) {
        buffer.set_str(area.x, y, str.from_chars([editor.cmd_type]) + editor.cmdline, plain, max: area.width);
        return;
    }
    str text = notice;
    if (text.size() == 0) {
        text = editor.message;
    }
    text = first_line(text);
    TUI_style.Style style = plain;
    if (is_error_text(text)) {
        style = alert;
    }
    buffer.set_str(area.x, y, text, style, max: area.width);
    str right = pending_text();
    if (editor.macro_reg.size() > 0) {
        right = "recording @" + editor.macro_reg + " " + right;
    }
    if (right.size() > 0 && text.size() + right.size() + 2 < area.width) {
        buffer.set_str(area.x + area.width - right.size() - 1, y, right, plain);
    }
}

/// The listing over the bottom of the text window, with Vim's prompt.
void App.draw_overlay(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int rows) {
    TUI_style.Style plain = TUI_style.Style.plain;
    TUI_style.Style prompt = TUI_style.Style(foreground: TUI_style.Colour.Indexed(2));
    List<str> lines = overlay.slice(0, overlay.size());
    int shown_lines = lines.size() + 1;
    if (shown_lines > rows) {
        shown_lines = rows;
    }
    int top = area.y + rows - shown_lines;
    for (int position in 0 .. shown_lines) {
        buffer.fill(TUI_geometry.Rect(area.x, top + position, area.width, 1), " ", plain);
        if (position < shown_lines - 1) {
            buffer.set_str(area.x, top + position, lines[position], plain, max: area.width);
        } else {
            buffer.set_str(area.x, top + position, "Press ENTER or type command to continue", prompt, max: area.width);
        }
    }
}

/// Draw the whole screen.
pub void App.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int rows = text_rows(area.height);
    editor.view_height = rows;
    MED_view.update(editor);
    int gutter = gutter_width();
    int text_width = area.width - gutter;
    if (text_width < 1) {
        text_width = 1;
    }
    int cursor_spot = MED_text.display_col(editor.buffer.line(editor.row), editor.col, editor.tab);
    if (cursor_spot < left_column) {
        left_column = cursor_spot;
    }
    if (cursor_spot >= left_column + text_width) {
        left_column = cursor_spot - text_width + 1;
    }
    TUI_style.Style dim = TUI_style.Style(attrs: TUI_style.DIM);
    TUI_style.Style filler = TUI_style.Style(foreground: TUI_style.Colour.Indexed(4));
    TUI_style.Style current = TUI_style.Style(attrs: TUI_style.BOLD);
    for (int screen_row in 0 .. rows) {
        int row = editor.view_top + screen_row;
        int y = area.y + screen_row;
        if (row >= editor.buffer.line_count()) {
            buffer.set_str(area.x, y, "~", filler);
        } else {
            str number = (row + 1).to_str();
            TUI_style.Style number_style = dim;
            if (row == editor.row) {
                number_style = current;
            }
            buffer.set_str(area.x + gutter - 1 - number.size(), y, number, number_style);
            draw_line(buffer, row, area.x + gutter, y, text_width);
        }
    }
    if (overlay.size() > 0) {
        draw_overlay(buffer, area, rows);
    }
    if (is_leader && is_which_key) {
        TUI_menu.WhichKey menu = TUI_menu.WhichKey("<Space>" + leader, MED_keymap.next_items(MED_keymap.defaults(), leader));
        menu.render(buffer, TUI_geometry.Rect(area.x, area.y, area.width, rows));
    }
    if (has_picker) {
        picker.scroll_to(MED_picker_view.list_rows(area));
        if (preview.focus >= 0) {
            preview.first = preview.focus - MED_picker_view.list_rows(area) / 3;
            if (preview.first < 0) {
                preview.first = 0;
            }
        }
        MED_picker_view.render(buffer, area, picker, preview);
    }
    draw_status(buffer, area, area.y + rows);
    draw_message(buffer, area, area.y + rows + 1);
    TUI_style.Style cursor_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    if (overlay.size() > 0 || has_picker || is_leader) {
        return;
    }
    if (editor.mode == MED_editor.CMDLINE) {
        int cursor_x = area.x + 1 + MED_text.line_width(editor.cmdline, editor.tab);
        if (cursor_x < area.x + area.width) {
            buffer.set_style(cursor_x, area.y + rows + 1, cursor_style);
        }
    } else {
        buffer.set_style(area.x + gutter + cursor_spot - left_column, area.y + editor.row - editor.view_top, cursor_style);
    }
}

/// The mouse wheel moves the picker's selection; nothing else is handled.
TUI_app.Action App.handle_picker_wheel(TUI_mouse.Gesture gesture) {
    match (gesture.kind) {
        case ScrollUp: {
            picker.feed(MED_key.UP_KEY);
        }
        case ScrollDown: {
            picker.feed(MED_key.DOWN);
        }
        case Press: {
            return TUI_app.Action.Continue;
        }
        case Drag: {
            return TUI_app.Action.Continue;
        }
        case Release: {
            return TUI_app.Action.Continue;
        }
        case Click: {
            return TUI_app.Action.Continue;
        }
        case Hover: {
            return TUI_app.Action.Continue;
        }
        case Leave: {
            return TUI_app.Action.Continue;
        }
        case ScrollLeft: {
            return TUI_app.Action.Continue;
        }
        case ScrollRight: {
            return TUI_app.Action.Continue;
        }
    }
    update_preview();
    return TUI_app.Action.Redraw;
}

/// Write `slot`'s text to `target` (its own file when `target` is empty) and
/// say what happened, in Vim's words.
str write_slot(Slot slot, str target) {
    str name = target.trim();
    if (name.size() == 0) {
        name = slot.path;
    }
    if (name.size() == 0) {
        return "E32: No file name";
    }
    str text = slot.editor.buffer.dump();
    match (io.write(name, text)) {
        case Ok(int count): {
            if (slot.path.size() == 0) {
                slot.path = name;
                slot.editor.buffer.path = name;
            }
            if (name == slot.path) {
                slot.saved_current = slot.editor.current;
                slot.editor.saved_nodes.push(slot.editor.current);
                slot.editor.buffer.is_modified = false;
            }
            return "\"" + name + "\" " + slot.editor.buffer.line_count().to_str() + "L, " + count.to_str() + "B written";
        }
        case Err(io.Error error): {
            return "E212: Can't open file for writing: " + error.to_str();
        }
    }
}

/// Whether the buffer of `slot` differs from its file.
bool is_slot_modified(Slot slot) {
    return slot.editor.current != slot.saved_current;
}

/// How `:ls` and the errors name a buffer.
str slot_name(Slot slot) {
    if (slot.path.size() == 0) {
        return "[No Name]";
    }
    return slot.path;
}

/// What the engine keeps across buffers: registers, search and substitute
/// state, the dot command, histories and the options.
void share_state(MED_editor.Editor from, MED_editor.Editor into) {
    into.regs = from.regs;
    into.search_pattern = from.search_pattern;
    into.search_directory = from.search_directory;
    into.sub_pattern = from.sub_pattern;
    into.sub_replacement = from.sub_replacement;
    into.sub_flags = from.sub_flags;
    into.sub_old = from.sub_old;
    into.is_sub_has = from.is_sub_has;
    into.is_last_is_sub = from.is_last_is_sub;
    into.is_search_no_scs = from.is_search_no_scs;
    into.is_search_off_line = from.is_search_off_line;
    into.is_search_off_end = from.is_search_off_end;
    into.search_off = from.search_off;
    into.search_typed = from.search_typed;
    into.is_no_hl = from.is_no_hl;
    into.hist_ex = from.hist_ex;
    into.hist_search = from.hist_search;
    into.last_macro = from.last_macro;
    into.dot = from.dot;
    into.dot_reg = from.dot_reg;
    into.dot_count = from.dot_count;
    into.dot_body = from.dot_body;
    into.dot_tail = from.dot_tail;
    into.dot_vkind = from.dot_vkind;
    into.dot_vlines = from.dot_vlines;
    into.dot_vcols = from.dot_vcols;
    into.dot_vwant = from.dot_vwant;
    into.find = from.find;
    into.is_hexupper = from.is_hexupper;
    into.tab = from.tab;
    into.shiftwidth = from.shiftwidth;
    into.is_expandtab = from.is_expandtab;
    into.is_autoindent = from.is_autoindent;
    into.is_ignorecase = from.is_ignorecase;
    into.is_smartcase = from.is_smartcase;
    into.is_wrapscan = from.is_wrapscan;
    into.is_joinspaces = from.is_joinspaces;
    into.is_startofline = from.is_startofline;
    into.scroll_opt = from.scroll_opt;
    into.view_height = from.view_height;
}

/// Vim's "file info" message for a buffer just read.
str file_note(str name, MED_editor.Editor loaded) {
    if (name.size() == 0) {
        return "";
    }
    if (fs.is_present(name)) {
        return "\"" + name + "\" " + loaded.buffer.line_count().to_str() + "L, " + loaded.buffer.dump().size().to_str() + "B";
    }
    return "\"" + name + "\" [New]";
}

/// A new slot holding `name` (an empty buffer when the file does not exist yet
/// or `name` is empty); an error for a directory or an unreadable file.
Result<Slot, str> read_slot(int id, str name) {
    str text = "";
    if (name.size() > 0) {
        if (fs.is_directory(name)) {
            return Result<Slot, str>.Err("\"" + name + "\" is a directory");
        }
        if (fs.is_present(name)) {
            match (io.read(name)) {
                case Ok(str content): {
                    text = content;
                }
                case Err(io.Error error): {
                    return Result<Slot, str>.Err("\"" + name + "\": " + error.to_str());
                }
            }
        }
    }
    MED_editor.Editor loaded = MED_editor.new(text);
    loaded.buffer.path = name;
    return Result<Slot, str>.Ok(Slot(id, loaded, name));
}

/// Split "name arg" into its two parts.
List<str> split_request(str request) {
    match (request.index_of(" ")) {
        case Some(int position): {
            return [request.substr(0, position), request.substr(position + 1, request.size())];
        }
        case None: {
            return [request, ""];
        }
    }
}

/// Open `path` (a new empty buffer when the file does not exist; an empty path
/// is a buffer with no name).
pub Result<App, str> open(str path) {
    return open_all([path]);
}

/// Open several files as buffers; the first is shown.
pub Result<App, str> open_all(List<str> paths) {
    App app = App(MED_editor.new(""), "");
    app.next_id = 1;
    bool is_first = true;
    for (str path in paths) {
        match (read_slot(app.next_id, path)) {
            case Ok(Slot slot): {
                if (is_first) {
                    app.slots.push(slot);
                    app.current_id = slot.id;
                    app.editor = slot.editor;
                    app.path = path;
                    app.next_id = slot.id + 1;
                    app.notice = file_note(path, slot.editor);
                    is_first = false;
                } else {
                    slot.editor.view_height = app.editor.view_height;
                    app.slots.push(slot);
                    app.next_id = slot.id + 1;
                }
            }
            case Err(str message): {
                return Result<App, str>.Err(message);
            }
        }
    }
    if (is_first) {
        return Result<App, str>.Err("no buffer");
    }
    return Result<App, str>.Ok(app);
}

/// Where the last `/` of `text` is, or -1.
int last_slash(str text) {
    int spot = text.size() - 1;
    while (spot >= 0) {
        if (text.byte_at(spot) == 47) {
            return spot;
        }
        spot = spot - 1;
    }
    return -1;
}

/// The directory of a file path ("." when it has none).
str parent_directory(str file) {
    int spot = last_slash(file);
    if (spot < 0) {
        return ".";
    }
    if (spot == 0) {
        return "/";
    }
    return file.substr(0, spot);
}

/// The directory above `directory`.
str up_directory(str directory) {
    if (directory == ".") {
        return "..";
    }
    if (directory == ".." || directory.ends_with("/..") || directory == "/") {
        if (directory == "/") {
            return "/";
        }
        return directory + "/..";
    }
    return parent_directory(directory);
}

str child_path(str directory, str name) {
    if (directory == ".") {
        return name;
    }
    if (directory.ends_with("/")) {
        return directory + name;
    }
    return directory + "/" + name;
}

/// The lines of a file for the preview pane.
List<str> read_preview(str file) {
    if (!fs.is_file(file)) {
        return ["(not a file)"];
    }
    match (io.read(file)) {
        case Ok(str text): {
            if (text.size() > MED_grep.MAX_BYTES) {
                return ["(file too large to preview)"];
            }
            for (int spot in 0 .. 512) {
                if (spot < text.size() && text.byte_at(spot) == 0) {
                    return ["(binary file)"];
                }
            }
            List<str> lines = text.split("\n");
            if (lines.size() > PREVIEW_LINES) {
                return lines.slice(0, PREVIEW_LINES);
            }
            return lines;
        }
        case Err(io.Error error): {
            return ["(cannot read: " + error.to_str() + ")"];
        }
    }
}

/// The rows of text for a window of `rows` rows.
pub int text_rows(int rows) {
    if (rows - FOOTER_ROWS < 1) {
        return 1;
    }
    return rows - FOOTER_ROWS;
}

/// The engine key for a terminal key code, or -1 when it has none.
int key_code(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return MED_key.CARRIAGE_RETURN;
        }
        case Tab: {
            return MED_key.TAB;
        }
        case BackTab: {
            return -1;
        }
        case Backspace: {
            return MED_key.BACKSPACE;
        }
        case Escape: {
            return MED_key.ESC;
        }
        case Up: {
            return MED_key.UP_KEY;
        }
        case Down: {
            return MED_key.DOWN;
        }
        case Right: {
            return MED_key.RIGHT;
        }
        case Left: {
            return MED_key.LEFT;
        }
        case Home: {
            return MED_key.HOME;
        }
        case End: {
            return MED_key.END;
        }
        case PageUp: {
            return MED_key.PAGE_UP;
        }
        case PageDown: {
            return MED_key.PAGE_DOWN;
        }
        case Insert: {
            return MED_key.INSERT;
        }
        case Delete: {
            return MED_key.DEL;
        }
        case F(int number): {
            if (number >= 1 && number <= 12) {
                return MED_key.FKEY_BASE + number;
            }
            return -1;
        }
    }
}

/// The code point of a character key, or -1 for any other key.
int char_of(term.Code code) {
    match (code) {
        case Char(int code_point): {
            return code_point;
        }
        case Enter: {
            return -1;
        }
        case Tab: {
            return -1;
        }
        case BackTab: {
            return -1;
        }
        case Backspace: {
            return -1;
        }
        case Escape: {
            return -1;
        }
        case Up: {
            return -1;
        }
        case Down: {
            return -1;
        }
        case Right: {
            return -1;
        }
        case Left: {
            return -1;
        }
        case Home: {
            return -1;
        }
        case End: {
            return -1;
        }
        case PageUp: {
            return -1;
        }
        case PageDown: {
            return -1;
        }
        case Insert: {
            return -1;
        }
        case Delete: {
            return -1;
        }
        case F(int number): {
            return -1;
        }
    }
}

/// The control character of a letter or one of `@ [ \ ] ^ _`, or -1.
int control_of(int code_point) {
    if (code_point >= 97 && code_point <= 122) {
        return code_point - 96;
    }
    if (code_point >= 64 && code_point <= 95) {
        return code_point & 31;
    }
    return -1;
}

/// The engine keys for one terminal key press: Alt is an Escape first, Ctrl on
/// a character is its control code, Shift/Ctrl on a special key are modifier
/// bits.
pub List<int> keys_of_key(term.Key key) {
    List<int> keys = [];
    int code = key_code(key.code);
    if (code < 0) {
        return keys;
    }
    bool is_special = code >= MED_key.UP_KEY;
    int code_point = char_of(key.code);
    if (key.has_modifiers(term.CTRL) && code_point >= 0) {
        code = control_of(code_point);
        if (code < 0) {
            return keys;
        }
    }
    if (is_special) {
        if (key.has_modifiers(term.CTRL)) {
            code = code | MED_key.MOD_CTRL;
        }
        if (key.has_modifiers(term.SHIFT)) {
            code = code | MED_key.MOD_SHIFT;
        }
    }
    if (key.has_modifiers(term.ALT)) {
        keys.push(MED_key.ESC);
    }
    keys.push(code);
    return keys;
}

/// What a character shows as: a tab is blanks, a control character is `^X`.
str shown(str line, int col, int next, int width) {
    int code_point = MED_text.cp_at(line, col);
    if (code_point == 9) {
        return " ".repeat(width);
    }
    if (code_point >= 0 && code_point < 32) {
        return "^" + str.from_chars([code_point + 64]);
    }
    if (code_point == 127) {
        return "^?";
    }
    return line.substr(col, next);
}

/// The first line of a message.
str first_line(str text) {
    List<str> parts = text.split("\n");
    return parts[0];
}

bool is_error_text(str text) {
    if (text.size() < 2 || text.byte_at(0) != 69) {
        return false;
    }
    int second = text.byte_at(1);
    return second >= 48 && second <= 57;
}
