// m3d1tor: a terminal modal editor in m31.
//
//   m3d1tor FILE...   open the files as buffers (a new buffer when one does not exist yet)
//   m3d1tor           an empty buffer with no name
//   m3d1tor -u FILE   read FILE as the keymap file (-u NONE reads none)
//
// The keymap file holds ex lines (`nnoremap`, `let mapleader`, `set` ...); by
// default it is $XDG_CONFIG_HOME/m3d1tor/keymap.vim (~/.config/...).
//
// Vim keys (the engine is checked against nvim, see DESIGN.md), `:w` writes,
// `:q` quits (`:q!` discards, `:wq` / `ZZ` write and quit).

import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.core.TUI_mouse;
import ui.MED_app;

List<str> arguments = os.arguments();
if (!term.is_terminal(0) || !term.is_terminal(1)) {
    io.eprint("m3d1tor: needs a terminal on standard input and output\n");
    os.exit(1);
}
List<str> files = [];
// -u FILE reads that keymap file, -u NONE reads none
str keymap = MED_app.keymap_path();
bool is_keymap_required = false;
int arg_index = 1;
while (arg_index < arguments.size()) {
    if (arguments[arg_index] == "-u" && arg_index + 1 < arguments.size()) {
        keymap = arguments[arg_index + 1];
        is_keymap_required = true;
        if (keymap == "NONE") {
            keymap = "";
        }
        arg_index = arg_index + 2;
    } else {
        files.push(arguments[arg_index]);
        arg_index = arg_index + 1;
    }
}
if (files.size() == 0) {
    files.push("");
}
match (MED_app.open_all(files)) {
    case Ok(MED_app.App app): {
        app.load_keymap(keymap, is_keymap_required);
        TUI_app.Loop loop = TUI_app.Loop(should_report_paste: true, should_report_mouse: true, animate_ms: 50);
        match (loop.run_with((TUI_buffer.Buffer buffer, TUI_geometry.Rect area) => app.render(buffer, area), (term.Event event) => app.handle(event), (int elapsed_ms) => app.tick(elapsed_ms), (TUI_mouse.Routed routed) => app.handle_mouse(routed))) {
            case Ok(int frames): {
            }
            case Err(term.Error error): {
                io.eprint("m3d1tor: " + error.to_str() + "\n");
                os.exit(1);
            }
        }
    }
    case Err(str message): {
        io.eprint("m3d1tor: " + message + "\n");
        os.exit(1);
    }
}
