// Unit checks for MED_git.diff.

import ui.MED_git;
import tests.MED_check;

MED_check.Check check = MED_check.Check();
MED_git.Hunks same = MED_git.diff(["a", "b"], ["a", "b"]);
check.eq_int("no hunks", same.starts.size(), 0);
MED_git.Hunks added = MED_git.diff(["a", "c"], ["a", "b", "c"]);
check.eq_int("added row", added.kinds[1], MED_git.ADDED);
check.eq_int("added start", added.starts[0], 1);
MED_git.Hunks changed = MED_git.diff(["a", "b", "c"], ["a", "x", "c"]);
check.eq_int("changed row", changed.kinds[1], MED_git.CHANGED);
check.eq_int("others untouched", changed.kinds[0], MED_git.NONE);
MED_git.Hunks removed = MED_git.diff(["a", "b", "c"], ["a", "c"]);
check.eq_int("removed marks the row above", removed.kinds[0], MED_git.REMOVED);
MED_git.Hunks mixed = MED_git.diff(["a", "b", "c", "d"], ["a", "x", "y", "c"]);
check.eq_int("changed", mixed.kinds[1], MED_git.CHANGED);
check.eq_int("added after the change", mixed.kinds[2], MED_git.ADDED);
check.eq_int("removed after", mixed.starts.size(), 2);
MED_git.Hunks grown = MED_git.diff(["a"], ["a", "b", "c"]);
check.eq_int("appended rows", grown.kinds[2], MED_git.ADDED);
MED_git.Hunks cleared = MED_git.diff(["a", "b"], []);
check.eq_int("everything removed", cleared.starts.size(), 1);
check.eq_int("next", MED_git.next_start(mixed, 0, true), 1);
check.eq_int("previous", MED_git.next_start(mixed, 5, false), mixed.starts[1]);
// hunk details and patches
MED_git.Hunks by_change = MED_git.diff(["a", "b", "c"], ["a", "x", "c"]);
check.eq_int("hunk_at", MED_git.hunk_at(by_change, 1), 0);
check.eq_int("hunk_at outside", MED_git.hunk_at(by_change, 0), -1);
check.eq_str("change patch", MED_git.hunk_patch(by_change, 0, ["a", "b", "c"], ["a", "x", "c"], "f.txt"), "--- a/f.txt\n+++ b/f.txt\n@@ -2,1 +2,1 @@\n-b\n+x\n");
MED_git.Hunks by_add = MED_git.diff(["a", "c"], ["a", "b", "c"]);
check.eq_str("add patch", MED_git.hunk_patch(by_add, 0, ["a", "c"], ["a", "b", "c"], "f.txt"), "--- a/f.txt\n+++ b/f.txt\n@@ -1,0 +2,1 @@\n+b\n");
MED_git.Hunks by_remove = MED_git.diff(["a", "b", "c"], ["a", "c"]);
check.eq_str("remove patch", MED_git.hunk_patch(by_remove, 0, ["a", "b", "c"], ["a", "c"], "f.txt"), "--- a/f.txt\n+++ b/f.txt\n@@ -2,1 +1,0 @@\n-b\n");
check.eq_int("removal hunk found from the row below", MED_git.hunk_at(by_remove, 1), 0);
check.eq_str("preview header", MED_git.hunk_preview(by_change, 0, ["a", "b", "c"], ["a", "x", "c"])[0], "@@ -2,1 +2,1 @@");
// large files: the common head and tail are cut off first, so one edit in
// 100000 lines is cheap, and a middle too big for the exact diff is one hunk
List<str> big_base = [];
List<str> big_current = [];
for (int row in 0 .. 100000) {
    big_base.push("line " + row.to_str());
    if (row == 50000) {
        big_current.push("edited");
    } else {
        big_current.push("line " + row.to_str());
    }
}
MED_git.Hunks big = MED_git.diff(big_base, big_current);
check.eq_int("one edit in a big file is one hunk", big.starts.size(), 1);
check.eq_int("at the edited row", big.starts[0], 50000);
check.eq_int("the kinds cover every row", big.kinds.size(), 100000);
List<str> other = [];
for (int row in 0 .. 3000) {
    other.push("other " + row.to_str());
}
MED_git.Hunks wide = MED_git.diff(big_base.slice(0, 3000), other);
check.eq_int("an oversized middle is one changed block", wide.starts.size(), 1);
check.finish("t_git");
