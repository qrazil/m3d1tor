// Unit checks for MED_git.diff.

import ui.MED_git;
import tests.MED_check;

MED_check.Check check = MED_check.Check();
MED_git.Hunks same = MED_git.diff(["a", "b"], ["a", "b"]);
check.eq_int("no hunks", same.starts.size(), 0);
MED_git.Hunks added = MED_git.diff(["a", "c"], ["a", "b", "c"]);
check.eq_int("added row", added.kinds[1], MED_git.ADDED);
check.eq_int("added start", added.starts[0], 1);
MED_git.Hunks changed = MED_git.diff(["a", "b", "c"], ["a", "x", "c"]);
check.eq_int("changed row", changed.kinds[1], MED_git.CHANGED);
check.eq_int("others untouched", changed.kinds[0], MED_git.NONE);
MED_git.Hunks removed = MED_git.diff(["a", "b", "c"], ["a", "c"]);
check.eq_int("removed marks the row above", removed.kinds[0], MED_git.REMOVED);
MED_git.Hunks mixed = MED_git.diff(["a", "b", "c", "d"], ["a", "x", "y", "c"]);
check.eq_int("changed", mixed.kinds[1], MED_git.CHANGED);
check.eq_int("added after the change", mixed.kinds[2], MED_git.ADDED);
check.eq_int("removed after", mixed.starts.size(), 2);
MED_git.Hunks grown = MED_git.diff(["a"], ["a", "b", "c"]);
check.eq_int("appended rows", grown.kinds[2], MED_git.ADDED);
MED_git.Hunks cleared = MED_git.diff(["a", "b"], []);
check.eq_int("everything removed", cleared.starts.size(), 1);
check.eq_int("next", MED_git.next_start(mixed, 0, true), 1);
check.eq_int("previous", MED_git.next_start(mixed, 5, false), mixed.starts[1]);
check.finish("t_git");
