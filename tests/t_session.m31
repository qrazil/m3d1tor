// Unit checks for MED_session: the text format, names and the files.

import engine.MED_shell;
import ui.MED_session;
import tests.MED_check;

MED_check.Check check = MED_check.Check();
List<MED_session.Entry> entries = [MED_session.Entry("/a/one.txt", row: 3, col: 4), MED_session.Entry("/a/two with space.txt")];
str text = MED_session.encode(entries, "/a/two with space.txt");
check.ok("magic", text.starts_with("m3session 1\n"));
MED_session.Session back = MED_session.decode(text);
check.eq_int("entries", back.entries.size(), 2);
check.eq_str("active", back.active, "/a/two with space.txt");
check.eq_str("path", back.entries[0].path, "/a/one.txt");
check.eq_int("row", back.entries[0].row, 3);
check.eq_int("col", back.entries[0].col, 4);
check.eq_str("spaces", back.entries[1].path, "/a/two with space.txt");
check.eq_int("not a session", MED_session.decode("hello\nworld").entries.size(), 0);
check.eq_int("empty", MED_session.decode("").entries.size(), 0);
check.ok("name ok", MED_session.is_valid_name("work-1.v2_x"));
check.ok("name empty", !MED_session.is_valid_name(""));
check.ok("name slash", !MED_session.is_valid_name("a/b"));
check.ok("name dot first", !MED_session.is_valid_name(".hidden"));
check.ok("name percent", !MED_session.is_valid_name("%cwd"));
check.eq_str("file named", MED_session.file_for("work", "/home/me"), "sessions/work");
check.eq_str("file project", MED_session.file_for("", "/home/me/proj"), "sessions/%home%me%proj");
Option<str> made = MED_shell.output(["sh", "-c", "mktemp -d \"${TMPDIR:-/tmp}/m3sess.XXXXXX\""], "");
if (made.is_some()) {
    str directory = made.or("").trim();
    MED_session.save(directory, "sessions/alpha", text);
    MED_session.save(directory, "sessions/%home%x", text);
    check.eq_int("load", MED_session.load(directory, "sessions/alpha").entries.size(), 2);
    check.eq_str("names skip project sessions", MED_session.names(directory).join(","), "alpha");
    check.ok("delete", MED_session.did_delete(directory, "sessions/alpha"));
    check.ok("delete again", !MED_session.did_delete(directory, "sessions/alpha"));
    check.eq_int("gone", MED_session.load(directory, "sessions/alpha").entries.size(), 0);
    MED_shell.output(["rm", "-rf", directory], "");
} else {
    check.ok("mktemp", false);
}
check.eq_int("no directory", MED_session.load("", "sessions/x").entries.size(), 0);
check.finish("t_session");
