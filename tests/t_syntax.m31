// Unit checks for MED_syntax: language by name and the classes of a line.

import engine.MED_syntax;
import tests.MED_check;

MED_check.Check check = MED_check.Check();
check.eq_str("c by extension", MED_syntax.language_of("a/b/x.c", ""), "c");
check.eq_str("rust", MED_syntax.language_of("main.rs", ""), "rust");
check.eq_str("m31", MED_syntax.language_of("m3.m31", ""), "m31");
check.eq_str("shebang", MED_syntax.language_of("tool", "#!/usr/bin/env python3"), "python");
check.eq_str("unknown", MED_syntax.language_of("notes.txt", ""), "");
check.eq_str("dotfile name", MED_syntax.language_of("/home/u/.bashrc", ""), "sh");
MED_syntax.Line python = MED_syntax.classify("python", "def f(x): # note", 0);
check.eq_int("keyword", python.classes[0], MED_syntax.KEYWORD);
check.eq_int("function name", python.classes[4], MED_syntax.FUNCTION);
check.eq_int("plain", python.classes[7], MED_syntax.NORMAL);
check.eq_int("comment", python.classes[11], MED_syntax.COMMENT);
MED_syntax.Line open_string = MED_syntax.classify("python", "x = \"\"\"abc", 0);
check.eq_int("a triple quote carries on", open_string.state, 3);
check.eq_int("string", open_string.classes[6], MED_syntax.STRING);
MED_syntax.Line closed = MED_syntax.classify("python", "def\"\"\" + 1", open_string.state);
check.eq_int("inside the string", closed.classes[0], MED_syntax.STRING);
check.eq_int("closed", closed.state, 0);
check.eq_int("number after it", closed.classes[9], MED_syntax.NUMBER);
MED_syntax.Line block = MED_syntax.classify("c", "int x; /* start", 0);
check.eq_int("type", block.classes[0], MED_syntax.TYPE);
check.eq_int("block comment", block.classes[8], MED_syntax.COMMENT);
check.eq_int("state", block.state, 1);
MED_syntax.Line after = MED_syntax.classify("c", "end */ return 0;", block.state);
check.eq_int("comment ends", after.classes[4], MED_syntax.COMMENT);
check.eq_int("keyword after", after.classes[7], MED_syntax.KEYWORD);
check.eq_int("state cleared", after.state, 0);
MED_syntax.Line preproc = MED_syntax.classify("c", "#include <stdio.h>", 0);
check.eq_int("preprocessor", preproc.classes[3], MED_syntax.PREPROC);
MED_syntax.Line json = MED_syntax.classify("json", "{\"a\": [1, true, \"s\"]}", 0);
check.eq_int("key", json.classes[2], MED_syntax.TYPE);
check.eq_int("number", json.classes[7], MED_syntax.NUMBER);
check.eq_int("constant", json.classes[10], MED_syntax.CONSTANT);
check.eq_int("string value", json.classes[17], MED_syntax.STRING);
MED_syntax.Line heading = MED_syntax.classify("markdown", "## Title", 0);
check.eq_int("heading", heading.classes[3], MED_syntax.TITLE);
MED_syntax.Line fence = MED_syntax.classify("markdown", "```rust", 0);
check.ok("a known fence language carries a language state", fence.state >= 100);
MED_syntax.Line inside = MED_syntax.classify("markdown", "fn main() { let x = 1; } // c", fence.state);
check.eq_int("rust keyword in a rust fence", inside.classes[0], MED_syntax.KEYWORD);
check.eq_int("rust function name", inside.classes[3], MED_syntax.FUNCTION);
check.eq_int("rust number", inside.classes[20], MED_syntax.NUMBER);
check.eq_int("rust comment", inside.classes[27], MED_syntax.COMMENT);
check.eq_int("fence stays open", inside.state, fence.state);
MED_syntax.Line fence_end = MED_syntax.classify("markdown", "```", inside.state);
check.eq_int("fence closes", fence_end.state, 0);
check.eq_int("closing fence marker", fence_end.classes[0], MED_syntax.SPECIAL);
MED_syntax.Line py_open = MED_syntax.classify("markdown", "```python", 0);
MED_syntax.Line py_line = MED_syntax.classify("markdown", "def f(): pass", py_open.state);
check.eq_int("python def in a python fence", py_line.classes[0], MED_syntax.KEYWORD);
check.ok("python fence is not the rust fence", py_open.state != fence.state);
MED_syntax.Line alias = MED_syntax.classify("markdown", "```py", 0);
check.eq_int("py alias is python", alias.state, py_open.state);
check.eq_int("rs alias is rust", MED_syntax.classify("markdown", "``` rs", 0).state, fence.state);
check.eq_int("sh alias", MED_syntax.classify("markdown", "```bash", 0).state, MED_syntax.classify("markdown", "```sh", 0).state);
check.eq_int("tilde fence with a brace info string", MED_syntax.classify("markdown", "~~~{.python}", 0).state, py_open.state);
MED_syntax.Line unknown = MED_syntax.classify("markdown", "```brainfuck", 0);
check.eq_int("unknown language is a plain fence", unknown.state, 5);
check.eq_int("plain code colour", MED_syntax.classify("markdown", "+++", 5).classes[0], MED_syntax.STRING);
check.eq_int("bare fence is plain", MED_syntax.classify("markdown", "```", 0).state, 5);
MED_syntax.Line m31_open = MED_syntax.classify("markdown", "```m31", 0);
check.eq_int("m31 fence", MED_syntax.classify("markdown", "int x = 1;", m31_open.state).classes[0], MED_syntax.KEYWORD);
// a block comment inside a fence survives across lines, and the fence still closes
MED_syntax.Line c_open = MED_syntax.classify("markdown", "```c", 0);
MED_syntax.Line c_comment = MED_syntax.classify("markdown", "/* open", c_open.state);
check.eq_int("comment line", c_comment.classes[3], MED_syntax.COMMENT);
MED_syntax.Line c_inside = MED_syntax.classify("markdown", "still comment", c_comment.state);
check.eq_int("comment continues in the fence", c_inside.classes[0], MED_syntax.COMMENT);
check.eq_int("fence closes out of a comment", MED_syntax.classify("markdown", "```", c_inside.state).state, 0);
MED_syntax.Line md_title = MED_syntax.classify("markdown", "# Hello `x`", 0);
check.eq_int("heading marker", md_title.classes[0], MED_syntax.SPECIAL);
check.eq_int("heading text", md_title.classes[3], MED_syntax.TITLE);
check.eq_int("code in a heading", md_title.classes[9], MED_syntax.STRING);
MED_syntax.Line md_inline = MED_syntax.classify("markdown", "a *em* **bo** `co` [t](u) ~~s~~", 0);
check.eq_int("plain", md_inline.classes[0], MED_syntax.NORMAL);
check.eq_int("emphasis", md_inline.classes[3], MED_syntax.TYPE);
check.eq_int("strong", md_inline.classes[8], MED_syntax.KEYWORD);
check.eq_int("inline code", md_inline.classes[14], MED_syntax.STRING);
check.eq_int("link text", md_inline.classes[19], MED_syntax.FUNCTION);
check.eq_int("link url", md_inline.classes[22], MED_syntax.COMMENT);
check.eq_int("strikethrough", md_inline.classes[27], MED_syntax.COMMENT);
MED_syntax.Line snake = MED_syntax.classify("markdown", "snake_case_name and 2 * 3 * 4", 0);
check.eq_int("underscores inside words are not emphasis", snake.classes[6], MED_syntax.NORMAL);
check.eq_int("spaced stars are not emphasis", snake.classes[22], MED_syntax.NORMAL);
MED_syntax.Line quote = MED_syntax.classify("markdown", "> quoted `c`", 0);
check.eq_int("blockquote marker", quote.classes[0], MED_syntax.SPECIAL);
check.eq_int("blockquote text", quote.classes[3], MED_syntax.COMMENT);
check.eq_int("code in a quote", quote.classes[10], MED_syntax.STRING);
check.eq_int("hr dashes", MED_syntax.classify("markdown", "---", 0).classes[1], MED_syntax.SPECIAL);
check.eq_int("hr stars", MED_syntax.classify("markdown", "* * *", 0).classes[2], MED_syntax.SPECIAL);
MED_syntax.Line row = MED_syntax.classify("markdown", "| a | `b` |", 0);
check.eq_int("table pipe", row.classes[0], MED_syntax.SPECIAL);
check.eq_int("table cell", row.classes[2], MED_syntax.NORMAL);
check.eq_int("table code cell", row.classes[6], MED_syntax.STRING);
check.eq_int("table delimiter", MED_syntax.classify("markdown", "|---|:-:|", 0).classes[3], MED_syntax.SPECIAL);
MED_syntax.Line bullet = MED_syntax.classify("markdown", "- [x] done **it**", 0);
check.eq_int("bullet", bullet.classes[0], MED_syntax.SPECIAL);
check.eq_int("task box", bullet.classes[3], MED_syntax.CONSTANT);
check.eq_int("strong in a list item", bullet.classes[12], MED_syntax.KEYWORD);
check.eq_int("ordered marker", MED_syntax.classify("markdown", "12. item", 0).classes[1], MED_syntax.SPECIAL);
check.eq_int("bare url", MED_syntax.classify("markdown", "see https://x.org/a ok", 0).classes[6], MED_syntax.FUNCTION);
check.eq_int("html comment", MED_syntax.classify("markdown", "<!-- note --> t", 0).classes[3], MED_syntax.COMMENT);
MED_syntax.Line shell = MED_syntax.classify("sh", "echo \"$HOME\" # c", 0);
check.eq_int("shell keyword", shell.classes[0], MED_syntax.KEYWORD);
check.eq_int("shell string", shell.classes[6], MED_syntax.STRING);
check.eq_int("shell comment", shell.classes[15], MED_syntax.COMMENT);
MED_syntax.Line rust = MED_syntax.classify("rust", "let c = 'a'; // x", 0);
check.eq_int("rust char", rust.classes[8], MED_syntax.STRING);
check.eq_int("rust comment", rust.classes[14], MED_syntax.COMMENT);
MED_syntax.Line lifetime = MED_syntax.classify("rust", "fn f<'a>(x: &'a str)", 0);
check.eq_int("a lifetime is not a string", lifetime.classes[5], MED_syntax.NORMAL);
check.finish("t_syntax");
