// Unit checks for MED_buffer: splice, text, advance, load and dump.

import engine.MED_buffer;
import tests.MED_check;

MED_check.Check check = MED_check.Check();
MED_buffer.Buffer buffer = MED_buffer.load("one\ntwo\nthree\n");
check.eq_int("lines", buffer.line_count(), 3);
check.eq_str("dump", buffer.dump(), "one\ntwo\nthree\n");
check.eq_str("text across", buffer.text(MED_buffer.Pos(0, 1), MED_buffer.Pos(2, 2)), "ne\ntwo\nth");
MED_buffer.Edit edit = buffer.splice(MED_buffer.Pos(0, 1), MED_buffer.Pos(2, 2), "X");
check.eq_int("join lines", buffer.line_count(), 1);
check.eq_str("joined", buffer.line(0), "oXree");
check.eq_str("edit removed", edit.removed, "ne\ntwo\nth");
MED_buffer.Pos end = MED_buffer.advance(MED_buffer.Pos(0, 1), "a\nbc");
check.eq_int("advance row", end.row, 1);
check.eq_int("advance col", end.col, 2);
buffer.splice(MED_buffer.Pos(0, 1), MED_buffer.Pos(0, 1), "a\nbc\nd");
check.eq_int("split lines", buffer.line_count(), 3);
check.eq_str("split mid", buffer.line(1), "bc");
check.eq_str("split tail", buffer.line(2), "dXree");
MED_buffer.Buffer empty = MED_buffer.load("");
check.eq_int("empty one line", empty.line_count(), 1);
check.eq_str("empty dump", empty.dump(), "");
MED_buffer.Buffer noeol = MED_buffer.load("a\nb");
check.eq_str("no eol dump", noeol.dump(), "a\nb");
check.eq_int("pos cmp", MED_buffer.Pos(1, 2).cmp(MED_buffer.Pos(1, 3)), -1);
check.finish("t_buffer");
