// Unit checks for MED_app: terminal keys to engine keys, drawing into a
// buffer, and the :w / :q handling (including the E37 refusal).

import fs;
import io;
import term;
import tests.MED_check;
import tui.TUI_app;
import tui.TUI_buffer;
import tui.TUI_geometry;
import tui.TUI_mouse;
import MED_app;
import MED_editor;
import MED_key;

term.Event press(int code_point) {
    return term.Event.Key(term.Key(term.Code.Char(code_point), 0));
}

term.Event named(term.Code code) {
    return term.Event.Key(term.Key(code, 0));
}

void remove_file(str path) {
    match (fs.remove(path)) {
        case Ok(bool did_remove): {
        }
        case Err(io.Error error): {
        }
    }
}

void remove_directory(str path) {
    match (fs.rmdir(path)) {
        case Ok(bool did_remove): {
        }
        case Err(io.Error error): {
        }
    }
}

void write_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
            print("cannot write " + path);
        }
    }
}

bool is_quit(TUI_app.Action action) {
    match (action) {
        case Continue: {
            return false;
        }
        case Redraw: {
            return false;
        }
        case Quit: {
            return true;
        }
    }
}

TUI_app.Action type_text(MED_app.App app, str text) {
    TUI_app.Action last = TUI_app.Action.Continue;
    for (int code_point in text.chars()) {
        if (code_point == 10) {
            last = app.handle(named(term.Code.Enter));
        } else {
            last = app.handle(press(code_point));
        }
    }
    return last;
}

MED_check.Check check = MED_check.Check();
// key translation
check.eq_int("plain", MED_app.keys_of_key(term.Key(term.Code.Char(120), 0))[0], 120);
check.eq_int("ctrl-v", MED_app.keys_of_key(term.Key(term.Code.Char(118), term.CTRL))[0], 22);
check.eq_int("enter", MED_app.keys_of_key(term.Key(term.Code.Enter, 0))[0], 13);
check.eq_int("backspace", MED_app.keys_of_key(term.Key(term.Code.Backspace, 0))[0], 127);
check.eq_int("escape", MED_app.keys_of_key(term.Key(term.Code.Escape, 0))[0], 27);
check.eq_int("up", MED_app.keys_of_key(term.Key(term.Code.Up, 0))[0], MED_key.UP_KEY);
check.eq_int("alt is two keys", MED_app.keys_of_key(term.Key(term.Code.Char(106), term.ALT)).size(), 2);
check.eq_int("shift-up", MED_app.keys_of_key(term.Key(term.Code.Up, term.SHIFT))[0], MED_key.UP_KEY | MED_key.MOD_SHIFT);
check.eq_int("back-tab is none", MED_app.keys_of_key(term.Key(term.Code.BackTab, 0)).size(), 0);
check.eq_int("text rows", MED_app.text_rows(24), 22);
check.eq_int("text rows tiny", MED_app.text_rows(1), 1);
// a new file: type, write, quit
str path = "/tmp/m3d1tor_t_app_file.txt";
remove_file(path);
match (MED_app.open(path)) {
    case Err(str message): {
        check.ok("open new file: " + message, false);
    }
    case Ok(MED_app.App app): {
        check.ok("new file is unmodified", !app.is_modified());
        type_text(app, "ihello\nworld");
        app.handle(named(term.Code.Escape));
        check.ok("typing modifies", app.is_modified());
        TUI_buffer.Buffer screen = TUI_buffer.Buffer.sized(40, 8);
        app.render(screen, screen.area());
        check.eq_str("row 1", screen.row_text(0).trim(), "1 hello");
        check.eq_str("row 2", screen.row_text(1).trim(), "2 worl" + "d");
        check.eq_str("filler", screen.row_text(2).trim(), "~");
        check.ok("status shows the mode", screen.row_text(6).contains(" NORMAL "));
        check.ok("status shows the flag", screen.row_text(6).contains("[+]"));
        check.ok(":q is refused", !is_quit(type_text(app, ":q\n")));
        check.ok("E37 shown", app.notice.starts_with("E37"));
        check.ok(":w does not quit", !is_quit(type_text(app, ":w\n")));
        check.ok("written is unmodified", !app.is_modified());
        match (io.read(path)) {
            case Ok(str content): {
                check.eq_str("file content", content, "hello\nworld\n");
            }
            case Err(io.Error error): {
                check.ok("read back", false);
            }
        }
        type_text(app, "x");
        check.ok("x modifies again", app.is_modified());
        type_text(app, "u");
        check.ok("undo back to the written text", !app.is_modified());
        check.ok(":q quits when unmodified", is_quit(type_text(app, ":q\n")));
        type_text(app, "x");
        check.ok(":q! quits", is_quit(type_text(app, ":q!\n")));
    }
}
remove_file(path);
// an existing file, ZZ writes and quits
write_file(path, "one\ntwo\n");
match (MED_app.open(path)) {
    case Err(str message): {
        check.ok("open existing: " + message, false);
    }
    case Ok(MED_app.App app): {
        check.eq_int("lines", app.editor.buffer.line_count(), 2);
        type_text(app, "ddj");
        check.ok("ZZ quits", is_quit(type_text(app, "ZZ")));
        match (io.read(path)) {
            case Ok(str content): {
                check.eq_str("ZZ wrote", content, "two\n");
            }
            case Err(io.Error error): {
                check.ok("read back", false);
            }
        }
    }
}
remove_file(path);
// the mouse
match (MED_app.open("")) {
    case Err(str message): {
        check.ok("open empty: " + message, false);
    }
    case Ok(MED_app.App app): {
        type_text(app, "iabc\ndef\nghi\n");
        for (int count in 0 .. 40) {
            type_text(app, "oline\n");
        }
        app.handle(named(term.Code.Escape));
        type_text(app, "gg");
        TUI_mouse.Gesture pressed = TUI_mouse.Gesture(TUI_mouse.Kind.Press, 5, 1);
        app.handle_mouse(TUI_mouse.Routed(pressed, "", TUI_geometry.Rect(0, 0, 0, 0)));
        check.eq_int("press row", app.editor.row, 1);
        check.eq_int("press col", app.editor.col, 1);
        TUI_mouse.Gesture drag = TUI_mouse.Gesture(TUI_mouse.Kind.Drag, 6, 2);
        app.handle_mouse(TUI_mouse.Routed(drag, "", TUI_geometry.Rect(0, 0, 0, 0)));
        check.eq_int("drag starts a selection", app.editor.mode, MED_editor.VISUAL);
        check.eq_int("drag row", app.editor.row, 2);
        check.eq_int("anchor row", app.editor.vrow, 1);
        TUI_mouse.Gesture wheel = TUI_mouse.Gesture(TUI_mouse.Kind.ScrollDown, 5, 5);
        app.handle_mouse(TUI_mouse.Routed(wheel, "", TUI_geometry.Rect(0, 0, 0, 0)));
        check.ok("the wheel scrolls", app.editor.view_top > 0);
    }
}
// several buffers
str first_path = "/tmp/m3d1tor_t_app_a.txt";
str second_path = "/tmp/m3d1tor_t_app_b.txt";
write_file(first_path, "alpha\n");
write_file(second_path, "beta\ngamma\n");
match (MED_app.open_all([first_path, second_path])) {
    case Err(str message): {
        check.ok("open two files: " + message, false);
    }
    case Ok(MED_app.App app): {
        check.eq_int("two buffers", app.slots.size(), 2);
        check.eq_str("first shown", app.path, first_path);
        type_text(app, "x");
        check.ok(":bn moves on with a modified buffer (hidden)", !is_quit(type_text(app, ":bn\n")));
        check.eq_str("second shown", app.path, second_path);
        check.eq_int("second text", app.editor.buffer.line_count(), 2);
        check.eq_int("alternate", app.alternate_id, 1);
        check.ok("second is unmodified", !app.is_modified());
        type_text(app, "yy");
        type_text(app, ":b1\n");
        check.eq_str("back on the first", app.path, first_path);
        check.ok("first keeps its change", app.is_modified());
        type_text(app, "p");
        check.eq_str("registers are shared", app.editor.buffer.line(1), "beta");
        type_text(app, "u");
        type_text(app, "\x1e");
        check.eq_str("ctrl-^ goes to the alternate", app.path, second_path);
        type_text(app, ":ls\n");
        check.eq_int("ls lists both", app.overlay.size(), 2);
        check.ok("ls marks the active one", app.overlay[1].contains("%a"));
        check.ok("ls marks the modified one", app.overlay[0].contains("+"));
        TUI_buffer.Buffer screen = TUI_buffer.Buffer.sized(50, 10);
        app.render(screen, screen.area());
        check.ok("the listing is drawn", screen.row_text(7).contains("Press ENTER"));
        type_text(app, "\n");
        check.eq_int("any key clears the listing", app.overlay.size(), 0);
        check.ok(":q is refused for the other buffer", !is_quit(type_text(app, ":q\n")));
        check.ok("E162 shown", app.notice.starts_with("E162"));
        type_text(app, ":bd\n");
        check.eq_int("bd drops the buffer", app.slots.size(), 1);
        check.eq_str("the other one is shown", app.path, first_path);
        type_text(app, ":bd\n");
        check.ok("bd of a modified buffer is refused", app.notice.starts_with("E89"));
        type_text(app, ":e " + second_path + "\n");
        check.eq_int("e opens a new buffer", app.slots.size(), 2);
        check.eq_str("e shows it", app.path, second_path);
        type_text(app, ":e " + first_path + "\n");
        check.eq_int("e of an open file reuses the buffer", app.slots.size(), 2);
        check.ok("wall writes the changed ones", !is_quit(type_text(app, ":wa\n")));
        match (io.read(first_path)) {
            case Ok(str content): {
                check.eq_str("wall wrote the first", content, "lpha\n");
            }
            case Err(io.Error error): {
                check.ok("read back", false);
            }
        }
        type_text(app, "x");
        type_text(app, ":e!\n");
        check.ok(":e! discards", !app.is_modified());
        check.eq_str("and reloads", app.editor.buffer.line(0), "lpha");
        type_text(app, ":enew\n");
        check.eq_str("enew has no name", app.path, "");
        check.eq_int("three buffers", app.slots.size(), 3);
        check.ok("nothing is modified, :q quits", is_quit(type_text(app, ":q\n")));
    }
}
remove_file(first_path);
remove_file(second_path);
// windows
str win_a = "/tmp/m3d1tor_t_app_wa.txt";
str win_b = "/tmp/m3d1tor_t_app_wb.txt";
write_file(win_a, "one\ntwo\nthree\nfour\n");
write_file(win_b, "bravo\n");
match (MED_app.open_all([win_a, win_b])) {
    case Err(str message): {
        check.ok("open for the window tests: " + message, false);
    }
    case Ok(MED_app.App app): {
        check.eq_int("one window to begin with", app.wins.size(), 1);
        type_text(app, ":q\n");
        type_text(app, "jj");
        type_text(app, ":vsplit\n");
        check.eq_int("vsplit makes two windows", app.wins.size(), 2);
        check.eq_int("the new window is active", app.current_win, 2);
        check.eq_int("with the cursor of the first", app.editor.row, 2);
        type_text(app, "gg");
        type_text(app, "\x17h");
        check.eq_int("ctrl-w h goes left", app.current_win, 1);
        check.eq_int("the left window kept its row", app.editor.row, 2);
        type_text(app, "\x17l");
        check.eq_int("ctrl-w l goes right", app.current_win, 2);
        check.eq_int("the right window kept its row", app.editor.row, 0);
        type_text(app, ":split\n");
        check.eq_int("split makes three", app.wins.size(), 3);
        type_text(app, ":b2\n");
        check.eq_str("a window can show another buffer", app.path, win_b);
        type_text(app, "\x17k");
        check.eq_str("ctrl-w k goes up to the first buffer", app.path, win_a);
        type_text(app, "\x17j");
        check.eq_str("ctrl-w j goes back down", app.path, win_b);
        type_text(app, "\x17w");
        check.eq_int("ctrl-w w wraps around", app.current_win, 1);
        type_text(app, "\x17p");
        check.eq_int("ctrl-w p goes to the previous window", app.current_win, 3);
        TUI_buffer.Buffer screen = TUI_buffer.Buffer.sized(80, 24);
        app.render(screen, screen.area());
        check.ok("the left window draws its text", screen.row_text(0).contains("one"));
        check.ok("the right windows are parted by a separator", screen.row_text(0).contains("|"));
        check.ok("the other buffer is drawn too", screen.to_str().contains("bravo"));
        type_text(app, "ihello");
        type_text(app, "\x1b");
        app.render(screen, screen.area());
        check.ok("an edit shows in the other window of the same buffer", screen.to_str().contains("hellobravo"));
        type_text(app, ":q\n");
        check.eq_int("q closes a window even when its buffer changed", app.wins.size(), 2);
        type_text(app, ":close\n");
        check.eq_int("close drops another", app.wins.size(), 1);
        type_text(app, ":close\n");
        check.ok("the last window stays", app.notice.starts_with("E444"));
        type_text(app, ":sp\n");
        type_text(app, ":only\n");
        check.eq_int("only leaves one", app.wins.size(), 1);
        type_text(app, ":new\n");
        check.eq_int("new makes a window", app.wins.size(), 2);
        check.eq_str("showing an empty buffer", app.path, "");
        check.ok(":q on the last window is refused for the modified buffer", !is_quit(type_text(app, ":q\n:q\n")));
        check.ok("E162 for the hidden modified buffer", app.notice.starts_with("E162"));
        check.ok(":qa! quits", is_quit(type_text(app, ":qa!\n")));
    }
}
match (MED_app.open_all([win_a])) {
    case Err(str message): {
        check.ok("open for the window delete test: " + message, false);
    }
    case Ok(MED_app.App app): {
        type_text(app, ":vsplit\n:enew\n");
        check.eq_int("two windows", app.wins.size(), 2);
        type_text(app, "\x17h");
        type_text(app, ":bd 2\n");
        check.eq_int("deleting a buffer closes its windows", app.wins.size(), 1);
        check.eq_str("the remaining window keeps its buffer", app.path, win_a);
    }
}
remove_file(win_a);
remove_file(win_b);
// leader keys, which-key, jk, the palette, pickers
str lead_path = "/tmp/m3d1tor_t_app_lead.txt";
write_file(lead_path, "one\ntwo\n");
match (MED_app.open_all([lead_path])) {
    case Err(str message): {
        check.ok("open for the leader tests: " + message, false);
    }
    case Ok(MED_app.App app): {
        type_text(app, " ");
        check.ok("space starts a leader", app.is_leader);
        check.ok("which-key waits", !app.is_which_key);
        app.tick(100);
        check.ok("still waiting at 100ms", !app.is_which_key);
        app.tick(400);
        check.ok("which-key after the delay", app.is_which_key);
        TUI_buffer.Buffer screen = TUI_buffer.Buffer.sized(80, 24);
        app.render(screen, screen.area());
        check.ok("which-key popup lists the groups", screen.to_str().contains("file"));
        type_text(app, "\x1b");
        check.ok("escape cancels the leader", !app.is_leader);
        type_text(app, " ff");
        check.ok("space f f opens the files picker", app.has_picker);
        type_text(app, "\x1b");
        check.ok("escape closes the picker", !app.has_picker);
        type_text(app, " bb");
        check.ok("space b b opens the buffers picker", app.has_picker);
        type_text(app, "\n");
        check.ok("enter accepts and closes", !app.has_picker);
        type_text(app, " bb\x16");
        check.ok("ctrl-v in the buffers picker closes it", !app.has_picker);
        check.eq_int("and opens a window beside", app.wins.size(), 2);
        type_text(app, " bb\x13");
        check.eq_int("ctrl-s opens another below", app.wins.size(), 3);
        type_text(app, "\x17c\x17c");
        check.eq_int("closed again", app.wins.size(), 1);
        type_text(app, " z");
        check.ok("an unmapped leader is reported", app.notice.starts_with("No mapping"));
        check.ok("and the leader ends", !app.is_leader);
        type_text(app, "ixjk");
        check.eq_int("jk leaves insert mode", app.editor.mode, MED_editor.NORMAL);
        check.eq_str("jk leaves the x only", app.editor.buffer.line(0), "xone");
        type_text(app, ":\n");
        check.ok("enter on an empty colon opens the palette", app.has_picker);
        type_text(app, "\x1b");
        type_text(app, " :");
        check.ok("space colon opens the palette", app.has_picker);
        type_text(app, "\x1b");
        type_text(app, "u");
        type_text(app, ":Grep two\n");
        check.ok(":Grep opens the grep picker", app.has_picker);
        app.tick(300);
        screen = TUI_buffer.Buffer.sized(80, 24);
        app.render(screen, screen.area());
        check.ok("grep finds the line after the debounce", screen.to_str().contains("two"));
        type_text(app, "\x1b");
        check.ok("the picker is closed again", !app.has_picker);
    }
}
remove_file(lead_path);
// the directory listing (:Explore)
str tree = "/tmp/m3d1tor_t_app_tree";
remove_file(tree + "/alpha/inner.txt");
remove_directory(tree + "/alpha");
remove_file(tree + "/beta.txt");
remove_file(tree + "/zeta.txt");
remove_directory(tree);
match (fs.makedirs(tree + "/alpha")) {
    case Ok(bool did_make): {
    }
    case Err(io.Error error): {
        print("cannot make " + tree);
    }
}
write_file(tree + "/alpha/inner.txt", "inner\n");
write_file(tree + "/beta.txt", "beta\n");
write_file(tree + "/zeta.txt", "zeta\n");
match (MED_app.open_all([tree + "/beta.txt"])) {
    case Err(str message): {
        check.ok("open for the listing tests: " + message, false);
    }
    case Ok(MED_app.App app): {
        type_text(app, ":Explore\n");
        check.eq_str("explore shows the directory", app.path, tree);
        check.eq_str("the first line goes up", app.editor.buffer.line(0), "../");
        check.eq_str("folders come first", app.editor.buffer.line(1), "alpha/");
        check.eq_str("then the files", app.editor.buffer.line(2), "beta.txt");
        check.eq_int("the cursor rests on the file we came from", app.editor.row, 2);
        type_text(app, "ix");
        check.ok("typing is refused with E21", app.notice.starts_with("E21"));
        check.eq_str("the text is intact", app.editor.buffer.line(2), "beta.txt");
        check.eq_int("and stays in Normal mode", app.editor.mode, MED_editor.NORMAL);
        type_text(app, "dd");
        check.eq_int("deleting is refused too", app.editor.buffer.line_count(), 4);
        type_text(app, ":w\n");
        check.ok("a listing cannot be written", app.notice.starts_with("E382"));
        type_text(app, "gg");
        type_text(app, "j\n");
        check.eq_str("enter descends", app.path, tree + "/alpha");
        check.eq_str("the folder's files", app.editor.buffer.line(1), "inner.txt");
        type_text(app, "-");
        check.eq_str("minus goes up", app.path, tree);
        check.eq_str("the cursor rests on the folder we left", app.editor.buffer.line(app.editor.row), "alpha/");
        type_text(app, "jj\n");
        check.eq_str("enter edits a file", app.path, tree + "/zeta.txt");
        check.eq_str("with its text", app.editor.buffer.line(0), "zeta");
        check.eq_int("the listing is gone with it", app.slots.size(), 2);
        type_text(app, ":e " + tree + "\n");
        check.eq_str(":e on a directory lists it", app.path, tree);
        type_text(app, ":Vexplore\n");
        check.eq_int("Vexplore splits", app.wins.size(), 2);
        type_text(app, "\x17c");
        type_text(app, ":q\n");
    }
}
remove_file(tree + "/alpha/inner.txt");
remove_directory(tree + "/alpha");
remove_file(tree + "/beta.txt");
remove_file(tree + "/zeta.txt");
remove_directory(tree);
check.finish("t_app");
