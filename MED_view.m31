// The window onto the buffer: which lines are shown, and the commands that
// move it (CTRL-E CTRL-Y CTRL-D CTRL-U CTRL-F CTRL-B and the z family).
//
// This follows Vim's update_topline, scroll_cursor_halfway and pagescroll for
// a window whose lines never wrap (each buffer line is one row) and with
// 'scrolloff' 0. The editor keeps `view_top` and `view_height`; the UI sets
// the height and calls `update` after each key so the cursor stays visible.

import MED_editor;
import MED_motion;
import MED_num;
import MED_text;
import MED_buffer;

// The rows the window shows: [view_top, bottom).
pub int bottom(MED_editor.Editor editor) {
    return MED_num.smaller(editor.view_top + editor.view_height, editor.buffer.line_count());
}

// Put the cursor on `row`, its column from the wanted column.
void to_row(MED_editor.Editor editor, int row) {
    editor.row = row;
    editor.col = MED_motion.col_for_want(editor.buffer.line(row), editor.want, editor.tab, editor.mode == MED_editor.VISUAL);
}

/// Vim's scroll_cursor_halfway: put the cursor line in the middle. `is_at_end`
/// (zz) counts the empty rows past the end of the buffer as used;
/// `is_prefer_above` (scrolling down to the cursor) puts the extra row above it.
pub void center(MED_editor.Editor editor, bool is_at_end, bool is_prefer_above) {
    int last = editor.buffer.line_count() - 1;
    int row = editor.row;
    int used = 1;
    int above = 0;
    int below = 0;
    int real_below = 0;
    int top = row;
    while (top > 0) {
        bool is_add_below = below <= above;
        if (is_prefer_above) {
            is_add_below = below < above;
        }
        if (is_add_below) {
            if (row + real_below + 1 <= last) {
                used = used + 1;
                if (used > editor.view_height) {
                    break;
                }
                real_below = real_below + 1;
                below = below + 1;
            } else {
                below = below + 1;
                if (is_at_end) {
                    used = used + 1;
                }
            }
        }
        bool is_add_above = below > above;
        if (is_prefer_above) {
            is_add_above = below >= above;
        }
        if (is_add_above) {
            used = used + 1;
            if (used > editor.view_height) {
                break;
            }
            above = above + 1;
            top = row - above;
        }
    }
    editor.view_top = top;
}

// Vim's scroll_cursor_bot for a cursor below the window: scroll just far
// enough to put the cursor on the last row, or centre it when that would take
// a screenful.
void scroll_to_bottom(MED_editor.Editor editor) {
    int last = editor.buffer.line_count() - 1;
    int height = editor.view_height;
    int steps = editor.row - editor.view_top - height;
    int used = 1;
    int below = editor.row;
    bool is_overflow = false;
    for (int i in 0 .. steps) {
        used = used + 1;
        if (used > height) {
            is_overflow = true;
            break;
        }
        if (below < last) {
            below = below + 1;
            used = used + 1;
            if (used > height) {
                is_overflow = true;
                break;
            }
        }
    }
    int scrolled = steps + 1;
    int lines = scrolled;
    if (is_overflow) {
        lines = used;
    }
    if (lines >= height && lines > 1) {
        center(editor, false, true);
    } else {
        editor.view_top = editor.view_top + scrolled;
    }
}

/// Vim's update_topline: scroll just enough to show the cursor line, or
/// centre it when it is far away.
pub void update(MED_editor.Editor editor) {
    int count = editor.buffer.line_count();
    int height = editor.view_height;
    if (editor.view_top > count - 1) {
        editor.view_top = count - 1;
    }
    if (editor.view_top < 0) {
        editor.view_top = 0;
    }
    if (editor.row < editor.view_top) {
        int half = height / 2 - 1;
        if (half < 2) {
            half = 2;
        }
        if (editor.view_top - editor.row >= half) {
            center(editor, false, false);
        } else {
            editor.view_top = editor.row;
        }
    } else if (editor.row >= editor.view_top + height) {
        int beyond = editor.row - (editor.view_top + height) + 1;
        if (beyond <= height + 1) {
            scroll_to_bottom(editor);
        } else {
            center(editor, false, true);
        }
    }
}

/// Scroll the window `count` lines (up: the text moves up, CTRL-E). Returns
/// whether it moved. The cursor is not touched.
pub bool did_scroll_window(MED_editor.Editor editor, bool is_upward, int count) {
    int before = editor.view_top;
    if (is_upward) {
        editor.view_top = MED_num.smaller(editor.view_top + count, editor.buffer.line_count() - 1);
    } else {
        editor.view_top = MED_num.larger(editor.view_top - count, 0);
    }
    return editor.view_top != before;
}

// Keep the cursor in the window after it scrolled (Vim's scrollup/scrolldown).
void pull_cursor(MED_editor.Editor editor) {
    int row = editor.row;
    if (row < editor.view_top) {
        row = editor.view_top;
    }
    int last = bottom(editor) - 1;
    if (row > last) {
        row = last;
    }
    if (row != editor.row) {
        to_row(editor, row);
    }
}

/// CTRL-E (up) and CTRL-Y.
pub void scroll_line(MED_editor.Editor editor, bool is_upward, int count) {
    did_scroll_window(editor, is_upward, count);
    pull_cursor(editor);
}

// Rows CTRL-F / CTRL-B scroll for one count (Vim's get_scroll_overlap).
int overlap(MED_editor.Editor editor, bool is_forward) {
    int height = editor.view_height;
    if (!is_forward && editor.view_top == 0) {
        return height;
    }
    if (is_forward && editor.view_top + height >= editor.buffer.line_count()) {
        return height;
    }
    int min_height = height - 2;
    if (min_height < 3) {
        return height;
    }
    if (!is_forward) {
        // CTRL-B wants the lines just under the window top to carry over
        int last = editor.buffer.line_count() - 1;
        if (editor.view_top + 1 > last) {
            return height;
        }
        if (editor.view_top + 2 > last) {
            return min_height + 1;
        }
    }
    return min_height;
}

/// CTRL-D, CTRL-U (`is_half`) and CTRL-F, CTRL-B (Vim's pagescroll). Returns
/// false when nothing moved.
pub bool did_page(MED_editor.Editor editor, bool is_forward, int count0, bool is_half) {
    int height = editor.view_height;
    int last = editor.buffer.line_count() - 1;
    int previous_row = editor.row;
    int previous_col = editor.col;
    bool is_moved = false;
    if (is_half) {
        if (count0 > 0) {
            editor.scroll_opt = MED_num.smaller(height, count0);
        }
        int amount = height / 2;
        if (amount == 0) {
            amount = 1;
        }
        if (editor.scroll_opt > 0) {
            amount = editor.scroll_opt;
        }
        int count = MED_num.smaller(height, amount);
        int cursor_count = count;
        if (is_forward && editor.view_top + 1 + height + count > last + 1) {
            int rows = 1 + MED_num.smaller(last - editor.view_top, height + count);
            if (rows < height + count) {
                count = rows - height;
            }
        }
        if (count > 0) {
            is_moved = did_scroll_window(editor, is_forward, count);
        }
        int row = 0;
        if (is_forward) {
            row = MED_num.smaller(previous_row + cursor_count, last);
        } else {
            row = MED_num.larger(previous_row - cursor_count, 0);
        }
        to_row(editor, row);
    } else {
        int count = MED_num.larger(count0, 1) * overlap(editor, is_forward);
        is_moved = did_scroll_window(editor, is_forward, count);
        if (is_moved) {
            if (is_forward) {
                to_row(editor, editor.view_top);
            } else {
                to_row(editor, bottom(editor) - 1);
            }
        }
    }
    return is_moved || editor.row != previous_row || editor.col != previous_col;
}

// ----------------------------------------------------------------- z family

/// zt z<CR> zz z. zb z-. `target` is the line to go to first (0: stay).
/// Returns false for a key that is not one of these.
pub bool did_z_command(MED_editor.Editor editor, int key, int target) {
    bool is_known = key == 116 || key == 13 || key == 122 || key == 46 || key == 98 || key == 45;
    if (key == 104 || key == 108 || key == 115 || key == 101 || key == 72 || key == 76) {
        // horizontal scrolling does nothing while lines wrap
        return true;
    }
    if (!is_known) {
        return false;
    }
    if (target > 0 && target - 1 != editor.row) {
        editor.set_pcmark(MED_buffer.Pos(editor.row, editor.col));
        to_row(editor, MED_num.smaller(target - 1, editor.buffer.line_count() - 1));
    }
    if (key == 13 || key == 46 || key == 45) {
        str line = editor.buffer.line(editor.row);
        editor.col = MED_text.first_nonblank(line);
        if (editor.col >= line.size() && line.size() > 0) {
            editor.col = MED_text.last_col(line);
        }
        editor.want_from_cursor();
    }
    if (key == 116 || key == 13) {
        editor.view_top = editor.row;
    } else if (key == 122 || key == 46) {
        center(editor, true, false);
    } else {
        editor.view_top = MED_num.larger(editor.row - editor.view_height + 1, 0);
    }
    return true;
}
